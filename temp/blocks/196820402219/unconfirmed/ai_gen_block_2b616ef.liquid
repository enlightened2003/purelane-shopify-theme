{% doc %}
  @prompt
    Create a premium Purelane Homecare benefits section for a cleaning products brand. Use a clean light background, dark navy typography, and subtle gold accents. Heading: “CLEANING THAT FEELS BETTER.” Add a short paragraph explaining that Purelane products are powerful, plant-powered, gentle, and designed for everyday homes. Below the text, create 4 elegant benefit cards: “Plant Powered”, “Tough on Dirt”, “Family Friendly”, and “Made for Everyday Homes”. Keep the design minimal, premium, spacious, and consistent with the existing Purelane product page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-benefits-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-benefits-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
  }

  .ai-benefits-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    max-width: {{ block.settings.description_max_width }}px;
    margin: 0 auto;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-benefits-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    text-align: {{ block.settings.card_text_alignment }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-benefits-card-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-benefits-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_margin_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-benefits-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_inner_size }}px;
    height: {{ block.settings.icon_inner_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefits-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: {{ block.settings.card_title_weight }};
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_margin_bottom }}px;
    line-height: 1.3;
  }

  .ai-benefits-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-benefits-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-benefits-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.65);
    }

    .ai-benefits-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px {{ block.settings.section_padding_horizontal | times: 0.5 }}px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }
  }
{% endstyle %}

<purelane-benefits-{{ ai_gen_id }} class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefits-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-benefits-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-benefits-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg class="ai-benefits-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              <path d="M2 12h20"></path>
            </svg>
          </div>
          {% if block.settings.card_1_title != blank %}
            <h3 class="ai-benefits-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
          {% endif %}
          {% if block.settings.card_1_text != blank %}
            <p class="ai-benefits-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg class="ai-benefits-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          {% if block.settings.card_2_title != blank %}
            <h3 class="ai-benefits-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
          {% endif %}
          {% if block.settings.card_2_text != blank %}
            <p class="ai-benefits-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg class="ai-benefits-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          {% if block.settings.card_3_title != blank %}
            <h3 class="ai-benefits-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
          {% endif %}
          {% if block.settings.card_3_text != blank %}
            <p class="ai-benefits-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_4_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg class="ai-benefits-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          {% if block.settings.card_4_title != blank %}
            <h3 class="ai-benefits-card-title-{{ ai_gen_id }}">{{ block.settings.card_4_title }}</h3>
          {% endif %}
          {% if block.settings.card_4_text != blank %}
            <p class="ai-benefits-card-text-{{ ai_gen_id }}">{{ block.settings.card_4_text }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</purelane-benefits-{{ ai_gen_id }}>

<script>
  (function() {
    class PurelaneBenefits{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-benefits-card-{{ ai_gen_id }}');
        cards.forEach((card) => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('purelane-benefits-{{ ai_gen_id }}', PurelaneBenefits{{ ai_gen_id }});
  })();
</script>

