<style>

.purelane-announcement {
  position: relative;

  width: 100%;
  height: 40px;

  overflow: hidden;

  display: flex;
  align-items: center;

  background: #ffffff;

  border-bottom: 1px solid rgba(70, 60, 100, 0.10);

  z-index: 200;

  font-family: Arial, sans-serif;
}


.purelane-announcement-track {
  display: flex;
  align-items: center;

  width: max-content;

  min-width: 100%;

  animation: purelaneTicker 32s linear infinite;
}


.purelane-announcement-item {
  flex-shrink: 0;

  padding: 0 48px;

  font-size: 13px;

  font-weight: 700;

  letter-spacing: .08em;

  color: #666078;

  white-space: nowrap;
}


.purelane-announcement-item span {
  color: #5b8f2a;

  font-weight: 800;
}


@keyframes purelaneTicker {

  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }

}


@media (max-width: 700px) {

  .purelane-announcement {
    height: 34px;
  }

  .purelane-announcement-item {
    padding: 0 25px;

    font-size: 10px;

    letter-spacing: .05em;
  }

}

</style>


