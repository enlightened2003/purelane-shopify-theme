<style>

/* =========================================================
   SECTION
========================================================= */

.purelane-bundle-benefits {

  width: 100%;

  box-sizing: border-box;

  padding: 75px 0 70px;

  position: relative;

  overflow: hidden;

  background:

    radial-gradient(
      ellipse at 20% 25%,
      rgba(255,255,255,.32),
      transparent 36%
    ),

    radial-gradient(
      ellipse at 85% 75%,
      rgba(255,255,255,.20),
      transparent 35%
    ),

    linear-gradient(
      180deg,
      #dff5e3 0%,
      #c9ebd6 48%,
      #abd8c4 100%
    );

}


/* =========================================================
   BACKGROUND WAVES
========================================================= */

.purelane-bundle-benefits::before {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .45;

  background:

    repeating-linear-gradient(
      -7deg,
      transparent 0,
      transparent 72px,
      rgba(255,255,255,.18) 75px,
      transparent 82px
    );

}


/* =========================================================
   INNER
========================================================= */

.purelane-bundle-benefits-inner {

  position: relative;

  z-index: 2;

  width: min(
    1200px,
    calc(100% - 70px)
  );

  margin: 0 auto;

}


/* =========================================================
   HEADER
========================================================= */

.purelane-bundle-benefits-header {

  text-align: center;

  max-width: 720px;

  margin: 0 auto 42px;

}


.purelane-bundle-benefits-eyebrow {

  margin-bottom: 15px;

  color: #77798a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .25em;

}


.purelane-bundle-benefits-header h2 {

  margin: 0;

  color: #1d1535;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 54px;

  line-height: .95;

  font-weight: 900;

  letter-spacing: -.045em;

}


.purelane-bundle-benefits-header p {

  max-width: 530px;

  margin: 18px auto 0;

  color: #606275;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 16px;

  line-height: 1.5;

}


/* =========================================================
   GRID
========================================================= */

.purelane-bundle-benefits-grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 15px;

}


/* =========================================================
   CARD
========================================================= */

.purelane-bundle-benefit-card {

  min-height: 315px;

  box-sizing: border-box;

  padding: 25px 22px 24px;

  border-radius: 24px;

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.88),
      rgba(216,237,231,.78)
    );

  border: 1px solid
    rgba(187,201,202,.65);

  box-shadow:
    0 14px 32px
    rgba(50,80,70,.08);

  backdrop-filter:
    blur(16px);

  -webkit-backdrop-filter:
    blur(16px);

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}


.purelane-bundle-benefit-card:hover {

  transform:
    translateY(-4px);

  box-shadow:
    0 20px 40px
    rgba(50,80,70,.12);

}


/* =========================================================
   ICON
========================================================= */

.purelane-bundle-benefit-icon {

  width: 55px;

  height: 55px;

  display: grid;

  place-items: center;

  border-radius: 17px;

  background:
    rgba(248,247,242,.88);

  border:
    1px solid
    rgba(190,198,202,.65);

}


.purelane-bundle-benefit-icon svg {

  width: 27px;

  height: 27px;

  stroke: #76a844;

  stroke-width: 1.6;

  stroke-linecap: round;

  stroke-linejoin: round;

}


/* =========================================================
   NUMBER
========================================================= */

.purelane-bundle-benefit-number {

  margin-top: 18px;

  color: #bd7920;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .15em;

}


/* =========================================================
   TITLE
========================================================= */

.purelane-bundle-benefit-card h3 {

  margin: 7px 0 12px;

  color: #271e40;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 21px;

  line-height: 1.05;

  font-weight: 900;

  letter-spacing: -.025em;

}


/* =========================================================
   TEXT
========================================================= */

.purelane-bundle-benefit-card p {

  margin: 0;

  color: #67687a;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 13px;

  line-height: 1.55;

}


/* =========================================================
   BOTTOM STRIP
========================================================= */

.purelane-bundle-benefits-strip {

  min-height: 72px;

  margin-top: 18px;

  padding: 0 20px;

  box-sizing: border-box;

  display: grid;

  grid-template-columns:
    1fr 1.3fr 1fr;

  align-items: center;

  gap: 20px;

  border-radius: 22px;

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.76),
      rgba(232,238,235,.68)
    );

  border:
    1px solid
    rgba(185,198,200,.62);

}


/* LEFT */

.purelane-bundle-benefits-strip-left {

  display: flex;

  align-items: center;

  gap: 9px;

  color: #075d59;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .12em;

}


.purelane-strip-dot {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: #76a844;

}


/* CENTER */

.purelane-bundle-benefits-strip-center {

  text-align: center;

  color: #717283;

  font-size: 12px;

}


/* BUTTON */

.purelane-bundle-benefits-strip-button {

  justify-self: end;

  min-height: 39px;

  padding: 0 19px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 12px;

  border-radius: 999px;

  background: #075f5b;

  color: #ffffff;

  text-decoration: none;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .12em;

}


.purelane-bundle-benefits-strip-button span {

  font-size: 18px;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 950px) {

  .purelane-bundle-benefits-grid {

    grid-template-columns:
      repeat(2, 1fr);

  }

  .purelane-bundle-benefits-strip {

    grid-template-columns:
      1fr 1fr;

  }

  .purelane-bundle-benefits-strip-center {

    display: none;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

  .purelane-bundle-benefits {

    padding: 55px 0;

  }

  .purelane-bundle-benefits-inner {

    width: calc(100% - 30px);

  }

  .purelane-bundle-benefits-header h2 {

    font-size: 39px;

  }

  .purelane-bundle-benefits-header p {

    font-size: 14px;

  }

  .purelane-bundle-benefits-grid {

    grid-template-columns: 1fr;

    gap: 14px;

  }

  .purelane-bundle-benefit-card {

    min-height: 260px;

  }

  .purelane-bundle-benefits-strip {

    grid-template-columns: 1fr;

    gap: 12px;

    padding: 15px;

  }

  .purelane-bundle-benefits-strip-left {

    justify-content: center;

  }

  .purelane-bundle-benefits-strip-button {

    justify-self: center;

  }

}

</style>


