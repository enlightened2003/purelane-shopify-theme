<style>
  .purelane-product {
    background: #f7f6fb;
    padding: 80px 5vw 100px;
  }

  .purelane-product__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 80px;
    align-items: start;
  }

  /* PRODUCT MEDIA */

  .purelane-product__media {
    position: sticky;
    top: 30px;
  }

  .purelane-product__main-image {
    background: #ebe8f7;
    border-radius: 30px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .purelane-product__main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .purelane-product__placeholder {
    color: #77728c;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .purelane-product__thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
  }

  .purelane-product__thumbnail {
    width: 84px;
    height: 84px;
    flex: 0 0 84px;
    border-radius: 14px;
    overflow: hidden;
    background: #ebe8f7;
    border: 1px solid #ddd9ed;
  }

  .purelane-product__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PRODUCT INFORMATION */

  .purelane-product__info {
    padding-top: 20px;
  }

  .purelane-product__vendor {
    margin: 0 0 18px;
    color: #b77a29;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .purelane-product__title {
    margin: 0;
    color: #211b43;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 0.98;
    font-weight: 900;
    letter-spacing: -2px;
  }

  .purelane-product__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .purelane-product__stars {
    color: #e5a349;
    font-size: 18px;
    letter-spacing: 2px;
  }

  .purelane-product__rating-text {
    color: #77728a;
    font-size: 14px;
  }

  .purelane-product__price {
    margin-top: 24px;
    color: #56439a;
    font-size: 32px;
    font-weight: 900;
  }

  .purelane-product__description {
    margin-top: 28px;
    color: #6d687d;
    font-size: 17px;
    line-height: 1.75;
    max-width: 650px;
  }

  .purelane-product__divider {
    height: 1px;
    background: #ddd9e9;
    margin: 34px 0;
  }

  /* VARIANTS */

  .purelane-product__variant {
    margin-bottom: 24px;
  }

  .purelane-product__label {
    display: block;
    margin-bottom: 12px;
    color: #211b43;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .purelane-product__select {
    width: 100%;
    min-height: 54px;
    padding: 0 18px;
    border: 1px solid #d8d4e5;
    border-radius: 14px;
    background: #ffffff;
    color: #211b43;
    font-size: 16px;
  }

  /* QUANTITY */

  .purelane-product__quantity {
    margin-top: 24px;
  }

  .purelane-product__quantity-box {
    display: flex;
    align-items: center;
    width: 150px;
    height: 54px;
    border: 1px solid #d8d4e5;
    border-radius: 999px;
    overflow: hidden;
    background: #ffffff;
  }

  .purelane-product__quantity-box button {
    width: 48px;
    height: 100%;
    border: 0;
    background: transparent;
    color: #56439a;
    font-size: 22px;
    cursor: pointer;
  }

  .purelane-product__quantity-box button:hover {
    background: #f1eff8;
  }

  .purelane-product__quantity-box input {
    width: 54px;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    text-align: center;
    color: #211b43;
    font-size: 16px;
    font-weight: 800;
  }

  /* BUTTONS */

  .purelane-product__buttons {
    margin-top: 30px;
  }

  .purelane-product__add {
    width: 100%;
    min-height: 62px;
    border: 0;
    border-radius: 999px;
    background: #56439a;
    color: #ffffff;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .purelane-product__add:hover {
    background: #6652a9;
    transform: translateY(-2px);
  }

  .purelane-product__add:disabled {
    background: #aaa8b6;
    cursor: not-allowed;
    transform: none;
  }

  .purelane-product__buy {
    width: 100%;
    min-height: 62px;
    margin-top: 12px;
    border: 1px solid #56439a;
    border-radius: 999px;
    background: transparent;
    color: #56439a;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .purelane-product__buy:hover {
    background: #56439a;
    color: #ffffff;
  }

  /* BENEFITS */

  .purelane-product__benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 30px;
  }

  .purelane-product__benefit {
    padding: 18px 12px;
    border: 1px solid #e0ddeb;
    border-radius: 16px;
    background: #ffffff;
    text-align: center;
  }

  .purelane-product__benefit-icon {
    display: block;
    margin-bottom: 8px;
    color: #e5a349;
    font-size: 20px;
  }

  .purelane-product__benefit-text {
    color: #5e596f;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* MOBILE */

  @media screen and (max-width: 900px) {
    .purelane-product {
      padding: 50px 24px 70px;
    }

    .purelane-product__inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .purelane-product__media {
      position: static;
    }

    .purelane-product__info {
      padding-top: 0;
    }
  }

  @media screen and (max-width: 600px) {
    .purelane-product__title {
      font-size: 44px;
    }

    .purelane-product__benefits {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="purelane-product">

  <div class="purelane-product__inner">

    <!-- PRODUCT IMAGE -->

    <div class="purelane-product__media">

      <div class="purelane-product__main-image">

        {% if product.featured_image %}
          {{
            product.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '600, 800, 1000, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw',
              alt: product.featured_image.alt
          }}
        {% else %}
          <span class="purelane-product__placeholder">
            No product image
          </span>
        {% endif %}

      </div>

      {% if product.images.size > 1 %}

        <div class="purelane-product__thumbnails">

          {% for image in product.images %}

            <div class="purelane-product__thumbnail">
              {{
                image
                | image_url: width: 200
                | image_tag:
                  loading: 'lazy',
                  alt: image.alt
              }}
            </div>

          {% endfor %}

        </div>

      {% endif %}

    </div>


    <!-- PRODUCT INFORMATION -->

    <div class="purelane-product__info">

      {% if product.vendor != blank %}
        <p class="purelane-product__vendor">
          {{ product.vendor }}
        </p>
      {% endif %}


      <h1 class="purelane-product__title">
        {{ product.title }}
      </h1>


      <div class="purelane-product__rating">

        <span class="purelane-product__stars">
          ★★★★★
        </span>

        <span class="purelane-product__rating-text">
          Loved by Purelane homes
        </span>

      </div>


      <div class="purelane-product__price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>


      {% if product.description != blank %}
        <div class="purelane-product__description">
          {{ product.description }}
        </div>
      {% endif %}


      <div class="purelane-product__divider"></div>


      <!-- SHOPIFY PRODUCT FORM -->

      {% form 'product', product %}

        {% unless product.has_only_default_variant %}

          <div class="purelane-product__variant">

            <label
              class="purelane-product__label"
              for="PurelaneVariant-{{ section.id }}"
            >
              Choose your option
            </label>


            <select
              id="PurelaneVariant-{{ section.id }}"
              name="id"
              class="purelane-product__select"
            >

              {% for variant in product.variants %}

                <option
                  value="{{ variant.id }}"
                  {% if variant.id == product.selected_or_first_available_variant.id %}
                    selected
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >

                  {{ variant.title }}

                  {% unless variant.available %}
                    - Sold out
                  {% endunless %}

                </option>

              {% endfor %}

            </select>

          </div>

        {% else %}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >

        {% endunless %}


        <!-- QUANTITY -->

        <div class="purelane-product__quantity">

          <label
            class="purelane-product__label"
            for="PurelaneQuantity-{{ section.id }}"
          >
            Quantity
          </label>


          <div class="purelane-product__quantity-box">

            <button
              type="button"
              onclick="this.nextElementSibling.stepDown()"
              aria-label="Decrease quantity"
            >
              −
            </button>


            <input
              id="PurelaneQuantity-{{ section.id }}"
              type="number"
              name="quantity"
              value="1"
              min="1"
            >


            <button
              type="button"
              onclick="this.previousElementSibling.stepUp()"
              aria-label="Increase quantity"
            >
              +
            </button>

          </div>

        </div>


        <!-- ACTION BUTTONS -->

        <div class="purelane-product__buttons">

          <button
            type="submit"
            name="add"
            class="purelane-product__add"
            {% unless product.selected_or_first_available_variant.available %}
              disabled
            {% endunless %}
          >

            {% if product.selected_or_first_available_variant.available %}
              Add to Cart →
            {% else %}
              Sold Out
            {% endif %}

          </button>


          {% if product.selected_or_first_available_variant.available %}

            <button
              type="submit"
              name="checkout"
              class="purelane-product__buy"
            >
              Buy It Now →
            </button>

          {% endif %}

        </div>

      {% endform %}


      <!-- BENEFITS -->

      <div class="purelane-product__benefits">

        <div class="purelane-product__benefit">

          <span class="purelane-product__benefit-icon">
            ✦
          </span>

          <span class="purelane-product__benefit-text">
            Plant Powered
          </span>

        </div>


        <div class="purelane-product__benefit">

          <span class="purelane-product__benefit-icon">
            ✓
          </span>

          <span class="purelane-product__benefit-text">
            Family Friendly
          </span>

        </div>


        <div class="purelane-product__benefit">

          <span class="purelane-product__benefit-icon">
            ○
          </span>

          <span class="purelane-product__benefit-text">
            Gentle Formula
          </span>

        </div>

      </div>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Purelane Main Product",
  "settings": []
}
{% endschema %}