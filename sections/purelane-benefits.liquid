        LEARN MORE
      </a>

    </article>


    <!-- CARD 3 -->
    <article class="purelane-benefit-card">

      <div class="purelane-benefit-icon">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 20S4 15.5 4 9.5C4 6.5 6.2 5 8.5 5C10.1 5 11.5 5.9 12 7C12.5 5.9 13.9 5 15.5 5C17.8 5 20 6.5 20 9.5C20 15.5 12 20 12 20Z"/>
        </svg>
