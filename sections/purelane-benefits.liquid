<style>

<style>

/* =========================================================
   PURELANE BENEFITS
   ========================================================= */

.purelane-benefits-section {
  width: 100% !important;
  box-sizing: border-box !important;

  padding: 35px 0 70px !important;

  margin: 0 !important;

  background: transparent !important;

  display: block !important;
}


/* =========================================================
   THREE CARDS — FORCE ONE ROW
   ========================================================= */

.purelane-benefits-grid {
  width: calc(100% - 70px) !important;
  max-width: 1190px !important;

  margin: 0 auto !important;

  display: flex !important;
  flex-direction: row !important;

  align-items: stretch !important;

  justify-content: center !important;

  gap: 22px !important;

  box-sizing: border-box !important;
}


/* =========================================================
   CARD
   ========================================================= */

.purelane-benefit-card {
  width: 0 !important;
  min-width: 0 !important;

  flex: 1 1 0 !important;

  min-height: 400px !important;

  box-sizing: border-box !important;

  padding: 32px 30px 30px !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;

  border-radius: 30px !important;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.86),
      rgba(218,238,235,.74)
    ) !important;

  border: 1px solid rgba(190,201,205,.65) !important;

  box-shadow:
    0 18px 40px rgba(40,70,65,.08) !important;

  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
}


/* =========================================================
   ICON
   ========================================================= */

.purelane-benefit-icon {
  width: 62px !important;
  height: 62px !important;

  flex: 0 0 62px !important;

  display: grid !important;
  place-items: center !important;

  margin: 0 0 22px !important;

  border-radius: 18px !important;

  background: rgba(248,247,242,.88) !important;

  border: 1px solid rgba(190,198,202,.65) !important;

  box-sizing: border-box !important;
}


.purelane-benefit-icon svg {
  width: 28px !important;
  height: 28px !important;

  stroke: #76a844 !important;

  stroke-width: 1.6 !important;

  stroke-linecap: round !important;
  stroke-linejoin: round !important;
}


/* =========================================================
   TITLE
   ========================================================= */

.purelane-benefit-card h2 {
  margin: 0 0 14px !important;

  font-family: Arial, Helvetica, sans-serif !important;

  font-size: 36px !important;

  line-height: 1.05 !important;

  letter-spacing: -.035em !important;

  font-weight: 900 !important;

  color: #241a3d !important;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-benefit-card p {
  margin: 0 !important;

  max-width: 390px !important;

  font-family: Arial, Helvetica, sans-serif !important;

  font-size: 18px !important;

  line-height: 1.55 !important;

  font-weight: 400 !important;

  color: #666579 !important;
}


/* =========================================================
   LEARN MORE
   ========================================================= */

.purelane-benefit-button {
  margin-top: auto !important;

  min-height: 46px !important;

  padding: 0 23px !important;

  display: inline-flex !important;

  align-items: center !important;
  justify-content: center !important;

  border-radius: 999px !important;

  background: rgba(255,255,255,.86) !important;

  border: 1px solid rgba(110,96,160,.28) !important;

  color: #075d59 !important;

  font-family: Arial, Helvetica, sans-serif !important;

  font-size: 12px !important;

  font-weight: 800 !important;

  letter-spacing: .14em !important;

  text-decoration: none !important;

  box-sizing: border-box !important;
}


.purelane-benefit-button:hover {
  transform: translateY(-2px) !important;

  background: #ffffff !important;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .purelane-benefits-grid {
    width: calc(100% - 40px) !important;

    gap: 14px !important;
  }

  .purelane-benefit-card {
    min-height: 360px !important;

    padding: 25px 22px !important;
  }

  .purelane-benefit-card h2 {
    font-size: 27px !important;
  }

  .purelane-benefit-card p {
    font-size: 15px !important;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 650px) {

  .purelane-benefits-grid {
    width: calc(100% - 30px) !important;

    flex-direction: column !important;

    gap: 16px !important;
  }

  .purelane-benefit-card {
    width: 100% !important;

    min-height: 300px !important;

    flex: none !important;

    padding: 26px 24px !important;
  }

  .purelane-benefit-card h2 {
    font-size: 30px !important;
  }

  .purelane-benefit-card p {
    font-size: 16px !important;
  }

}

</style>

