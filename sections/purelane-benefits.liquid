  </div>

</section>


<style>

/* =========================================================
   PURELANE BENEFITS
========================================================= */

.purelane-benefits-section {

  width: 100%;

  margin: 0;

  padding: 65px 0 70px;

  box-sizing: border-box;

  background: transparent;

}


/* =========================================================
   THREE CARDS
========================================================= */

.purelane-benefits-grid {

  width: min(1430px, calc(100% - 80px));

  margin: 0 auto;

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 20px;

  align-items: stretch;

}


/* =========================================================
   CARD
========================================================= */

.purelane-benefit-card {

  height: 400px;

  min-height: 400px;

  box-sizing: border-box;

  padding: 32px 30px 28px;

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.82),
      rgba(218,238,235,.72)
    );

  border: 1px solid rgba(190,201,205,.65);

  box-shadow:
    0 12px 30px rgba(40,70,65,.06);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

}


/* =========================================================
   ICON
========================================================= */

.purelane-benefit-icon {

  width: 62px;

  height: 62px;

  flex: 0 0 62px;

  display: grid;

  place-items: center;

  margin-bottom: 22px;

  border-radius: 18px;

  background: rgba(248,247,242,.88);

  border: 1px solid rgba(190,198,202,.65);

}


.purelane-benefit-icon svg {

  width: 28px;

  height: 28px;

  stroke: #76a844;

  stroke-width: 1.6;

  stroke-linecap: round;

  stroke-linejoin: round;

}


/* =========================================================
   TITLE
========================================================= */

.purelane-benefit-card h2 {

  margin: 0 0 14px;

  padding: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 36px;

  line-height: 1.04;

  letter-spacing: -.035em;

  font-weight: 900;

  color: #241a3d;

}


/* =========================================================
   DESCRIPTION
========================================================= */

.purelane-benefit-card p {

  margin: 0;

  padding: 0;

  max-width: 395px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 18px;

  line-height: 1.55;

  font-weight: 400;

  color: #666579;

}


/* =========================================================
   BUTTON
========================================================= */

.purelane-benefit-button {

  margin-top: auto;

  min-height: 46px;

  padding: 0 23px;

  box-sizing: border-box;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  border-radius: 999px;

  background: rgba(255,255,255,.82);

  border: 1px solid rgba(110,96,160,.28);

  color: #075d59;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .14em;

  text-decoration: none;

  white-space: nowrap;

  transition:
    transform .2s ease,
    background .2s ease;

}


.purelane-benefit-button:hover {

  transform: translateY(-2px);

  background: #ffffff;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {

  .purelane-benefits-grid {

    width: calc(100% - 40px);

    gap: 18px;

  }


  .purelane-benefit-card {

    height: 390px;

    min-height: 390px;

    padding: 28px 24px 25px;

  }


  .purelane-benefit-card h2 {

    font-size: 30px;

  }


  .purelane-benefit-card p {

    font-size: 16px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .purelane-benefits-section {

    padding: 45px 0 55px;

  }


  .purelane-benefits-grid {

    width: calc(100% - 30px);

    grid-template-columns: 1fr;

    gap: 16px;

  }


  .purelane-benefit-card {

    height: auto;

    min-height: 330px;

    padding: 26px 24px;

  }


  .purelane-benefit-card h2 {

    font-size: 30px;

    line-height: 1.05;

  }


  .purelane-benefit-card p {

    font-size: 16px;

    line-height: 1.5;

  }

}

</style>


{% schema %}

{
  "name": "Purelane Benefits",
  "settings": []
}

{% endschema %}