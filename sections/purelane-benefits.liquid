<section class="purelane-benefits">

  <div class="purelane-benefits__grid">

    <!-- CARD 1 -->
    <article class="purelane-benefits__card">

      <div class="purelane-benefits__icon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="2.5"></circle>
          <circle cx="16" cy="7" r="2.5"></circle>
          <circle cx="13" cy="15" r="2.5"></circle>
          <path d="M5 19H19"></path>
          <path d="M8 11V14"></path>
          <path d="M16 10V12"></path>
        </svg>
      </div>

      <h2 class="purelane-benefits__title">
        LESS SCRUBBING
      </h2>

      <p class="purelane-benefits__text">
        A foaming formulation. The foam clings to grease and lifts it,
        so you wipe instead of scrub.
      </p>

      <a href="#" class="purelane-benefits__button">
        LEARN MORE
      </a>

    </article>


    <!-- CARD 2 -->
    <article class="purelane-benefits__card">

      <div class="purelane-benefits__icon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3L19 6.5V11.5C19 16.2 16.2 19.6 12 21C7.8 19.6 5 16.2 5 11.5V6.5L12 3Z"></path>
          <path d="M9 12L11 14L15 10"></path>
        </svg>
      </div>

      <h2 class="purelane-benefits__title">
        CLEAN INGREDIENTS
      </h2>

      <p class="purelane-benefits__text">
        No sulphates, no chlorine, no synthetic fragrance.
        Nothing on the label you would not want near your food.
      </p>

      <a href="#" class="purelane-benefits__button">
        LEARN MORE
      </a>

    </article>


    <!-- CARD 3 -->
    <article class="purelane-benefits__card">

      <div class="purelane-benefits__icon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 20S4 15.5 4 9.5C4 6.5 6.2 5 8.5 5C10.1 5 11.5 5.9 12 7C12.5 5.9 13.9 5 15.5 5C17.8 5 20 6.5 20 9.5C20 15.5 12 20 12 20Z"></path>
        </svg>
      </div>

      <h2 class="purelane-benefits__title">
        SAFE AROUND<br>
        EVERYONE
      </h2>

      <p class="purelane-benefits__text">
        Gentle on hands, safe around kids and pets,
        and it leaves no toxic residue on the surfaces
        you touch every day.
      </p>

      <a href="#" class="purelane-benefits__button">
        LEARN MORE
      </a>

    </article>

  </div>

</section>


<style>

/* =========================================================
   PURELANE BENEFITS
   Everything is scoped to this section only.
   ========================================================= */

.purelane-benefits {
  width: 100%;
  box-sizing: border-box;

  padding: 34px 0 70px;

  background: transparent;

  position: relative;
  z-index: 1;
}


/* =========================================================
   GRID
   ========================================================= */

.purelane-benefits__grid {
  width: min(1190px, calc(100% - 80px));

  margin: 0 auto;

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 22px;

  align-items: stretch;

  box-sizing: border-box;
}


/* =========================================================
   CARD
   ========================================================= */

.purelane-benefits__card {
  width: 100%;
  min-width: 0;
  min-height: 400px;

  box-sizing: border-box;

  padding: 32px 30px 30px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  border-radius: 30px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.78),
      rgba(218,238,235,0.72)
    );

  border: 1px solid rgba(190,201,205,0.72);

  box-shadow:
    0 16px 35px rgba(45,75,70,0.07);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  overflow: hidden;
}


/* =========================================================
   ICON
   ========================================================= */

.purelane-benefits__icon {
  width: 62px;
  height: 62px;

  flex: 0 0 62px;

  display: grid;
  place-items: center;

  margin-bottom: 22px;

  border-radius: 18px;

  background: rgba(248,247,242,0.82);

  border: 1px solid rgba(190,198,202,0.68);

  box-sizing: border-box;
}


.purelane-benefits__icon svg {
  width: 29px;
  height: 29px;

  stroke: #76a844;

  stroke-width: 1.6;

  stroke-linecap: round;
  stroke-linejoin: round;
}


/* =========================================================
   TITLE
   ========================================================= */

.purelane-benefits__title {
  margin: 0 0 14px;

  padding: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 36px;

  line-height: 1.05;

  font-weight: 900;

  letter-spacing: -0.035em;

  color: #241a3d;

  text-transform: uppercase;

  overflow-wrap: normal;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-benefits__text {
  margin: 0;

  padding: 0;

  max-width: 390px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 18px;

  line-height: 1.55;

  font-weight: 400;

  color: #666579;
}


/* =========================================================
   BUTTON
   ========================================================= */

.purelane-benefits__button {
  margin-top: auto;

  min-height: 46px;

  padding: 0 23px;

  box-sizing: border-box;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: rgba(255,255,255,0.82);

  border: 1px solid rgba(110,96,160,0.28);

  color: #075d59;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.14em;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.purelane-benefits__button:hover {
  transform: translateY(-2px);

  background: #ffffff;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1000px) {

  .purelane-benefits {
    padding: 30px 0 60px;
  }

  .purelane-benefits__grid {
    width: calc(100% - 50px);

    gap: 18px;
  }

  .purelane-benefits__card {
    min-height: 370px;

    padding: 28px 24px 26px;
  }

  .purelane-benefits__title {
    font-size: 30px;
  }

  .purelane-benefits__text {
    font-size: 16px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 700px) {

  .purelane-benefits {
    padding: 25px 0 50px;
  }

  .purelane-benefits__grid {
    width: calc(100% - 30px);

    grid-template-columns: 1fr;

    gap: 16px;
  }

  .purelane-benefits__card {
    min-height: 330px;

    padding: 26px 24px 25px;

    border-radius: 26px;
  }

  .purelane-benefits__icon {
    width: 58px;
    height: 58px;

    flex-basis: 58px;

    margin-bottom: 20px;
  }

  .purelane-benefits__title {
    font-size: 30px;

    line-height: 1.05;
  }

  .purelane-benefits__text {
    font-size: 16px;

    line-height: 1.5;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 420px) {

  .purelane-benefits__grid {
    width: calc(100% - 24px);
  }

  .purelane-benefits__card {
    min-height: 310px;

    padding: 24px 21px;
  }

  .purelane-benefits__title {
    font-size: 27px;
  }

}


/* =========================================================
   SHOPIFY THEME EDITOR
   ========================================================= */

.shopify-design-mode .purelane-benefits {
  position: relative;
}

</style>


{% schema %}
{
  "name": "Purelane Benefits",
  "settings": []
}
{% endschema %}