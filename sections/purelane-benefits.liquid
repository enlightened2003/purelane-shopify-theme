<style>

/* =========================================================
   PURELANE BENEFITS
   ========================================================= */

.purelane-benefits {

  position: relative;

  width: 100%;

  min-height: 560px;

  padding: 80px 0;

  overflow: hidden;

  box-sizing: border-box;

  background:
    linear-gradient(
      115deg,
      #e2f7e7 0%,
      #d7f1de 45%,
      #c8e9d4 100%
    );

}


/* =========================================================
   ORGANIC BACKGROUND WAVES
   ========================================================= */

.purelane-benefits::before {

  content: "";

  position: absolute;

  left: -10%;

  top: 70px;

  width: 120%;

  height: 180px;

  border-top:
    2px solid
    rgba(255,255,255,.42);

  border-radius: 50%;

  transform: rotate(-2deg);

  box-shadow:
    0 80px 0 rgba(255,255,255,.16),
    0 160px 0 rgba(255,255,255,.10);

  pointer-events: none;

}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.purelane-benefits-inner {

  position: relative;

  z-index: 2;

  width: calc(100% - 24%);

  max-width: 1428px;

  margin-left: auto;

  margin-right: auto;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px;

  box-sizing: border-box;

}


/* =========================================================
   CARD
   ========================================================= */

.purelane-benefit-card {

  width: 100%;

  min-width: 0;

  height: 398px;

  box-sizing: border-box;

  padding: 32px 30px;

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.82),
      rgba(224,239,235,.70)
    );

  border:
    1px solid
    rgba(194,205,215,.85);

  box-shadow:
    0 15px 35px
    rgba(49,78,65,.06);

  backdrop-filter:
    blur(16px);

  -webkit-backdrop-filter:
    blur(16px);

  overflow: hidden;

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}


.purelane-benefit-card:hover {

  transform:
    translateY(-4px);

  box-shadow:
    0 20px 40px
    rgba(49,78,65,.11);

}


/* =========================================================
   ICON
   ========================================================= */

.purelane-benefit-icon {

  width: 62px;

  height: 62px;

  flex: 0 0 62px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 20px;

  border-radius: 17px;

  background:
    rgba(247,246,241,.85);

  border:
    1px solid
    rgba(210,214,218,.9);

  color:
    #78a943;

}


.purelane-benefit-icon svg {

  width: 31px;

  height: 31px;

}


.purelane-benefit-icon svg path,
.purelane-benefit-icon svg circle {

  stroke:
    currentColor;

  stroke-width:
    2;

  stroke-linecap:
    round;

  stroke-linejoin:
    round;

}


/* =========================================================
   HEADING
   ========================================================= */

.purelane-benefit-card h2 {

  width: 100%;

  margin:
    0 0 14px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    37px;

  line-height:
    1.02;

  font-weight:
    900;

  letter-spacing:
    -0.045em;

  color:
    #29233e;

}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-benefit-card p {

  width: 100%;

  max-width:
    410px;

  margin:
    0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    18px;

  line-height:
    1.65;

  font-weight:
    400;

  color:
    #666879;

}


/* =========================================================
   BUTTON
   ========================================================= */

.purelane-benefit-button {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  min-width:
    155px;

  height:
    46px;

  margin-top:
    auto;

  padding:
    0 22px;

  box-sizing:
    border-box;

  border:
    1px solid
    #d3d5df;

  border-radius:
    999px;

  background:
    rgba(255,255,255,.84);

  color:
    #075650;

  text-decoration:
    none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    13px;

  font-weight:
    800;

  letter-spacing:
    .15em;

  white-space:
    nowrap;

  transition:
    all .25s ease;

}


.purelane-benefit-button:hover {

  background:
    #075650;

  color:
    #ffffff;

  transform:
    translateY(-2px);

}


/* =========================================================
   RIGHT PAGE INDICATOR
   ========================================================= */

.purelane-benefits-indicator {

  position:
    absolute;

  z-index:
    5;

  right:
    17px;

  top:
    50%;

  transform:
    translateY(-50%);

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    11px;

}


.purelane-benefits-indicator span {

  width:
    9px;

  height:
    9px;

  display:
    block;

  border-radius:
    50%;

  background:
    #aabfc1;

}


.purelane-benefits-indicator span.active {

  width:
    9px;

  height:
    31px;

  border-radius:
    999px;

  background:
    #c57913;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .purelane-benefits-inner {

    width:
      calc(100% - 10%);

    gap:
      18px;

  }

  .purelane-benefit-card {

    padding:
      28px 24px;

  }

  .purelane-benefit-card h2 {

    font-size:
      30px;

  }

  .purelane-benefit-card p {

    font-size:
      16px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-benefits {

    padding:
      45px 18px;

  }

  .purelane-benefits-inner {

    width:
      100%;

    max-width:
      none;

    grid-template-columns:
      1fr;

    gap:
      18px;

  }

  .purelane-benefit-card {

    height:
      370px;

    border-radius:
      24px;

  }

  .purelane-benefit-card h2 {

    font-size:
      30px;

  }

  .purelane-benefit-card p {

    font-size:
      16px;

  }

  .purelane-benefits-indicator {

    display:
      none;

  }

}

</style>


{% schema %}
{
  "name": "Purelane Benefits",
  "settings": []
}
{% endschema %}
