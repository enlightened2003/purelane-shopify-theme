<style>

.purelane-ingredients {
  position: relative;
  width: 100%;
  padding: 80px 0;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255,255,255,.55),
      transparent 40%
    ),
    linear-gradient(
      135deg,
      #dff4e9 0%,
      #d4eee0 50%,
      #e7f7ef 100%
    );
}


.purelane-nature-panel {
  width: calc(100% - 48px);
  max-width: 1140px;

  margin: 0 auto;

  padding: 60px 45px 45px;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.78),
      rgba(245,251,249,.65)
    );

  border: 1px solid rgba(87,112,142,.22);

  box-shadow:
    0 20px 60px rgba(45,80,65,.08),
    inset 0 1px 0 rgba(255,255,255,.8);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


.purelane-nature-heading {
  text-align: center;
}


.purelane-nature-heading h2 {
  margin: 0;

  font-family: Arial, sans-serif;

  font-size: clamp(42px, 6vw, 64px);

  line-height: .95;

  font-weight: 900;

  letter-spacing: -.025em;

  color: #12102f;
}


.purelane-nature-divider {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 26px;

  margin: 30px auto 80px;

  max-width: 330px;
}


.purelane-nature-divider span:first-child,
.purelane-nature-divider span:last-child {
  flex: 1;

  height: 1px;

  background: rgba(91,110,145,.35);
}


.purelane-leaf {
  width: 68px;
  height: 68px;

  display: grid;

  place-items: center;

  border-radius: 17px;

  border: 1px dashed rgba(91,110,145,.35);

  color: #6d9c49;

  font-size: 22px;

  font-weight: 700;
}


.purelane-ingredient-grid {
  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  border-top: 1px solid rgba(91,110,145,.18);

  border-bottom: 1px solid rgba(91,110,145,.18);
}


.purelane-ingredient-card {
  min-width: 0;

  padding: 26px 24px 10px;

  text-align: center;

  border-right:
    1px solid rgba(91,110,145,.18);
}


.purelane-ingredient-card:last-child {
  border-right: none;
}


.purelane-ingredient-icon {
  width: 82px;
  height: 82px;

  margin: 0 auto 28px;

  display: grid;

  place-items: center;

  color: #28837d;
}


.purelane-ingredient-icon svg {
  width: 78px;
  height: 78px;
}


.purelane-ingredient-card h3 {
  margin: 0 0 14px;

  font-family: Arial, sans-serif;

  font-size: 21px;

  line-height: 1.05;

  font-weight: 900;

  letter-spacing: .08em;

  color: #272342;
}


.purelane-ingredient-card p {
  margin: 0;

  font-family: Arial, sans-serif;

  font-size: 17px;

  line-height: 1.55;

  color: #626d81;
}


/* TABLET */

@media (max-width: 900px) {

  .purelane-nature-panel {
    padding: 50px 25px 35px;
  }

  .purelane-ingredient-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .purelane-ingredient-card {
    border-bottom:
      1px solid rgba(91,110,145,.18);
  }

  .purelane-ingredient-card:nth-child(3) {
    border-right: none;
  }

}


/* MOBILE */

@media (max-width: 600px) {

  .purelane-ingredients {
    padding: 45px 0;
  }

  .purelane-nature-panel {
    width: calc(100% - 24px);

    padding:
      40px 15px 25px;

    border-radius: 22px;
  }

  .purelane-nature-heading h2 {
    font-size: 36px;
  }

  .purelane-nature-divider {
    margin:
      25px auto 45px;
  }

  .purelane-ingredient-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .purelane-ingredient-card {
    padding:
      25px 12px 30px;

    border-right:
      1px solid rgba(91,110,145,.18);
  }

  .purelane-ingredient-card:nth-child(2n) {
    border-right: none;
  }

  .purelane-ingredient-icon {
    width: 65px;
    height: 65px;

    margin-bottom: 20px;
  }

  .purelane-ingredient-icon svg {
    width: 62px;
    height: 62px;
  }

  .purelane-ingredient-card h3 {
    font-size: 16px;
  }

  .purelane-ingredient-card p {
    font-size: 14px;
  }

}

</style>


{% schema %}
{
  "name": "Purelane Ingredients",
  "settings": []
}
{% endschema %}