<style>

/* =========================================================
   PURELANE SOURCED FROM NATURE
   ========================================================= */

.purelane-nature {

  position: relative;

  width: 100%;

  min-height: 600px;

  padding:
    80px
    12.5%;

  box-sizing: border-box;

  overflow: hidden;

  background:
    linear-gradient(
      115deg,
      #e9f9eb 0%,
      #d8f2df 50%,
      #c9edd6 100%
    );

}


/* =========================================================
   BACKGROUND WAVES
   ========================================================= */

.purelane-nature::before {

  content: "";

  position: absolute;

  left: -10%;

  right: -10%;

  top: 80px;

  height: 300px;

  border-radius: 50%;

  border-top:
    1px solid
    rgba(255,255,255,.65);

  transform:
    rotate(-2deg);

  box-shadow:
    0 35px 0
      rgba(255,255,255,.22),

    0 70px 0
      rgba(255,255,255,.12);

  pointer-events: none;

}


/* =========================================================
   MAIN GLASS PANEL
   ========================================================= */

.purelane-nature-panel {

  position: relative;

  z-index: 2;

  width: 100%;

  min-height: 475px;

  padding:
    48px
    34px
    42px;

  box-sizing: border-box;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.82),
      rgba(239,247,245,.72)
    );

  border:
    1px solid
    rgba(196,205,220,.85);

  box-shadow:
    0 20px 55px
    rgba(63,92,76,.08);

  backdrop-filter:
    blur(15px);

  -webkit-backdrop-filter:
    blur(15px);

}


/* =========================================================
   HEADING
   ========================================================= */

.purelane-nature-heading {

  text-align: center;

}


.purelane-nature-heading h2 {

  margin: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: clamp(42px, 4.1vw, 67px);

  line-height: 1;

  font-weight: 900;

  letter-spacing:
    -.035em;

  color: #17102f;

}


/* =========================================================
   DIVIDER
   ========================================================= */

.purelane-nature-divider {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 22px;

  margin-top: 23px;

}


.purelane-nature-divider span:first-child,
.purelane-nature-divider span:last-child {

  width: 80px;

  height: 1px;

  background:
    #b8bdd1;

}


.purelane-leaf {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  color:
    #d4861c;

  font-size: 22px;

  line-height: 1;

  transform:
    rotate(180deg);

}


/* =========================================================
   INGREDIENT GRID
   ========================================================= */

.purelane-nature-grid {

  display: grid;

  grid-template-columns:
    repeat(5, 1fr);

  margin-top: 62px;

}


/* =========================================================
   INGREDIENT
   ========================================================= */

.purelane-ingredient {

  position: relative;

  min-width: 0;

  padding:
    0 24px;

  text-align: center;

}


.purelane-ingredient
+ .purelane-ingredient {

  border-left:
    1px solid
    rgba(174,190,194,.45);

}


/* =========================================================
   ICON
   ========================================================= */

.purelane-ingredient-icon {

  width: 100px;

  height: 100px;

  margin:
    0 auto
    15px;

  display: flex;

  align-items: center;

  justify-content: center;

}


.purelane-ingredient-icon svg {

  width: 88px;

  height: 88px;

}


/* =========================================================
   TITLE
   ========================================================= */

.purelane-ingredient h3 {

  margin:
    0 0
    12px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 16px;

  line-height: 1.2;

  font-weight: 800;

  letter-spacing:
    .08em;

  color:
    #292039;

}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-ingredient p {

  margin: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  line-height: 1.55;

  font-weight: 400;

  color:
    #626878;

}


/* =========================================================
   RIGHT INDICATOR
   ========================================================= */

.purelane-nature-indicator {

  position: absolute;

  z-index: 10;

  right: 17px;

  top: 50%;

  transform:
    translateY(-50%);

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 11px;

}


.purelane-nature-indicator span {

  width: 9px;

  height: 9px;

  border-radius: 50%;

  background:
    #acbdc0;

}


.purelane-nature-indicator span.active {

  width: 9px;

  height: 31px;

  border-radius: 999px;

  background:
    #c97813;

}


/* =========================================================
   HOVER EFFECT
   ========================================================= */

.purelane-ingredient {

  transition:
    transform .3s ease;

}


.purelane-ingredient:hover {

  transform:
    translateY(-5px);

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1000px) {

  .purelane-nature {

    padding:
      60px 7%;

  }

  .purelane-nature-panel {

    padding:
      42px 20px;

  }

  .purelane-ingredient {

    padding:
      0 12px;

  }

  .purelane-ingredient h3 {

    font-size: 14px;

  }

  .purelane-ingredient p {

    font-size: 12px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-nature {

    min-height: auto;

    padding:
      40px 18px;

  }

  .purelane-nature-panel {

    min-height: auto;

    padding:
      35px 12px;

    border-radius: 20px;

  }

  .purelane-nature-heading h2 {

    font-size: 34px;

  }

  .purelane-nature-divider {

    margin-top: 17px;

  }

  .purelane-nature-divider span:first-child,
  .purelane-nature-divider span:last-child {

    width: 45px;

  }

  .purelane-nature-grid {

    grid-template-columns:
      1fr 1fr;

    gap:
      35px 0;

    margin-top: 40px;

  }

  .purelane-ingredient
  + .purelane-ingredient {

    border-left: none;

  }

  .purelane-ingredient:nth-child(even) {

    border-left:
      1px solid
      rgba(174,190,194,.45);

  }

  .purelane-ingredient-icon {

    width: 75px;

    height: 75px;

  }

  .purelane-ingredient-icon svg {

    width: 68px;

    height: 68px;

  }

  .purelane-ingredient h3 {

    font-size: 12px;

  }

  .purelane-ingredient p {

    font-size: 11px;

  }

  .purelane-nature-indicator {

    display: none;

  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {

  .purelane-nature-heading h2 {

    font-size: 29px;

  }

  .purelane-nature-grid {

    grid-template-columns:
      1fr;

  }

  .purelane-ingredient:nth-child(even) {

    border-left: none;

  }

}

</style>


