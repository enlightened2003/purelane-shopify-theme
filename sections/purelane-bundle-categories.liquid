<section class="purelane-bundle-categories">

  <div class="purelane-bundle-categories-inner">

    <!-- =====================================================
         HEADING
    ====================================================== -->

    <div class="purelane-bundle-categories-heading">
      <h2>FIND THE RIGHT BUNDLE FOR YOU</h2>
    </div>


    <!-- =====================================================
         BUNDLE CARDS
    ====================================================== -->

    <div class="purelane-bundle-categories-grid">

      <!-- CARD 1 -->
      <a href="/collections/purelane-cleaning-products"
         class="purelane-bundle-category-card">

        <div class="purelane-bundle-image">

          {% assign product = collections['purelane-cleaning-products'].products[0] %}

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="purelane-bottle-placeholder"></div>
          {% endif %}

        </div>

        <div class="purelane-bundle-category-info">
          <h3>KITCHEN BUNDLE</h3>
          <p>Grease, dishes &amp; more</p>
        </div>

      </a>


      <!-- CARD 2 -->
      <a href="/collections/purelane-cleaning-products"
         class="purelane-bundle-category-card">

        <div class="purelane-bundle-image">

          {% assign product = collections['purelane-cleaning-products'].products[1] %}

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="purelane-bottle-placeholder"></div>
          {% endif %}

        </div>

        <div class="purelane-bundle-category-info">
          <h3>BATHROOM BUNDLE</h3>
          <p>Deep clean &amp; disinfect</p>
        </div>

      </a>


      <!-- CARD 3 -->
      <a href="/collections/purelane-cleaning-products"
         class="purelane-bundle-category-card">

        <div class="purelane-bundle-image">

          {% assign product = collections['purelane-cleaning-products'].products[2] %}

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="purelane-bottle-placeholder"></div>
          {% endif %}

        </div>

        <div class="purelane-bundle-category-info">
          <h3>LAUNDRY BUNDLE</h3>
          <p>Softer, fresher wash</p>
        </div>

      </a>


      <!-- CARD 4 -->
      <a href="/collections/purelane-cleaning-products"
         class="purelane-bundle-category-card">

        <div class="purelane-bundle-image">

          {% assign product = collections['purelane-cleaning-products'].products[3] %}

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="purelane-bottle-placeholder"></div>
          {% endif %}

        </div>

        <div class="purelane-bundle-category-info">
          <h3>HARD WATER BUNDLE</h3>
          <p>Melt away limescale</p>
        </div>

      </a>

    </div>


    <!-- =====================================================
         BENEFITS STRIP
    ====================================================== -->

    <div class="purelane-bundle-benefits-strip">


      <!-- PLANT DERIVED -->

      <div class="purelane-bundle-benefit">

        <div class="purelane-bundle-benefit-icon">

          <svg viewBox="0 0 32 32" fill="none">
            <path d="M16 27C16 19 17 12 25 7"/>
            <path d="M16 21C11 21 7 18 6 12"/>
            <path d="M17 16C21 16 24 14 26 10"/>
            <path d="M16 21C13 18 11 15 11 11"/>
          </svg>

        </div>

        <div>
          <strong>
            PLANT DERIVED<br>
            FORMULAS
          </strong>
        </div>

      </div>


      <!-- RECYCLABLE -->

      <div class="purelane-bundle-benefit">

        <div class="purelane-bundle-benefit-icon">

          <svg viewBox="0 0 32 32" fill="none">
            <rect x="7" y="9" width="18" height="18" rx="2"/>
            <path d="M10 9V6H22V9"/>
            <path d="M12 14H20"/>
            <path d="M12 19H18"/>
          </svg>

        </div>

        <div>
          <strong>
            RECYCLABLE<br>
            PACKAGING
          </strong>
        </div>

      </div>


      <!-- SAFE -->

      <div class="purelane-bundle-benefit">

        <div class="purelane-bundle-benefit-icon">

          <svg viewBox="0 0 32 32" fill="none">
            <path d="M16 27C16 27 6 21 6 13C6 8 9 6 12 6C14 6 15.5 7 16 9C16.5 7 18 6 20 6C23 6 26 8 26 13C26 21 16 27 16 27Z"/>
          </svg>

        </div>

        <div>
          <strong>
            SAFE FOR<br>
            KIDS &amp; PETS
          </strong>
        </div>

      </div>


      <!-- MADE IN INDIA -->

      <div class="purelane-bundle-benefit">

        <div class="purelane-bundle-benefit-icon">

          <svg viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="10"/>
            <path d="M6 16H26"/>
            <path d="M16 6C19 9 20 12 20 16C20 20 19 23 16 26"/>
            <path d="M16 6C13 9 12 12 12 16C12 20 13 23 16 26"/>
