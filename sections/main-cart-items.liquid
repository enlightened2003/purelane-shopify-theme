<div class="purelane-cart">
  <div class="purelane-cart__container">

    <div class="purelane-cart__header">
      <span class="purelane-cart__eyebrow">YOUR BAG</span>
      <h1>YOUR CART.</h1>

      {% if cart.item_count > 0 %}
        <p>{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} in your cart.</p>
      {% endif %}
    </div>

    {% if cart.item_count == 0 %}

      <div class="purelane-cart__empty">
        <div class="purelane-cart__empty-icon">✦</div>

        <h2>Your cart is empty.</h2>

        <p>
          Discover simple, effective cleaning for every room in your home.
        </p>

        <a href="{{ routes.all_products_collection_url }}" class="purelane-cart__button">
          SHOP PRODUCTS
          <span>→</span>
        </a>
      </div>

    {% else %}

      <form action="{{ routes.cart_url }}" method="post" id="cart">

        <div class="purelane-cart__items">

          {% for item in cart.items %}

            <div class="purelane-cart__item">

              <div class="purelane-cart__image">

                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 500 }}"
                    alt="{{ item.image.alt | escape }}"
                    loading="lazy"
                    width="250"
                    height="250"
                  >
                {% else %}
                  <div class="purelane-cart__no-image">
                    PURELANE
                  </div>
                {% endif %}

              </div>

              <div class="purelane-cart__details">

                <div class="purelane-cart__product-info">

                  <span class="purelane-cart__product-type">
                    PURELANE HOMECARE
                  </span>

                  <h2>
                    <a href="{{ item.url }}">
                      {{ item.product.title }}
                    </a>
                  </h2>

                  {% unless item.product.has_only_default_variant %}
                    <p class="purelane-cart__variant">
                      {{ item.variant.title }}
                    </p>
                  {% endunless %}

                </div>

                <div class="purelane-cart__price">
                  {{ item.final_line_price | money }}
                </div>

                <div class="purelane-cart__controls">

                  <div class="purelane-cart__quantity">

                    <button
                      type="button"
                      class="purelane-qty-btn"
                      onclick="this.parentElement.querySelector('input').stepDown(); this.parentElement.querySelector('input').dispatchEvent(new Event('change', {bubbles:true}))"
                      aria-label="Decrease quantity"
                    >
                      −
                    </button>

                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="purelane-qty-input"
                      aria-label="Quantity for {{ item.product.title }}"
                    >

                    <button
                      type="button"
                      class="purelane-qty-btn"
                      onclick="this.parentElement.querySelector('input').stepUp(); this.parentElement.querySelector('input').dispatchEvent(new Event('change', {bubbles:true}))"
                      aria-label="Increase quantity"
                    >
                      +
                    </button>

                  </div>

                  <a
                    href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
                    class="purelane-remove"
                  >
                    REMOVE
                  </a>

                </div>

              </div>

            </div>

          {% endfor %}

        </div>

        <button
          type="submit"
          name="update"
          class="purelane-cart__update"
        >
          UPDATE CART
        </button>

      </form>

    {% endif %}

  </div>
</div>

<style>
  .purelane-cart {
    background: #f7f7fb;
    color: #211b42;
    padding: 90px 5vw 100px;
  }

  .purelane-cart__container {
    max-width: 1250px;
    margin: 0 auto;
  }

  .purelane-cart__header {
    margin-bottom: 55px;
  }

  .purelane-cart__eyebrow {
    display: block;
    color: #b87925;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 4px;
    margin-bottom: 18px;
  }

  .purelane-cart__header h1 {
    margin: 0;
    font-size: clamp(54px, 7vw, 100px);
    line-height: .9;
    font-weight: 900;
    letter-spacing: -4px;
  }

  .purelane-cart__header p {
    margin-top: 25px;
    color: #716d82;
    font-size: 18px;
  }

  .purelane-cart__items {
    background: #fff;
    border: 1px solid #e4e1ee;
    border-radius: 28px;
    overflow: hidden;
  }

  .purelane-cart__item {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 35px;
    padding: 30px;
    border-bottom: 1px solid #e8e5ef;
  }

  .purelane-cart__item:last-child {
    border-bottom: none;
  }

  .purelane-cart__image {
    width: 190px;
    height: 190px;
    border-radius: 18px;
    overflow: hidden;
    background: #ebe9f7;
  }

  .purelane-cart__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .purelane-cart__no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    color: #55449b;
    letter-spacing: 2px;
  }

  .purelane-cart__details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px 0;
  }

  .purelane-cart__product-type {
    color: #b87925;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .purelane-cart__product-info h2 {
    margin: 12px 0 5px;
    font-size: 27px;
    font-weight: 800;
  }

  .purelane-cart__product-info h2 a {
    color: #211b42;
    text-decoration: none;
  }

  .purelane-cart__variant {
    margin: 5px 0;
    color: #777287;
  }

  .purelane-cart__price {
    font-size: 23px;
    font-weight: 800;
    color: #55449b;
  }

  .purelane-cart__controls {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 20px;
  }

  .purelane-cart__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #dcd8e8;
    border-radius: 30px;
    overflow: hidden;
    background: #fafafd;
  }

  .purelane-qty-btn {
    width: 42px;
    height: 42px;
    border: none;
    background: transparent;
    color: #55449b;
    font-size: 20px;
    cursor: pointer;
  }

  .purelane-qty-input {
    width: 45px;
    border: none;
    background: transparent;
    text-align: center;
    font-weight: 700;
    color: #211b42;
  }

  .purelane-qty-input:focus {
    outline: none;
  }

  .purelane-remove {
    color: #777287;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-decoration: underline;
  }

  .purelane-cart__update {
    margin-top: 25px;
    border: 1px solid #55449b;
    background: transparent;
    color: #55449b;
    border-radius: 40px;
    padding: 16px 28px;
    font-weight: 800;
    letter-spacing: 2px;
    cursor: pointer;
  }

  .purelane-cart__empty {
    text-align: center;
    background: #fff;
    border: 1px solid #e4e1ee;
    border-radius: 28px;
    padding: 90px 30px;
  }

  .purelane-cart__empty-icon {
    width: 70px;
    height: 70px;
    border: 1px solid #e6b15a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px;
    color: #e6a94f;
    font-size: 28px;
  }

  .purelane-cart__empty h2 {
    margin: 0;
    font-size: 42px;
    font-weight: 900;
  }

  .purelane-cart__empty p {
    max-width: 550px;
    margin: 20px auto 35px;
    color: #777287;
    font-size: 17px;
    line-height: 1.7;
  }

  .purelane-cart__button {
    display: inline-flex;
    align-items: center;
    gap: 25px;
    background: #55449b;
    color: #fff;
    text-decoration: none;
    padding: 18px 30px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  @media screen and (max-width: 750px) {

    .purelane-cart {
      padding: 55px 20px 70px;
    }

    .purelane-cart__header {
      margin-bottom: 35px;
    }

    .purelane-cart__header h1 {
      letter-spacing: -2px;
    }

    .purelane-cart__item {
      grid-template-columns: 100px 1fr;
      gap: 18px;
      padding: 20px;
    }

    .purelane-cart__image {
      width: 100px;
      height: 100px;
    }

    .purelane-cart__product-info h2 {
      font-size: 19px;
    }

    .purelane-cart__price {
      font-size: 18px;
    }

    .purelane-cart__controls {
      gap: 12px;
      flex-wrap: wrap;
    }

  }
</style>

<script>
  document.addEventListener('change', function(event) {
    if (!event.target.classList.contains('purelane-qty-input')) return;

    const form = event.target.closest('form');

    if (form) {
      form.submit();
    }
  });
</script>

{% schema %}
{
  "name": "Purelane Cart Items",
  "settings": []
}
{% endschema %}