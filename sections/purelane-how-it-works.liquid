<section class="purelane-how">

  <div class="purelane-how-inner">

    <!-- LEFT SIDE -->
    <div class="purelane-how-intro">

      <span class="purelane-how-kicker">
        SIMPLE BY DESIGN
      </span>

      <h2>
        HOW IT
        <span>WORKS.</span>
      </h2>

      <p>
        Powerful cleaning doesn't need to be complicated.
        Purelane keeps your routine simple, effective and better
        for your home.
      </p>

      <a href="#shop" class="purelane-how-button">
        SHOP PURELANE
        <span>→</span>
      </a>

    </div>


    <!-- RIGHT SIDE -->
    <div class="purelane-how-steps">

      <!-- STEP 01 -->
      <div class="purelane-how-step">

        <div class="purelane-how-number">
          01
        </div>

        <div class="purelane-how-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M7 4H17V20H7V4Z"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path
              d="M9 7H15"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path
              d="M9 11H15"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <div class="purelane-how-content">
          <h3>CHOOSE YOUR CLEAN</h3>

          <p>
            Pick the Purelane product that fits your
            everyday cleaning needs.
          </p>
        </div>

      </div>


      <!-- STEP 02 -->
      <div class="purelane-how-step">

        <div class="purelane-how-number">
          02
        </div>

        <div class="purelane-how-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M8 5H16V19H8V5Z"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path
              d="M10 3H14"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path
              d="M10 9H14"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path
              d="M10 13H14"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <div class="purelane-how-content">
          <h3>SPRAY &amp; CLEAN</h3>

          <p>
            Apply where you need it and wipe away
            everyday messes with ease.
          </p>
        </div>

      </div>


      <!-- STEP 03 -->
      <div class="purelane-how-step">

        <div class="purelane-how-number">
          03
        </div>

        <div class="purelane-how-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M12 20C16.5 20 19 17.2 19 13.5C19 9.5 16.2 6 12 4C7.8 6 5 9.5 5 13.5C5 17.2 7.5 20 12 20Z"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path
              d="M12 4C11.5 8 12 12 12 16"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <div class="purelane-how-content">
          <h3>ENJOY A CLEANER HOME</h3>

          <p>
            Get powerful everyday cleaning without
            unnecessary harsh chemicals.
          </p>
        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* ==============================
     PURELANE HOW IT WORKS
  ============================== */

  .purelane-how {
    width: 100%;
    padding: 110px 24px;
    background: #f4f3f7;
    color: #211a3d;
  }

  .purelane-how-inner {
    max-width: 1180px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;

    align-items: center;
  }


  /* ==============================
     INTRO
  ============================== */

  .purelane-how-intro {
    max-width: 480px;
  }

  .purelane-how-kicker {
    display: block;

    margin-bottom: 28px;

    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;

    letter-spacing: 0.24em;

    color: #b87520;
  }

  .purelane-how-intro h2 {
    margin: 0 0 30px;

    font-family: Arial, sans-serif;
    font-size: clamp(52px, 6vw, 82px);
    font-weight: 900;

    line-height: 0.88;
    letter-spacing: -0.04em;

    color: #211a3d;
  }

  .purelane-how-intro h2 span {
    display: block;
    color: #514196;
  }

  .purelane-how-intro p {
    max-width: 470px;

    margin-bottom: 35px;

    font-family: Arial, sans-serif;
    font-size: 17px;
    line-height: 1.7;

    color: #686477;
  }


  /* ==============================
     BUTTON
  ============================== */

  .purelane-how-button {
    display: inline-flex;
    align-items: center;
    gap: 22px;

    padding: 17px 27px;

    border-radius: 40px;

    background: #514196;
    color: #ffffff;

    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 800;

    letter-spacing: 0.12em;

    text-decoration: none;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .purelane-how-button span {
    font-size: 20px;
    line-height: 1;
  }

  .purelane-how-button:hover {
    transform: translateY(-2px);
    background: #423483;
  }


  /* ==============================
     STEPS
  ============================== */

  .purelane-how-steps {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .purelane-how-step {
    display: grid;

    grid-template-columns: 50px 72px 1fr;
    align-items: center;

    min-height: 150px;

    padding: 28px 32px;

    background: #ffffff;

    border: 1px solid rgba(81, 65, 150, 0.12);

    border-radius: 24px;

    box-shadow:
      0 18px 45px rgba(33, 26, 61, 0.06);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .purelane-how-step:hover {
    transform: translateY(-4px);

    box-shadow:
      0 24px 55px rgba(33, 26, 61, 0.11);
  }


  /* ==============================
     NUMBER
  ============================== */

  .purelane-how-number {
    font-family: Arial, sans-serif;

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 0.12em;

    color: #9b96aa;
  }


  /* ==============================
     ICON
  ============================== */

  .purelane-how-icon {
    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    color: #eda442;

    background: #faf8f2;

    border: 1px solid rgba(237, 164, 66, 0.35);
  }

  .purelane-how-icon svg {
    width: 27px;
    height: 27px;
  }


  /* ==============================
     CONTENT
  ============================== */

  .purelane-how-content h3 {
    margin: 0 0 9px;

    font-family: Arial, sans-serif;

    font-size: 20px;
    font-weight: 900;

    letter-spacing: -0.02em;

    color: #211a3d;
  }

  .purelane-how-content p {
    margin: 0;

    max-width: 500px;

    font-family: Arial, sans-serif;

    font-size: 14px;
    line-height: 1.65;

    color: #777284;
  }


  /* ==============================
     TABLET
  ============================== */

  @media (max-width: 900px) {

    .purelane-how {
      padding: 80px 22px;
    }

    .purelane-how-inner {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .purelane-how-intro {
      max-width: 650px;
    }

  }


  /* ==============================
     MOBILE
  ============================== */

  @media (max-width: 600px) {

    .purelane-how {
      padding: 70px 18px;
    }

    .purelane-how-intro h2 {
      font-size: 54px;
    }

    .purelane-how-step {
      grid-template-columns: 40px 58px 1fr;

      padding: 22px 18px;

      min-height: 130px;

      border-radius: 20px;
    }

    .purelane-how-icon {
      width: 48px;
      height: 48px;
    }

    .purelane-how-icon svg {
      width: 22px;
      height: 22px;
    }

    .purelane-how-content h3 {
      font-size: 16px;
    }

    .purelane-how-content p {
      font-size: 12px;
    }

  }

</style>


{% schema %}
{
  "name": "Purelane How It Works",
  "settings": []
}
{% endschema %}