<style>
  .purelane-cart-footer {
    background: #20193f;
    color: #f7f5fb;
    padding: 80px 5vw 90px;
  }

  .purelane-cart-footer__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 520px;
    gap: 80px;
    align-items: center;
  }

  .purelane-cart-footer__eyebrow {
    margin: 0 0 18px;
    color: #e8a64c;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .purelane-cart-footer__title {
    margin: 0;
    max-width: 600px;
    color: #f7f5fb;
    font-size: clamp(42px, 5vw, 76px);
    line-height: .95;
    font-weight: 900;
    letter-spacing: -2px;
    text-transform: uppercase;
  }

  .purelane-cart-footer__text {
    max-width: 560px;
    margin: 28px 0 0;
    color: #c7c3d5;
    font-size: 18px;
    line-height: 1.7;
  }

  .purelane-cart-footer__card {
    background: #2c264c;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 28px;
    padding: 38px;
  }

  .purelane-cart-footer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;
  }

  .purelane-cart-footer__subtotal-label {
    color: #f7f5fb;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .purelane-cart-footer__subtotal-price {
    color: #e8a64c;
    font-size: 34px;
    font-weight: 900;
    white-space: nowrap;
  }

  .purelane-cart-footer__shipping {
    margin: 0 0 30px;
    color: #aaa6bd;
    font-size: 15px;
  }

  .purelane-cart-footer__checkout {
    width: 100%;
    min-height: 58px;
    border: 0;
    border-radius: 999px;
    background: #5a469e;
    color: #fff;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease;
  }

  .purelane-cart-footer__checkout:hover {
    background: #6854ad;
    transform: translateY(-2px);
  }

  .purelane-cart-footer__continue {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 58px;
    margin-top: 14px;
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 999px;
    color: #f7f5fb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: background .2s ease, border-color .2s ease;
  }

  .purelane-cart-footer__continue:hover {
    background: rgba(255,255,255,.08);
    border-color: rgba(255,255,255,.45);
  }

  @media screen and (max-width: 900px) {
    .purelane-cart-footer {
      padding: 60px 24px 70px;
    }

    .purelane-cart-footer__inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .purelane-cart-footer__card {
      padding: 28px;
    }
  }

  @media screen and (max-width: 600px) {
    .purelane-cart-footer__title {
      font-size: 44px;
    }

    .purelane-cart-footer__subtotal {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .purelane-cart-footer__subtotal-price {
      font-size: 30px;
    }
  }
</style>

<div class="purelane-cart-footer">
  <div class="purelane-cart-footer__inner">

    <div class="purelane-cart-footer__content">
      <p class="purelane-cart-footer__eyebrow">
        Purelane Homecare
      </p>

      <h2 class="purelane-cart-footer__title">
        CLEANING<br>
        MADE SIMPLE.
      </h2>

      <p class="purelane-cart-footer__text">
        Powerful cleaning for everyday life. Better for your home,
        gentler for the people and planet around you.
      </p>
    </div>

    <div class="purelane-cart-footer__card">

      <div class="purelane-cart-footer__subtotal">
        <span class="purelane-cart-footer__subtotal-label">
          Subtotal
        </span>

        <span class="purelane-cart-footer__subtotal-price">
          {{ cart.total_price | money }}
        </span>
      </div>

      <p class="purelane-cart-footer__shipping">
        Shipping calculated at checkout.
      </p>

      <form action="{{ routes.cart_url }}" method="post">

        <button
          type="submit"
          name="checkout"
          class="purelane-cart-footer__checkout">
          Checkout →
        </button>

      </form>

      <a
        href="{{ routes.all_products_collection_url }}"
        class="purelane-cart-footer__continue">
        Continue Shopping →
      </a>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Purelane Cart Footer",
  "settings": []
}
{% endschema %}