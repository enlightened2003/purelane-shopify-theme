<style>

/* =====================================================
   WHOLE REVIEWS SECTION
===================================================== */

.purelane-reviews {

  position: relative;

  width: 100%;

  padding: 55px 0 85px;

  overflow: hidden;

  box-sizing: border-box;

  background:
    radial-gradient(
      ellipse at 50% 0%,
      rgba(255,255,255,.28),
      transparent 55%
    ),

    linear-gradient(
      180deg,
      #dff5e4 0%,
      #c8e9d7 50%,
      #b8dccb 100%
    );

}


/* =====================================================
   SUBTLE WATER / WAVE EFFECT
===================================================== */

.purelane-reviews::before {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .35;

  background:

    radial-gradient(
      ellipse at 20% 25%,
      transparent 0,
      transparent 42%,
      rgba(255,255,255,.65) 43%,
      transparent 44%
    ),

    radial-gradient(
      ellipse at 75% 65%,
      transparent 0,
      transparent 43%,
      rgba(255,255,255,.55) 44%,
      transparent 45%
    );

}


/* =====================================================
   HEADER
===================================================== */

.purelane-reviews-header {

  position: relative;

  z-index: 2;

  display: flex;

  justify-content: center;

  align-items: center;

  flex-wrap: wrap;

  gap: 10px;

  padding: 0 25px;

  margin-bottom: 40px;

  color: #55566d;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 17px;

  font-weight: 800;

  letter-spacing: .13em;

  text-transform: uppercase;

}


.purelane-reviews-header .review-stars {

  color: #75a83a;

  font-size: 20px;

  letter-spacing: 1px;

}


.purelane-reviews-header .review-rating {

  color: #bf7212;

  font-size: 18px;

}


.purelane-reviews-header b {

  color: #bd7115;

}


/* =====================================================
   MOVING WINDOW
===================================================== */

.purelane-reviews-window {

  position: relative;

  z-index: 2;

  width: 100%;

  overflow: hidden;

}


/* =====================================================
   MOVING TRACK
===================================================== */

.purelane-reviews-track {

  display: flex;

  width: max-content;

  gap: 20px;

  padding-left: 20px;

  animation:
    purelaneReviewsMove
    32s
    linear
    infinite;

  will-change: transform;

}


/* =====================================================
   INFINITE MOVEMENT

   Because there are two identical sets
   of cards, -50% creates a seamless loop.
===================================================== */

@keyframes purelaneReviewsMove {

  from {

    transform:
      translateX(0);

  }

  to {

    transform:
      translateX(-50%);

  }

}


/* =====================================================
   REVIEW CARD
===================================================== */

.purelane-review-card {

  flex: 0 0 390px;

  width: 390px;

  height: 280px;

  box-sizing: border-box;

  padding: 32px 28px 25px;

  border-radius: 22px;

  border: 1px solid
    rgba(180,195,200,.65);

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.78),
      rgba(222,239,235,.76)
    );

  box-shadow:

    0 18px 35px
    rgba(50,80,70,.08);

  backdrop-filter: blur(16px);

  -webkit-backdrop-filter: blur(16px);

}


/* =====================================================
   STARS
===================================================== */

.review-stars-small {

  margin-bottom: 25px;

  color: #6fa536;

  font-size: 18px;

  letter-spacing: 1px;

}


/* =====================================================
   TITLE
===================================================== */

.purelane-review-card h3 {

  margin: 0 0 13px;

  color: #21183d;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 21px;

  line-height: 1.15;

  font-weight: 900;

  letter-spacing: -.02em;

  text-transform: uppercase;

}


/* =====================================================
   REVIEW TEXT
===================================================== */

.purelane-review-card p {

  margin: 0;

  max-width: 350px;

  color: #66697d;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 17px;

  line-height: 1.5;

}


/* =====================================================
   AUTHOR
===================================================== */

.review-author {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 22px;

  white-space: nowrap;

  color: #858898;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 13px;

  letter-spacing: .06em;

}


.review-author b {

  color: #28665f;

  font-weight: 900;

}


/* =====================================================
   PAUSE ON HOVER
===================================================== */

.purelane-reviews-window:hover
.purelane-reviews-track {

  animation-play-state: paused;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 900px) {

  .purelane-reviews {

    padding: 45px 0 65px;

  }

  .purelane-reviews-header {

    font-size: 14px;

  }

  .purelane-review-card {

    flex-basis: 340px;

    width: 340px;

    height: 270px;

    padding: 27px 24px;

  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  .purelane-reviews {

    padding: 40px 0 55px;

  }

  .purelane-reviews-header {

    gap: 7px;

    font-size: 11px;

    letter-spacing: .08em;

  }

  .purelane-reviews-header .review-stars {

    font-size: 15px;

  }

  .purelane-review-card {

    flex-basis: 310px;

    width: 310px;

    height: 265px;

    padding: 25px 22px;

  }

  .purelane-review-card h3 {

    font-size: 19px;

  }

  .purelane-review-card p {

    font-size: 15px;

  }

}


/* =====================================================
   REDUCED MOTION
===================================================== */

@media (prefers-reduced-motion: reduce) {

  .purelane-reviews-track {

    animation: none;

  }

}

</style>


{% schema %}

{
  "name": "Purelane Reviews",
  "settings": [
    {
