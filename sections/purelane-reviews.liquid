<style>

/* =========================================================
   SECTION
   ========================================================= */

.purelane-reviews {

  position: relative;

  width: 100%;

  min-height: 315px;

  padding:
    20px 0
    35px;

  overflow: hidden;

  background:
    linear-gradient(
      115deg,
      #e5f8e8 0%,
      #d9f3df 48%,
      #ccefd8 100%
    );

}


/* =========================================================
   BACKGROUND
   ========================================================= */

.purelane-reviews-bg {

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .8;

  background:

    radial-gradient(
      ellipse at 10% 20%,
      rgba(255,255,255,.65),
      transparent 45%
    ),

    radial-gradient(
      ellipse at 90% 70%,
      rgba(172,224,188,.35),
      transparent 50%
    );

}


.purelane-reviews-bg::before {

  content: "";

  position: absolute;

  width: 130%;

  height: 180px;

  left: -15%;

  bottom: -55px;

  border-radius: 50%;

  border-top:
    1px solid rgba(255,255,255,.6);

  transform:
    rotate(-3deg);

  box-shadow:
    0 -25px 0 rgba(255,255,255,.18),
    0 -50px 0 rgba(255,255,255,.10);

}


/* =========================================================
   HEADER
   ========================================================= */

.purelane-reviews-heading {

  position: relative;

  z-index: 5;

  height: 25px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  white-space: nowrap;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 7px;

  font-weight: 700;

  letter-spacing: .16em;

  color: #74717c;

}


.purelane-reviews-heading .review-stars {

  color: #62a52a;

  font-size: 8px;

  letter-spacing: 1px;

}


.purelane-reviews-heading strong {

  color: #65a42c;

  font-size: 8px;

}


.purelane-reviews-heading .review-orange {

  color: #cf7411;

}


/* =========================================================
   REVIEW WINDOW
   ========================================================= */

.purelane-review-window {

  position: relative;

  z-index: 3;

  width: 100%;

  overflow: hidden;

  margin-top: 5px;

}


/* =========================================================
   TRACK
   ========================================================= */

.purelane-review-track {

  display: flex;

  width: max-content;

  gap: 10px;

  transform:
    translateX(-20px);

  animation:
    purelaneReviewScroll
    28s
    linear
    infinite;

}


/* =========================================================
   CARD
   ========================================================= */

.purelane-review-card {

  width: 235px;

  min-height: 190px;

  flex-shrink: 0;

  padding:
    17px 17px 14px;

  border-radius: 8px;

  background:
    rgba(255,255,255,.72);

  border:
    1px solid rgba(255,255,255,.8);

  box-shadow:
    0 5px 16px rgba(70,110,80,.07);

  backdrop-filter:
    blur(8px);

  -webkit-backdrop-filter:
    blur(8px);

}


/* =========================================================
   STARS
   ========================================================= */

.review-card-stars {

  margin-bottom: 9px;

  color: #72a82b;

  font-size: 8px;

  letter-spacing: 2px;

}


/* =========================================================
   REVIEW TITLE
   ========================================================= */

.purelane-review-card h3 {

  margin:
    0 0
    8px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  line-height: 1.25;

  font-weight: 800;

  letter-spacing: .03em;

  color: #27352c;

}


/* =========================================================
   REVIEW TEXT
   ========================================================= */

.purelane-review-card p {

  margin: 0;

  max-width: 200px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  line-height: 1.45;

  font-weight: 400;

  color: #68736d;

}


/* =========================================================
   AUTHOR
   ========================================================= */

.review-author {

  display: flex;

  align-items: center;

  gap: 4px;

  margin-top: 12px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 6px;

  letter-spacing: .08em;

}


.review-author strong {

  color: #528d29;

  font-weight: 800;

}


.review-author span {

  color: #78817d;

  font-weight: 600;

}


/* =========================================================
   ANIMATION
   ========================================================= */

@keyframes purelaneReviewScroll {

  0% {
    transform:
      translateX(-20px);
  }

  100% {
    transform:
      translateX(-1040px);
  }

}


/* =========================================================
   RIGHT INDICATOR
   ========================================================= */

.purelane-review-indicator {

  position: absolute;

  z-index: 10;

  right: 14px;

  top: 50%;

  transform:
    translateY(-50%);

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 9px;

}


.purelane-review-indicator span {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background:
    #aebfc0;

}


.purelane-review-indicator span.active {

  width: 7px;

  height: 27px;

  border-radius: 999px;

  background:
    #cf7b14;

}


/* =========================================================
   HOVER PAUSE
   ========================================================= */

.purelane-review-window:hover
.purelane-review-track {

  animation-play-state:
    paused;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .purelane-review-card {

    width: 220px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .purelane-reviews {

    min-height: 290px;

    padding:
      18px 0
      28px;

  }

  .purelane-reviews-heading {

    font-size: 6px;

    gap: 5px;

  }

  .purelane-reviews-heading .review-stars {

    font-size: 7px;

  }

  .purelane-review-card {

    width: 210px;

    min-height: 175px;

  }

  .purelane-review-indicator {

    right: 7px;

  }

}

</style>


{% schema %}
{
  "name": "Purelane Reviews",
  "settings": []
}
{% endschema %}