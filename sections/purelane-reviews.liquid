<section class="purelane-reviews">

  <div class="purelane-reviews-inner">

    <!-- HEADING -->
    <div class="purelane-reviews-heading">

      <p class="purelane-reviews-kicker">
        LOVED BY HOMES
      </p>

      <h2>
        REAL PEOPLE.<br>
        <span>REAL RESULTS.</span>
      </h2>

      <p>
        Thousands of homes have switched to a simpler,
        plant-powered way of cleaning.
      </p>

    </div>


    <!-- REVIEW CARDS -->
    <div class="purelane-reviews-grid">

      <!-- REVIEW 1 -->
      <article class="purelane-review-card">

        <div class="purelane-review-stars">
          ★★★★★
        </div>

        <p class="purelane-review-text">
          "It actually works on the kitchen mess without
          leaving that strong chemical smell behind."
        </p>

        <div class="purelane-review-person">
          <div class="purelane-review-avatar">
            A
          </div>

          <div>
            <strong>Ananya</strong>
            <small>Verified customer</small>
          </div>
        </div>

      </article>


      <!-- REVIEW 2 -->
      <article class="purelane-review-card">

        <div class="purelane-review-stars">
          ★★★★★
        </div>

        <p class="purelane-review-text">
          "I love that I can use it around my family.
          The packaging also looks great at home."
        </p>

        <div class="purelane-review-person">
          <div class="purelane-review-avatar">
            R
          </div>

          <div>
            <strong>Rahul</strong>
            <small>Verified customer</small>
          </div>
        </div>

      </article>


      <!-- REVIEW 3 -->
      <article class="purelane-review-card">

        <div class="purelane-review-stars">
          ★★★★★
        </div>

        <p class="purelane-review-text">
          "Simple, effective and doesn't smell like
          traditional cleaning products."
        </p>

        <div class="purelane-review-person">
          <div class="purelane-review-avatar">
            S
          </div>

          <div>
            <strong>Sarah</strong>
            <small>Verified customer</small>
          </div>
        </div>

      </article>

    </div>


    <!-- REVIEW COUNT -->
    <div class="purelane-reviews-bottom">
      <strong>30,000+</strong>
      <span>happy homes and counting</span>
    </div>

  </div>

</section>


<style>

  /* ==============================
     PURELANE REVIEWS
     ============================== */

  .purelane-reviews {
    width: 100%;
    padding: 110px 24px;

    background: #ffffff;
    color: #241a3d;
  }

  .purelane-reviews-inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }


  /* ==============================
     HEADING
     ============================== */

  .purelane-reviews-heading {
    max-width: 760px;
    margin-bottom: 55px;
  }

  .purelane-reviews-kicker {
    margin: 0 0 16px;

    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .24em;
    text-transform: uppercase;

    color: #4b8f32;
  }

  .purelane-reviews-heading h2 {
    margin: 0;

    font-family: Arial, sans-serif;
    font-size: clamp(44px, 7vw, 82px);
    font-weight: 800;
    line-height: .9;
    letter-spacing: -.04em;
    text-transform: uppercase;

    color: #241a3d;
  }

  .purelane-reviews-heading h2 span {
    color: #4b3a8f;
  }

  .purelane-reviews-heading > p:last-child {
    max-width: 570px;
    margin: 25px 0 0;

    font-family: Arial, sans-serif;
    font-size: 17px;
    line-height: 1.65;

    color: #6b6574;
  }


  /* ==============================
     REVIEW GRID
     ============================== */

  .purelane-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }


  /* ==============================
     REVIEW CARD
     ============================== */

  .purelane-review-card {
    min-height: 320px;
    padding: 34px;

    display: flex;
    flex-direction: column;

    background: #f7f5fa;

    border: 1px solid rgba(75, 58, 143, .10);
    border-radius: 24px;

    transition:
      transform .3s ease,
      box-shadow .3s ease;
  }

  .purelane-review-card:hover {
    transform: translateY(-5px);

    box-shadow:
      0 20px 45px rgba(36, 26, 61, .10);
  }


  /* ==============================
     STARS
     ============================== */

  .purelane-review-stars {
    margin-bottom: 25px;

    font-size: 16px;
    letter-spacing: 4px;

    color: #f0a03c;
  }


  /* ==============================
     REVIEW TEXT
     ============================== */

  .purelane-review-text {
    margin: 0;

    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.7;

    color: #514b62;
  }


  /* ==============================
     PERSON
     ============================== */

  .purelane-review-person {
    margin-top: auto;
    padding-top: 30px;

    display: flex;
    align-items: center;
    gap: 12px;
  }

  .purelane-review-avatar {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #4b3a8f;
    color: #ffffff;

    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 800;
  }

  .purelane-review-person div:last-child {
    display: flex;
    flex-direction: column;
  }

  .purelane-review-person strong {
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;

    color: #241a3d;
  }

  .purelane-review-person small {
    margin-top: 3px;

    font-family: Arial, sans-serif;
    font-size: 11px;

    color: #8a8495;
  }


  /* ==============================
     BOTTOM STAT
     ============================== */

  .purelane-reviews-bottom {
    margin-top: 45px;

    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;

    font-family: Arial, sans-serif;
  }

  .purelane-reviews-bottom strong {
    font-size: 28px;
    font-weight: 800;

    color: #4b3a8f;
  }

  .purelane-reviews-bottom span {
    font-size: 14px;

    color: #6b6574;
  }


  /* ==============================
     TABLET
     ============================== */

  @media (max-width: 800px) {

    .purelane-reviews {
      padding: 80px 20px;
    }

    .purelane-reviews-grid {
      grid-template-columns: 1fr;
    }

    .purelane-review-card {
      min-height: 260px;
    }

  }


  /* ==============================
     MOBILE
     ============================== */

  @media (max-width: 500px) {

    .purelane-reviews {
      padding: 65px 16px;
    }

    .purelane-reviews-heading h2 {
      font-size: 48px;
    }

    .purelane-review-card {
      padding: 27px;
    }

  }

</style>


{% schema %}
{
  "name": "Purelane Reviews",
  "settings": []
}
{% endschema %}