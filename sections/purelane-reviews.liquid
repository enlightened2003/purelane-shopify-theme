      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "FROM 8,000+ REVIEWS"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes count",
      "default": "LOVED BY 12 LAKH+ HOMES"
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews"
    }
  ]
}

{% endschema %}