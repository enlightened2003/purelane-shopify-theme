<style>

/* =========================================================
   PURELANE REVIEWS
   ========================================================= */

.purelane-reviews {

  position: relative;

  width: 100%;

  box-sizing: border-box;

  overflow: hidden;

  padding: 46px 0 82px;

  background:

    radial-gradient(
      ellipse at 50% 0%,
      rgba(255,255,255,.38) 0%,
      rgba(255,255,255,0) 48%
    ),

    linear-gradient(
      180deg,
      #dff5e4 0%,
      #cdebd8 48%,
      #b9ddcb 100%
    );

}


/* =========================================================
   WAVY BACKGROUND
   ========================================================= */

.purelane-reviews::before {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .8;

  background:

    repeating-linear-gradient(
      174deg,
      transparent 0px,
      transparent 72px,
      rgba(255,255,255,.22) 75px,
      rgba(255,255,255,.22) 82px,
      transparent 88px,
      transparent 145px
    );

}


.purelane-reviews::after {

  content: "";

  position: absolute;

  left: -10%;

  right: -10%;

  top: 48%;

  height: 150px;

  border-top: 5px solid rgba(255,255,255,.20);

  border-radius: 50%;

  transform: rotate(-2deg);

  pointer-events: none;

}


/* =========================================================
   HEADER
   ========================================================= */

.purelane-reviews-header {

  position: relative;

  z-index: 2;

  width: 100%;

  display: flex;

  justify-content: center;

  margin-bottom: 27px;

}


.purelane-review-heading {

  display: flex;

  align-items: center;

  justify-content: center;

  flex-wrap: wrap;

  gap: 13px;

  text-align: center;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .16em;

  color: #5f6274;

}


.purelane-review-label {

  color: #747587;

}


.purelane-review-stars {

  color: #77a936;

  font-size: 17px;

  letter-spacing: .05em;

}


.purelane-review-rating {

  color: #53566a;

}


.purelane-review-rating strong {

  color: #b96e16;

  font-size: 17px;

  letter-spacing: .04em;

}


.purelane-review-loved {

  color: #55586b;

}


.purelane-review-loved strong {

  color: #b96e16;

  font-size: 16px;

}


/* =========================================================
   CARD WINDOW
   ========================================================= */

.purelane-review-window {

  position: relative;

  z-index: 2;

  width: 100%;

  overflow: hidden;

}


/* =========================================================
   CARD TRACK
   ========================================================= */

.purelane-review-track {

  display: flex;

  gap: 16px;

  width: max-content;

  padding: 0 0 3px;

  transform: translateX(-42px);

}


/* =========================================================
   CARD
   ========================================================= */

.purelane-review-card {

  flex: 0 0 355px;

  min-height: 208px;

  box-sizing: border-box;

  padding: 23px 22px 19px;

  border-radius: 18px;

  border: 1px solid rgba(190,201,205,.68);

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.78),
      rgba(224,239,235,.72)
    );

  box-shadow:

    0 15px 35px rgba(50,75,70,.08);

  backdrop-filter: blur(16px);

  -webkit-backdrop-filter: blur(16px);

}


/* =========================================================
   STARS
   ========================================================= */

.purelane-card-stars {

  color: #79a837;

  font-size: 14px;

  letter-spacing: .08em;

  margin-bottom: 15px;

}


/* =========================================================
   TITLE
   ========================================================= */

.purelane-review-card h3 {

  margin: 0 0 11px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;

  line-height: 1.2;

  font-weight: 900;

  letter-spacing: .01em;

  color: #211a3b;

}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-review-card p {

  margin: 0;

  max-width: 315px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  line-height: 1.5;

  font-weight: 400;

  color: #5f6173;

}


/* =========================================================
   REVIEW USER
   ========================================================= */

.purelane-review-user {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 17px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  line-height: 1;

  letter-spacing: .10em;

  color: #747687;

}


.purelane-review-user strong {

  color: #315f57;

  font-weight: 900;

}


.purelane-check {

  color: #72a735;

  font-size: 15px;

  font-weight: 900;

}


/* =========================================================
   DESKTOP
   ========================================================= */

@media (min-width: 1400px) {

  .purelane-review-card {

    flex-basis: 355px;

  }

  .purelane-review-track {

    transform: translateX(-75px);

  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1000px) {

  .purelane-reviews {

    padding: 40px 0 65px;

  }

  .purelane-review-heading {

    padding: 0 25px;

    font-size: 11px;

    gap: 9px;

  }

  .purelane-review-card {

    flex-basis: 320px;

  }

  .purelane-review-track {

    transform: translateX(-30px);

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 650px) {

  .purelane-reviews {

    padding: 38px 0 55px;

  }

  .purelane-reviews-header {

    padding: 0 20px;

    margin-bottom: 22px;

  }

  .purelane-review-heading {

    font-size: 9px;

    line-height: 1.6;

    gap: 6px;

  }

  .purelane-review-stars {

    font-size: 13px;

  }

  .purelane-review-rating strong {

    font-size: 13px;

  }

  .purelane-review-loved strong {

    font-size: 13px;

  }

  .purelane-review-track {

    gap: 12px;

    transform: translateX(-20px);

  }

  .purelane-review-card {

    flex-basis: 300px;

    min-height: 205px;

    padding: 20px;

    border-radius: 17px;

  }

  .purelane-review-card h3 {

    font-size: 14px;

  }

  .purelane-review-card p {

    font-size: 13px;

  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 400px) {

  .purelane-review-card {

    flex-basis: 285px;

  }

}

</style>


