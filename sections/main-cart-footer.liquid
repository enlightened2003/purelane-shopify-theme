<div class="purelane-cart-footer">

  <div class="purelane-cart-footer__inner">

    <div class="purelane-cart-footer__note">
      <span>PURELANE HOMECARE</span>
      <p>
        Powerful cleaning for everyday life.
        Better for your home and the people in it.
      </p>
    </div>

    <div class="purelane-cart-footer__summary">

      <div class="purelane-cart-footer__subtotal">
        <span>SUBTOTAL</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>

      <p class="purelane-cart-footer__shipping">
        Shipping calculated at checkout.
      </p>

      <form action="{{ routes.cart_url }}" method="post">

        <button
          type="submit"
          name="checkout"
          class="purelane-checkout"
        >
          CHECKOUT
          <span>→</span>
        </button>

      </form>

      <a
        href="{{ routes.all_products_collection_url }}"
        class="purelane-continue"
      >
        CONTINUE SHOPPING
      </a>

    </div>

  </div>

</div>

<style>
  .purelane-cart-footer {
    background: #211b42;
    color: #fff;
    padding: 55px 5vw 70px;
  }

  .purelane-cart-footer__inner {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 80px;
    align-items: center;
  }

  .purelane-cart-footer__note span {
    color: #e6a94f;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .purelane-cart-footer__note p {
    max-width: 480px;
    color: #c4bfd5;
    font-size: 18px;
    line-height: 1.7;
    margin-top: 18px;
  }

  .purelane-cart-footer__summary {
    background: #30294f;
    border: 1px solid #51496f;
    border-radius: 25px;
    padding: 28px;
  }

  .purelane-cart-footer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .purelane-cart-footer__subtotal span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .purelane-cart-footer__subtotal strong {
    font-size: 28px;
    color: #e6a94f;
  }

  .purelane-cart-footer__shipping {
    color: #aaa4bc;
    font-size: 13px;
    margin: 10px 0 22px;
  }

  .purelane-checkout {
    width: 100%;
    border: none;
    background: #e6a94f;
    color: #211b42;
    border-radius: 40px;
    padding: 18px 25px;
    font-weight: 900;
    letter-spacing: 2px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .purelane-checkout span {
    font-size: 20px;
  }

  .purelane-continue {
    display: block;
    text-align: center;
    margin-top: 18px;
    color: #d0cbda;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-decoration: none;
  }

  @media screen and (max-width: 750px) {

    .purelane-cart-footer {
      padding: 45px 20px 55px;
    }

    .purelane-cart-footer__inner {
      grid-template-columns: 1fr;
      gap: 35px;
    }

  }
</style>

{% schema %}
{
  "name": "Purelane Cart Footer",
  "settings": []
}
{% endschema %}