<section class="purelane-hero">
  <div class="purelane-hero__content">
    <p class="purelane-hero__eyebrow">
      PERFORMANCE. PRECISION. PURELANE.
    </p>

    <h1 class="purelane-hero__title">
      TRAIN<br>
      WITHOUT<br>
      LIMITS.
    </h1>

    <p class="purelane-hero__text">
      Premium performance wear engineered for athletes
      who demand more from every session.
    </p>

    <div class="purelane-hero__actions">
      <a href="/collections/all" class="purelane-btn purelane-btn--primary">
        SHOP COLLECTION
      </a>

      <a href="/pages/about" class="purelane-btn purelane-btn--secondary">
        OUR STORY
      </a>
    </div>
  </div>
</section>

<style>
  .purelane-hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    overflow: hidden;

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.88) 0%,
        rgba(0, 0, 0, 0.62) 45%,
        rgba(0, 0, 0, 0.25) 100%
      ),
      url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=2000&q=85')
      center / cover no-repeat;

    color: #ffffff;
  }

  .purelane-hero__content {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 100px 60px;
  }

  .purelane-hero__eyebrow {
    margin: 0 0 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    opacity: 0.8;
  }

  .purelane-hero__title {
    max-width: 700px;
    margin: 0;
    font-size: clamp(56px, 8vw, 120px);
    line-height: 0.88;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .purelane-hero__text {
    max-width: 500px;
    margin: 32px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }

  .purelane-hero__actions {
    display: flex;
    gap: 14px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .purelane-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    transition: all 0.25s ease;
  }

  .purelane-btn--primary {
    background: #ffffff;
    color: #000000;
  }

  .purelane-btn--primary:hover {
    background: #dddddd;
  }

  .purelane-btn--secondary {
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #ffffff;
  }

  .purelane-btn--secondary:hover {
    background: #ffffff;
    color: #000000;
  }

  @media screen and (max-width: 749px) {
    .purelane-hero {
      min-height: 72vh;
      background-position: 65% center;
    }

    .purelane-hero__content {
      padding: 80px 24px;
    }

    .purelane-hero__title {
      font-size: clamp(52px, 15vw, 78px);
    }

    .purelane-hero__text {
      font-size: 15px;
    }

    .purelane-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .purelane-btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}