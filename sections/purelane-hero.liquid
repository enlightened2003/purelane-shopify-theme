          <div class="bottle-label"></div>
        </div>

        <div class="purelane-bottle bottle-center">
          <div class="bottle-cap"></div>
          <div class="bottle-label"></div>
        </div>

        <div class="purelane-bottle bottle-right">
          <div class="bottle-cap"></div>
          <div class="bottle-label"></div>
        </div>

      </div>


      <!-- =================================================
           BENEFIT GLASS PANEL
      ================================================== -->

      <div class="purelane-hero-benefits">

        <div class="purelane-hero-benefit">

          <div class="purelane-benefit-symbol">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M12 20C12 20 6 15.5 6 10C6 6.8 8.3 4 12 4C15.7 4 18 6.8 18 10C18 15.5 12 20 12 20Z"
              />
              <path d="M12 19V10" />
              <path d="M12 13C14 12.2 15.2 10.8 16 9" />
            </svg>
          </div>

          <span>
            PLANT<br>
            POWERED
          </span>

        </div>


        <div class="purelane-hero-benefit">

          <div class="purelane-benefit-symbol">

            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M12 3L19 6.5V11.5C19 16.2 16.2 19.6 12 21C7.8 19.6 5 16.2 5 11.5V6.5L12 3Z"
              />
              <path d="M9 12L11 14L15 10" />
            </svg>

          </div>

          <span>
            SAFE FOR<br>
            KIDS & PETS
          </span>

        </div>


        <div class="purelane-hero-benefit">

          <div class="purelane-benefit-symbol">

            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8"/>
              <path d="M7 17L17 7"/>
            </svg>

          </div>

          <span>
            ZERO HARSH<br>
            CHEMICALS
          </span>

        </div>

      </div>


      <!-- =================================================
           PRICE CARD
      ================================================== -->

      <div class="purelane-price-cards">

        <div
          class="purelane-price-card active"
          data-price="200"
        >
          <small>SINGLE BOTTLE</small>

          <strong>₹200</strong>

          <del>₹299</del>

          <span>33% OFF</span>
        </div>


        <div
          class="purelane-price-card"
          data-price="349"
        >
          <small>ANY 3 PRODUCTS</small>

          <strong>₹349</strong>

          <del>₹597</del>

          <span>SAVE ₹248</span>
        </div>


        <div
          class="purelane-price-card"
          data-price="499"
        >
          <small>ANY 3 PRODUCTS</small>

          <strong>₹499</strong>

          <del>₹897</del>

          <span>SAVE ₹398</span>
        </div>

      </div>


      <!-- =================================================
           SLIDER DOTS
      ================================================== -->

      <div class="purelane-hero-dots">

        <button
          type="button"
          class="active"
          data-slide="0"
          aria-label="Slide 1"
        ></button>

        <button
          type="button"
          data-slide="1"
          aria-label="Slide 2"
