<section class="pl-hero">

  <div class="pl-hero-bg"></div>

  <div class="pl-hero-inner">

    <!-- =====================================================
         LEFT CONTENT
         ===================================================== -->

    <div class="pl-hero-content">
<div class="pl-hero-title">
  <span>{{ section.settings.title_line_1 }}</span>
  <span>{{ section.settings.title_line_2 }}</span>
  <span class="pl-orange">{{ section.settings.title_line_3 }}</span>
</div>

      <div class="pl-hero-divider">
        <span></span>
        <b>⌁</b>
        <span></span>
      </div>

      <p class="pl-hero-description">
  {{ section.settings.description }}
</p>

      <div class="pl-hero-buttons">

        <a
          href="{{ routes.collections_url }}"
          class="pl-btn pl-btn-primary"
        >
          SHOP NOW
          <span>→</span>
        </a>

        <a
          href="#purelane-how-it-works"
          class="pl-btn pl-btn-secondary"
        >
          HOW IT WORKS
        </a>

      </div>

    </div>


    <!-- =====================================================
         RIGHT PRODUCT VISUAL
         ===================================================== -->

    <div class="pl-hero-visual">

      <div class="pl-bottle-stage">

        <!-- ==============================
             SCENE 1 — 3 BOTTLES
             ============================== -->

        <div class="pl-bottle-scene pl-scene-1">

          {% if section.settings.bottle_scene_1 != blank %}

            <img
              src="{{ section.settings.bottle_scene_1 | image_url: width: 1000 }}"
              alt="Purelane products"
              loading="eager"
            >

          {% else %}

            <div class="pl-image-placeholder">
              Add Scene 1 image
            </div>

          {% endif %}

        </div>


        <!-- ==============================
             SCENE 2 — 2 BOTTLES
             ============================== -->

        <div class="pl-bottle-scene pl-scene-2">

          {% if section.settings.bottle_scene_2 != blank %}

            <img
              src="{{ section.settings.bottle_scene_2 | image_url: width: 1000 }}"
              alt="Purelane products"
              loading="lazy"
            >

          {% else %}

            <div class="pl-image-placeholder">
              Add Scene 2 image
            </div>

          {% endif %}

        </div>


        <!-- ==============================
             SCENE 3 — 1 BOTTLE
             ============================== -->

        <div class="pl-bottle-scene pl-scene-3">

          {% if section.settings.bottle_scene_3 != blank %}

            <img
              src="{{ section.settings.bottle_scene_3 | image_url: width: 1000 }}"
              alt="Purelane product"
              loading="lazy"
            >

          {% else %}

            <div class="pl-image-placeholder">
              Add Scene 3 image
            </div>

          {% endif %}

        </div>


        <!-- =================================================
             OUR GLASS INFORMATION CARD
             ================================================= -->

        <div class="pl-info-card">

          <div class="pl-info-item">

            <div class="pl-info-icon">
              <svg viewBox="0 0 24 24">
                <path d="M12 20C8 16.5 6 13.5 7 10c.8-2.8 3.2-4.5 5-6 1.3 2.5 1.5 5.2-.2 7.5"/>
                <path d="M12 20c-.4-3.4.8-6.1 3.8-8.1"/>
              </svg>
            </div>

            <strong>PLANT<br>POWERED</strong>

          </div>


          <div class="pl-info-line"></div>


          <div class="pl-info-item">

            <div class="pl-info-icon">

              <svg viewBox="0 0 24 24">
                <path d="M12 3L19 6.5V11.5C19 16.2 16.2 19.6 12 21C7.8 19.6 5 16.2 5 11.5V6.5L12 3Z"/>
                <path d="M9 12L11 14L15 10"/>
              </svg>

            </div>

            <strong>SAFE FOR<br>KIDS & PETS</strong>

          </div>


          <div class="pl-info-line"></div>


          <div class="pl-info-item">

            <div class="pl-info-icon">

              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8"/>
                <path d="M7 17L17 7"/>
              </svg>

            </div>

            <strong>ZERO HARSH<br>CHEMICALS</strong>

          </div>

        </div>


        <!-- =================================================
             OFFER CARD
             ================================================= -->

        <div class="pl-offer-card">

          <small class="pl-offer-label">
  {{ section.settings.offer_label }}
</small>

<div class="pl-offer-price">
  {{ section.settings.offer_price }}
  <del>{{ section.settings.offer_compare_price }}</del>
</div>

<span class="pl-offer-save">
  {{ section.settings.offer_savings }}
</span>


        <!-- =================================================
             SLIDER DOTS
             ================================================= -->

        <div class="pl-slider-dots">

          <span></span>
          <span></span>
          <span class="active"></span>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* ============================================================
   PURELANE HERO
   ============================================================ */

.pl-hero {
  position: relative;
  width: 100%;
  min-height: 720px;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(
      135deg,
      #f3faf4 0%,
      #e3f6e8 35%,
      #d3efdd 70%,
      #bfe4d1 100%
    );
}


/* ============================================================
   BACKGROUND WAVES
   ============================================================ */

.pl-hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:

    radial-gradient(
      ellipse at 75% 30%,
      rgba(255,255,255,.45) 0%,
      rgba(255,255,255,0) 45%
    ),

    radial-gradient(
      ellipse at 25% 65%,
      rgba(255,255,255,.32) 0%,
      rgba(255,255,255,0) 42%
    ),

    repeating-linear-gradient(
      173deg,
      transparent 0px,
      transparent 80px,
      rgba(255,255,255,.18) 82px,
      rgba(255,255,255,.18) 88px,
      transparent 94px,
      transparent 155px
    );

  opacity: .9;
}


/* extra soft wave */

.pl-hero-bg::after {
  content: "";
  position: absolute;
  left: -10%;
  right: -10%;
  top: 42%;
  height: 180px;

  border-top: 5px solid rgba(255,255,255,.24);
  border-radius: 50%;

  transform: rotate(-2deg);

  box-shadow:
    0 35px 0 rgba(255,255,255,.10),
    0 75px 0 rgba(255,255,255,.08);
}


/* ============================================================
   MAIN CONTAINER
   ============================================================ */

.pl-hero-inner {
  position: relative;
  z-index: 2;

  width: min(1320px, calc(100% - 80px));

  min-height: 720px;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(480px, .95fr)
    minmax(560px, 1.05fr);

  align-items: center;

  gap: 20px;

  box-sizing: border-box;
}


/* ============================================================
   LEFT CONTENT
   ============================================================ */

.pl-hero-content {
  position: relative;
  z-index: 5;

  padding-left: 10px;
}


/* ============================================================
   TITLE
   ============================================================ */

.pl-hero-title {
  display: flex;

  flex-direction: column;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: clamp(78px, 7.2vw, 122px);

  line-height: .88;

  letter-spacing: -.065em;

  font-weight: 900;

  color: #17102f;
}


.pl-hero-title span {
  display: block;
}


.pl-hero-title .pl-orange {
  color: #c37817;
}


/* ============================================================
   DIVIDER
   ============================================================ */

.pl-hero-divider {
  width: 390px;

  max-width: 100%;

  display: flex;

  align-items: center;

  gap: 22px;

  margin-top: 30px;

  margin-bottom: 27px;
}


.pl-hero-divider span {
  height: 1px;

  flex: 1;

  background: rgba(110,126,140,.35);
}


.pl-hero-divider b {
  color: #c37817;

  font-size: 24px;

  font-weight: 400;

  transform: rotate(180deg);
}


/* ============================================================
   DESCRIPTION
   ============================================================ */

.pl-hero-description {
  max-width: 610px;

  margin: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 20px;

  line-height: 1.65;

  color: #55586f;

  font-weight: 400;
}


/* ============================================================
   BUTTONS
   ============================================================ */

.pl-hero-buttons {
  display: flex;

  align-items: center;

  gap: 14px;

  margin-top: 30px;
}


.pl-btn {
  min-height: 56px;

  padding: 0 28px;

  border-radius: 999px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 14px;

  text-decoration: none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  font-weight: 800;

  letter-spacing: .12em;

  box-sizing: border-box;

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}


.pl-btn:hover {
  transform: translateY(-2px);
}


.pl-btn-primary {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      #168d83,
      #00675f
    );

  box-shadow:
    0 12px 28px rgba(0,100,90,.18);
}


.pl-btn-primary span {
  font-size: 22px;

  line-height: 1;
}


.pl-btn-secondary {
  color: #075d59;

  background: rgba(255,255,255,.65);

  border: 1px solid rgba(110,96,160,.25);
}


/* ============================================================
   RIGHT VISUAL
   ============================================================ */

.pl-hero-visual {
  position: relative;

  height: 650px;

  display: flex;

  align-items: center;

  justify-content: center;
}


.pl-bottle-stage {
  position: relative;

  width: 100%;

  height: 100%;

  max-width: 700px;
}


/* ============================================================
   BOTTLE SCENES
   ============================================================ */

.pl-bottle-scene {
  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  pointer-events: none;

  opacity: 0;

  transition:
    opacity .7s ease,
    transform .7s ease;

  transform: scale(.97);
}


.pl-bottle-scene img {
  position: absolute;

  width: 760px;

  max-width: none;

  height: auto;

  object-fit: contain;

  left: 50%;

  top: 50%;

  transform: translate(-50%, -50%);
}


/*
   IMPORTANT:
   The uploaded screenshots already contain the old
   information card.

   We crop the image before that card begins.
*/


/* 3 bottles */

.pl-scene-1 {
  clip-path: inset(0 24% 0 0);
}


.pl-scene-1 img {
  width: 760px;
}


/* 2 bottles */

.pl-scene-2 {
  clip-path: inset(0 27% 0 0);
}


.pl-scene-2 img {
  width: 760px;
}


/* 1 bottle */

.pl-scene-3 {
  clip-path: inset(0 30% 0 0);
}


.pl-scene-3 img {
  width: 760px;
}


/* ============================================================
   AUTOMATIC SLIDE
   ============================================================ */

.pl-scene-1 {
  opacity: 1;

  transform: scale(1);

  animation:
    plSceneOne 12s infinite;
}


.pl-scene-2 {
  animation:
    plSceneTwo 12s infinite;
}


.pl-scene-3 {
  animation:
    plSceneThree 12s infinite;
}


@keyframes plSceneOne {

  0%,
  27% {
    opacity: 1;
    transform: scale(1);
  }

  33%,
  94% {
    opacity: 0;
    transform: scale(.97);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }

}


@keyframes plSceneTwo {

  0%,
  27% {
    opacity: 0;
    transform: scale(.97);
  }

  33%,
  60% {
    opacity: 1;
    transform: scale(1);
  }

  67%,
  100% {
    opacity: 0;
    transform: scale(.97);
  }

}


@keyframes plSceneThree {

  0%,
  60% {
    opacity: 0;
    transform: scale(.97);
  }

  67%,
  94% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(.97);
  }

}


/* ============================================================
   GLASS INFORMATION CARD
   ============================================================ */

.pl-info-card {
  position: absolute;

  z-index: 10;

  width: 125px;

  height: 365px;

  right: 88px;

  top: 50%;

  transform: translateY(-50%);

  padding: 18px 13px;

  box-sizing: border-box;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  border-radius: 25px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.72),
      rgba(221,237,235,.62)
    );

  border: 1px solid rgba(255,255,255,.85);

  box-shadow:
    0 18px 45px rgba(55,70,90,.12);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);
}


.pl-info-item {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  gap: 9px;
}


.pl-info-icon {
  width: 47px;

  height: 47px;

  border-radius: 50%;

  display: grid;

  place-items: center;

  background:
    rgba(255,255,255,.72);

  border: 1px solid rgba(200,208,210,.65);
}


.pl-info-icon svg {
  width: 22px;

  height: 22px;

  stroke: #6d9f3c;

  stroke-width: 1.7;

  stroke-linecap: round;

  stroke-linejoin: round;

  fill: none;
}


.pl-info-item strong {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 10px;

  line-height: 1.25;

  letter-spacing: .12em;

  color: #403b58;

  font-weight: 800;
}


.pl-info-line {
  width: 100%;

  height: 1px;

  background:
    rgba(100,120,125,.18);
}


/* ============================================================
   OFFER CARD
   ============================================================ */

.pl-offer-card {
  position: absolute;

  z-index: 15;

  left: 48px;

  bottom: 55px;

  width: 145px;

  min-height: 105px;

  padding: 14px 16px;

  box-sizing: border-box;

  border-radius: 18px;

  background:
    rgba(255,255,255,.74);

  border: 1px solid rgba(255,255,255,.85);

  box-shadow:
    0 16px 35px rgba(50,75,70,.10);

  backdrop-filter: blur(15px);

  -webkit-backdrop-filter: blur(15px);
}


.pl-offer-label {
  display: block;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 9px;

  letter-spacing: .16em;

  font-weight: 800;

  color: #c37817;

  margin-bottom: 4px;
}


.pl-offer-price {
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 27px;

  line-height: 1;

  font-weight: 900;

  color: #1c1532;
}


.pl-offer-price del {
  margin-left: 6px;

  font-size: 11px;

  font-weight: 500;

  color: #747586;
}


.pl-offer-save {
  display: inline-flex;

  margin-top: 8px;

  padding: 5px 9px;

  border-radius: 999px;

  background: rgba(196,188,100,.18);

  border: 1px solid rgba(179,151,51,.35);

  color: #65932f;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .12em;
}


/* ============================================================
   SLIDER DOTS
   ============================================================ */

.pl-slider-dots {
  position: absolute;

  z-index: 20;

  bottom: 26px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  align-items: center;

  gap: 8px;
}


.pl-slider-dots span {
  display: block;

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: #aabfc3;
}


.pl-slider-dots span.active {
  width: 23px;

  border-radius: 999px;

  background: #c37817;
}


/* ============================================================
   PLACEHOLDER
   ============================================================ */

.pl-image-placeholder {
  width: 300px;

  height: 400px;

  display: grid;

  place-items: center;

  border: 2px dashed rgba(50,80,70,.25);

  border-radius: 20px;

  color: #687477;

  font-family: Arial, sans-serif;
}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 1100px) {

  .pl-hero {
    min-height: 680px;
  }

  .pl-hero-inner {
    width: calc(100% - 50px);

    grid-template-columns:
      minmax(420px, .9fr)
      minmax(450px, 1.1fr);

    gap: 0;
  }

  .pl-hero-title {
    font-size: 82px;
  }

  .pl-hero-description {
    font-size: 18px;

    max-width: 480px;
  }

  .pl-hero-visual {
    height: 590px;
  }

  .pl-info-card {
    right: 55px;
  }

  .pl-offer-card {
    left: 25px;
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 750px) {

  .pl-hero {
    min-height: auto;

    padding-bottom: 40px;
  }

  .pl-hero-inner {
    width: calc(100% - 30px);

    min-height: auto;

    display: flex;

    flex-direction: column;

    gap: 10px;

    padding-top: 40px;
  }

  .pl-hero-content {
    width: 100%;

    padding-left: 0;
  }

  .pl-hero-title {
    font-size: clamp(58px, 17vw, 88px);
  }

  .pl-hero-divider {
    margin-top: 22px;

    margin-bottom: 20px;
  }

  .pl-hero-description {
    font-size: 16px;

    line-height: 1.55;
  }

  .pl-hero-buttons {
    flex-wrap: wrap;

    margin-top: 22px;
  }

  .pl-btn {
    min-height: 50px;

    padding: 0 22px;

    font-size: 12px;
  }

  .pl-hero-visual {
    width: 100%;

    height: 520px;

    margin-top: 10px;
  }

  .pl-bottle-scene img {
    width: 650px;
  }

  .pl-info-card {
    width: 110px;

    height: 330px;

    right: 25px;

    border-radius: 22px;
  }

  .pl-info-item strong {
    font-size: 8px;
  }

  .pl-info-icon {
    width: 42px;

    height: 42px;
  }

  .pl-offer-card {
    left: 10px;

    bottom: 50px;

    width: 130px;
  }

}


/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media (max-width: 480px) {

  .pl-hero-inner {
    width: calc(100% - 22px);
  }

  .pl-hero-title {
    font-size: 61px;
  }

  .pl-hero-visual {
    height: 430px;
  }

  .pl-bottle-scene img {
    width: 570px;
  }

  .pl-info-card {
    width: 96px;

    height: 285px;

    right: 8px;
  }

  .pl-info-icon {
    width: 36px;

    height: 36px;
  }

  .pl-info-icon svg {
    width: 18px;

    height: 18px;
  }

  .pl-info-item strong {
    font-size: 7px;
  }

  .pl-offer-card {
    transform: scale(.85);

    transform-origin: bottom left;
  }

}


/* ============================================================
   REDUCE MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .pl-bottle-scene {
    animation: none !important;
  }

  .pl-scene-1 {
    opacity: 1 !important;
  }

  .pl-scene-2,
  .pl-scene-3 {
    opacity: 0 !important;
  }

}

</style>


{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title line 1",
      "default": "CLEAN"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "default": "THAT"
    },
    {
      "type": "text",
      "id": "title_line_3",
      "label": "Title line 3",
      "default": "LASTS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "image_picker",
      "id": "bottle_scene_1",
      "label": "Bottle Scene 1 - Three Bottles"
    },
    {
      "type": "image_picker",
      "id": "bottle_scene_2",
      "label": "Bottle Scene 2 - Two Bottles"
    },
    {
      "type": "image_picker",
      "id": "bottle_scene_3",
      "label": "Bottle Scene 3 - One Bottle"
    },
    {
      "type": "text",
      "id": "offer_label",
      "label": "Offer label",
      "default": "ANY 3 PRODUCTS"
    },
    {
      "type": "text",
      "id": "offer_price",
      "label": "Offer price",
      "default": "₹499"
    },
    {
      "type": "text",
      "id": "offer_compare_price",
      "label": "Offer compare price",
      "default": "₹897"
    },
    {
      "type": "text",
      "id": "offer_savings",
      "label": "Offer savings",
      "default": "SAVE ₹398"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}