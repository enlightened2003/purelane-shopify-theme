<section class="purelane-hero">

  <div class="purelane-hero-content">

    <div class="purelane-hero-text">

      <p class="purelane-hero-eyebrow">
        PURELANE HOMECARE
      </p>

      <h1>
        CLEAN<br>
        THAT<br>
        <span>LASTS</span>
      </h1>

      <p class="purelane-hero-description">
        Homecare that works on the toughest grime, made from plants.
        Kind to your home, your family and the world outside it.
      </p>

      <div class="purelane-hero-buttons">

        <a href="#shop" class="purelane-hero-button primary">
          SHOP NOW
          <span>→</span>
        </a>

        <a href="#how-it-works" class="purelane-hero-button secondary">
          HOW IT WORKS
        </a>

      </div>

    </div>


    <div class="purelane-hero-product">

      <div class="purelane-bottle bottle-one">
        <div class="bottle-cap"></div>
        <div class="bottle-body"></div>
      </div>

      <div class="purelane-bottle bottle-two">
        <div class="bottle-cap"></div>
        <div class="bottle-body"></div>
      </div>

      <div class="purelane-badge">

        <div>
          <strong>PLANT</strong>
          <span>POWERED</span>
        </div>

        <div>
          <strong>SAFE</strong>
          <span>FOR KIDS & PETS</span>
        </div>

        <div>
          <strong>ZERO</strong>
          <span>HARSH CHEMICALS</span>
        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================
     HERO
  ========================= */

  .purelane-hero {
    position: relative;
    min-height: 720px;
    overflow: hidden;

    background:
      linear-gradient(
        120deg,
        #102c45 0%,
        #263a72 45%,
        #51409a 100%
      );

    color: white;
  }


  /* subtle background texture */

  .purelane-hero::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      repeating-linear-gradient(
        175deg,
        transparent 0px,
        transparent 70px,
        rgba(255,255,255,.07) 72px,
        transparent 75px
      );

    opacity: .7;

    pointer-events: none;
  }


  /* =========================
     CONTENT
  ========================= */

  .purelane-hero-content {

    position: relative;
    z-index: 2;

    max-width: 1180px;

    min-height: 720px;

    margin: 0 auto;

    padding: 120px 40px 70px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 60px;
  }


  /* =========================
     TEXT
  ========================= */

  .purelane-hero-text {
    max-width: 600px;
  }


  .purelane-hero-eyebrow {

    margin-bottom: 20px;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: .22em;

    color: #f0a03c;
  }


  .purelane-hero h1 {

    margin: 0;

    font-family: Arial, sans-serif;

    font-size: clamp(64px, 8vw, 110px);

    font-weight: 800;

    line-height: .86;

    letter-spacing: -.045em;

    color: #ffffff;
  }


  .purelane-hero h1 span {

    color: #f0a03c;
  }


  .purelane-hero-description {

    max-width: 520px;

    margin-top: 35px;

    font-size: 18px;

    line-height: 1.65;

    color: rgba(255,255,255,.78);
  }


  /* =========================
     BUTTONS
  ========================= */

  .purelane-hero-buttons {

    display: flex;

    align-items: center;

    gap: 14px;

    margin-top: 32px;
  }


  .purelane-hero-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    min-height: 52px;

    padding: 0 26px;

    border-radius: 999px;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: .12em;

    text-decoration: none;

    transition: .25s ease;
  }


  .purelane-hero-button.primary {

    background: #007c72;

    color: white;

    box-shadow: 0 12px 30px rgba(0,0,0,.25);
  }


  .purelane-hero-button.primary:hover {

    transform: translateY(-2px);

    background: #00988b;
  }


  .purelane-hero-button.secondary {

    background: rgba(255,255,255,.12);

    border: 1px solid rgba(255,255,255,.45);

    color: white;

    backdrop-filter: blur(10px);
  }


  .purelane-hero-button.secondary:hover {

    background: rgba(255,255,255,.2);

    transform: translateY(-2px);
  }


  /* =========================
     PRODUCT AREA
  ========================= */

  .purelane-hero-product {

    position: relative;

    width: 480px;

    height: 500px;

    flex-shrink: 0;
  }


  /* =========================
     BOTTLES
  ========================= */

  .purelane-bottle {

    position: absolute;

    bottom: 30px;

    width: 150px;

    height: 330px;
  }


  .bottle-one {

    right: 180px;

    transform: rotate(-3deg);
  }


  .bottle-two {

    right: 40px;

    height: 390px;

    transform: rotate(4deg);
  }


  .bottle-cap {

    width: 58px;

    height: 55px;

    margin: 0 auto;

    border-radius: 10px 10px 4px 4px;

    background: #7658bd;

    box-shadow: inset 0 5px 10px rgba(255,255,255,.18);
  }


  .bottle-body {

    width: 100%;

    height: calc(100% - 45px);

    margin-top: -5px;

    border-radius: 18px 18px 28px 28px;

    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.28),
        rgba(105,78,176,.7)
      );

    border: 1px solid rgba(255,255,255,.25);

    box-shadow:
      0 25px 50px rgba(0,0,0,.25),
      inset 8px 0 20px rgba(255,255,255,.12);
  }


  /* =========================
     BADGES
  ========================= */

  .purelane-badge {

    position: absolute;

    right: -10px;

    top: 80px;

    width: 150px;

    padding: 12px;

    border-radius: 25px;

    background: rgba(75,58,143,.65);

    border: 1px solid rgba(255,255,255,.22);

    backdrop-filter: blur(14px);
  }


  .purelane-badge > div {

    width: 100px;

    height: 100px;

    margin: 0 auto 8px;

    border-radius: 50%;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    background: rgba(255,255,255,.92);

    color: #514b62;
  }


  .purelane-badge > div:last-child {

    margin-bottom: 0;
  }


  .purelane-badge strong {

    font-size: 11px;

    letter-spacing: .08em;
  }


  .purelane-badge span {

    margin-top: 4px;

    font-size: 8px;

    letter-spacing: .08em;
  }


  /* =========================
     TABLET
  ========================= */

  @media (max-width: 900px) {

    .purelane-hero-content {

      padding: 100px 30px 60px;

      gap: 20px;
    }


    .purelane-hero-product {

      width: 380px;

      transform: scale(.85);

      transform-origin: center right;
    }


    .purelane-hero h1 {

      font-size: clamp(58px, 9vw, 90px);
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .purelane-hero {

      min-height: auto;
    }


    .purelane-hero-content {

      min-height: auto;

      padding: 80px 22px 50px;

      flex-direction: column;

      align-items: flex-start;
    }


    .purelane-hero h1 {

      font-size: clamp(58px, 18vw, 82px);
    }


    .purelane-hero-description {

      font-size: 16px;
    }


    .purelane-hero-buttons {

      flex-wrap: wrap;
    }


    .purelane-hero-product {

      width: 100%;

      height: 420px;

      transform: scale(.8);

      transform-origin: top center;

      margin-top: 10px;
    }

  }

</style>


{% schema %}
{
  "name": "Purelane Hero",
  "settings": []
}
{% endschema %}