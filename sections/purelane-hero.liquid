<section class="purelane-hero">

  <!-- WATER BACKGROUND -->
  <div class="purelane-water">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="none">
      <path d="M-100 170 C180 70 330 260 600 145 C850 35 1050 210 1320 120 C1450 75 1550 120 1700 80"
            fill="none"
            stroke="rgba(255,255,255,.18)"
            stroke-width="7"/>

      <path d="M-100 260 C180 150 350 340 650 235 C920 140 1080 310 1370 220 C1500 180 1580 220 1700 190"
            fill="none"
            stroke="rgba(255,255,255,.12)"
            stroke-width="4"/>

      <path d="M-100 390 C180 300 400 470 650 360 C900 250 1120 430 1400 340 C1530 300 1600 350 1700 320"
            fill="none"
            stroke="rgba(255,255,255,.16)"
            stroke-width="6"/>

      <path d="M-100 530 C160 430 380 610 650 500 C900 390 1120 570 1400 470 C1530 430 1600 480 1700 450"
            fill="none"
            stroke="rgba(255,255,255,.10)"
            stroke-width="4"/>

      <path d="M-100 690 C170 580 390 760 670 650 C930 550 1120 730 1410 620 C1540 580 1620 630 1700 600"
            fill="none"
            stroke="rgba(255,255,255,.13)"
            stroke-width="5"/>

      <path d="M-100 820 C180 720 400 890 680 780 C920 690 1160 850 1420 750 C1540 710 1620 760 1700 730"
            fill="none"
            stroke="rgba(255,255,255,.08)"
            stroke-width="4"/>
    </svg>
  </div>


  <!-- HERO CONTENT -->
  <div class="purelane-hero-inner">

    <!-- LEFT SIDE -->
    <div class="purelane-hero-copy">

      <div class="purelane-hero-kicker">
        PURELANE HOMECARE
      </div>

      <h1>
        CLEAN<br>
        THAT<br>
        <span>LASTS</span>
      </h1>

      <div class="purelane-hero-divider">
        <span></span>
      </div>

      <p class="purelane-hero-description">
        Homecare that works on the toughest grime, made from plants.
        Kind to your home, your family and the world outside it.
      </p>

      <div class="purelane-hero-actions">

        <a href="#shop" class="purelane-hero-primary">
          SHOP NOW
          <span>→</span>
        </a>

        <a href="#how-it-works" class="purelane-hero-secondary">
          HOW IT WORKS
        </a>

      </div>

    </div>


    <!-- RIGHT SIDE -->
    <div class="purelane-product-area">

      <!-- BACK BOTTLE -->
      <div class="purelane-bottle bottle-back">

        <div class="bottle-neck"></div>

        <div class="bottle-main">

          <div class="bottle-label">
            <strong>PURELANE</strong>
            <small>HOMECARE</small>
          </div>

        </div>

      </div>


      <!-- FRONT BOTTLE -->
      <div class="purelane-bottle bottle-front">

        <div class="bottle-neck"></div>

        <div class="bottle-main">

          <div class="bottle-label">
            <strong>PURELANE</strong>
            <small>CLEANER</small>
          </div>

        </div>

      </div>


      <!-- PRICE CARD -->
      <div class="purelane-price-card">

        <small>SINGLE BOTTLE</small>

        <div class="price">
          ₹200
          <del>₹299</del>
        </div>

        <span>33% OFF</span>

      </div>


      <!-- BENEFIT BADGES -->
      <div class="purelane-benefits">

        <div class="purelane-benefit">

          <div class="benefit-icon">♢</div>

          <strong>PLANT</strong>
          <span>POWERED</span>

        </div>


        <div class="purelane-benefit">

          <div class="benefit-icon">✓</div>

          <strong>SAFE</strong>
          <span>FOR KIDS & PETS</span>

        </div>


        <div class="purelane-benefit">

          <div class="benefit-icon">⊘</div>

          <strong>ZERO</strong>
          <span>HARSH CHEMICALS</span>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================================
     HERO
  ========================================= */

  .purelane-hero {
    position: relative;
    min-height: 760px;
    overflow: hidden;

    background:
      linear-gradient(
        115deg,
        #102b45 0%,
        #1c3962 35%,
        #3d3784 70%,
        #57449c 100%
      );

    color: #ffffff;
  }


  /* =========================================
     WATER
  ========================================= */

  .purelane-water {
    position: absolute;
    inset: 0;

    overflow: hidden;

    opacity: .95;

    pointer-events: none;
  }

  .purelane-water svg {
    width: 100%;
    height: 100%;

    animation: purelane-water-move 14s ease-in-out infinite alternate;
  }

  @keyframes purelane-water-move {

    from {
      transform: translateX(-2%) scale(1.02);
    }

    to {
      transform: translateX(2%) scale(1.05);
    }

  }


  /* subtle light */

  .purelane-hero::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at 72% 42%,
        rgba(255,255,255,.12),
        transparent 35%
      ),

      linear-gradient(
        180deg,
        rgba(255,255,255,.06),
        transparent 25%,
        rgba(0,0,0,.18)
      );

    pointer-events: none;
  }


  /* =========================================
     INNER
  ========================================= */

  .purelane-hero-inner {

    position: relative;
    z-index: 2;

    max-width: 1180px;

    min-height: 760px;

    margin: 0 auto;

    padding: 110px 30px 70px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 50px;
  }


  /* =========================================
     LEFT COPY
  ========================================= */

  .purelane-hero-copy {
    width: 54%;
    max-width: 620px;
  }


  .purelane-hero-kicker {

    margin-bottom: 20px;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: .28em;

    color: #f0a03c;
  }


  .purelane-hero h1 {

    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    font-size: clamp(70px, 8vw, 112px);

    font-weight: 900;

    line-height: .84;

    letter-spacing: -.055em;

    color: #ffffff;
  }


  .purelane-hero h1 span {
    color: #f0a03c;
  }


  /* =========================================
     DIVIDER
  ========================================= */

  .purelane-hero-divider {

    display: flex;

    align-items: center;

    gap: 12px;

    margin: 30px 0;
  }


  .purelane-hero-divider::before {

    content: "";

    width: 360px;
    max-width: 70%;

    height: 1px;

    background: rgba(255,255,255,.45);
  }


  .purelane-hero-divider span {

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #f0a03c;
  }


  /* =========================================
     DESCRIPTION
  ========================================= */

  .purelane-hero-description {

    max-width: 520px;

    margin: 0;

    font-size: 17px;

    line-height: 1.7;

    font-weight: 500;

    color: rgba(255,255,255,.78);
  }


  /* =========================================
     BUTTONS
  ========================================= */

  .purelane-hero-actions {

    display: flex;

    align-items: center;

    gap: 14px;

    margin-top: 30px;
  }


  .purelane-hero-primary,
  .purelane-hero-secondary {

    min-height: 54px;

    padding: 0 28px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    border-radius: 999px;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: .14em;

    text-decoration: none;

    transition: .25s ease;
  }


  .purelane-hero-primary {

    background: #007c72;

    color: #ffffff;

    box-shadow:
      0 14px 30px rgba(0,0,0,.25);
  }


  .purelane-hero-primary:hover {

    background: #00968a;

    transform: translateY(-2px);
  }


  .purelane-hero-secondary {

    border: 1px solid rgba(255,255,255,.5);

    background: rgba(255,255,255,.10);

    color: #ffffff;

    backdrop-filter: blur(10px);
  }


  .purelane-hero-secondary:hover {

    background: rgba(255,255,255,.18);

    transform: translateY(-2px);
  }


  /* =========================================
     PRODUCT AREA
  ========================================= */

  .purelane-product-area {

    position: relative;

    width: 470px;

    height: 570px;

    flex-shrink: 0;
  }


  /* =========================================
     BOTTLES
  ========================================= */

  .purelane-bottle {

    position: absolute;

    bottom: 0;

    filter: drop-shadow(
      0 30px 35px rgba(0,0,0,.28)
    );
  }


  .bottle-back {

    right: 180px;

    width: 155px;

    height: 390px;

    opacity: .75;

    transform: rotate(-3deg);
  }


  .bottle-front {

    right: 55px;

    width: 175px;

    height: 450px;

    transform: rotate(3deg);

    z-index: 2;
  }


  .bottle-neck {

    width: 65px;

    height: 62px;

    margin: 0 auto;

    border-radius: 10px 10px 5px 5px;

    background:
      linear-gradient(
        90deg,
        #6549a8,
        #8769ca,
        #5c439c
      );

    border: 1px solid rgba(255,255,255,.2);
  }


  .bottle-main {

    width: 100%;

    height: calc(100% - 55px);

    margin-top: -3px;

    border-radius: 20px 20px 28px 28px;

    background:
      linear-gradient(
        120deg,
        rgba(255,255,255,.25),
        rgba(104,76,177,.85) 50%,
        rgba(64,45,125,.9)
      );

    border: 1px solid rgba(255,255,255,.25);

    box-shadow:
      inset 12px 0 30px rgba(255,255,255,.12),
      inset -10px 0 25px rgba(0,0,0,.16);
  }


  .bottle-label {

    position: absolute;

    left: 16%;

    right: 16%;

    top: 35%;

    min-height: 110px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    border-radius: 8px;

    background: rgba(248,247,252,.92);

    color: #514b62;
  }


  .bottle-label strong {

    font-size: 15px;

    letter-spacing: .12em;
  }


  .bottle-label small {

    margin-top: 6px;

    font-size: 8px;

    letter-spacing: .18em;
  }


  /* =========================================
     PRICE CARD
  ========================================= */

  .purelane-price-card {

    position: absolute;

    left: 20px;

    bottom: 55px;

    z-index: 4;

    width: 150px;

    padding: 15px 18px;

    border-radius: 18px;

    background: rgba(75,58,143,.65);

    border: 1px solid rgba(255,255,255,.22);

    backdrop-filter: blur(16px);

    box-shadow:
      0 15px 35px rgba(0,0,0,.2);
  }


  .purelane-price-card small {

    display: block;

    margin-bottom: 7px;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: .16em;

    color: #f0a03c;
  }


  .purelane-price-card .price {

    font-size: 25px;

    font-weight: 800;
  }


  .purelane-price-card del {

    margin-left: 5px;

    font-size: 12px;

    font-weight: 500;

    opacity: .55;
  }


  .purelane-price-card > span {

    display: inline-block;

    margin-top: 7px;

    padding: 4px 8px;

    border-radius: 999px;

    background: rgba(240,160,60,.18);

    color: #f0a03c;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: .08em;
  }


  /* =========================================
     BENEFITS
  ========================================= */

  .purelane-benefits {

    position: absolute;

    top: 70px;

    right: -5px;

    z-index: 5;

    width: 128px;

    padding: 10px;

    border-radius: 24px;

    background: rgba(75,58,143,.55);

    border: 1px solid rgba(255,255,255,.22);

    backdrop-filter: blur(15px);
  }


  .purelane-benefit {

    width: 92px;

    height: 92px;

    margin: 0 auto 8px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    border-radius: 50%;

    background: rgba(249,248,253,.95);

    color: #514b62;
  }


  .purelane-benefit:last-child {
    margin-bottom: 0;
  }


  .benefit-icon {

    margin-bottom: 5px;

    font-size: 18px;

    color: #f0a03c;

    line-height: 1;
  }


  .purelane-benefit strong {

    font-size: 9px;

    letter-spacing: .1em;
  }


  .purelane-benefit span {

    margin-top: 4px;

    font-size: 6px;

    letter-spacing: .1em;

    color: #817b8f;
  }


  /* =========================================
     TABLET
  ========================================= */

  @media (max-width: 950px) {

    .purelane-hero-inner {

      padding-left: 24px;
      padding-right: 24px;

      gap: 15px;
    }


    .purelane-hero-copy {

      width: 52%;
    }


    .purelane-product-area {

      transform: scale(.82);

      transform-origin: center right;

      margin-left: -50px;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media (max-width: 700px) {

    .purelane-hero {

      min-height: auto;
    }


    .purelane-hero-inner {

      min-height: auto;

      padding: 80px 22px 60px;

      flex-direction: column;

      align-items: flex-start;
    }


    .purelane-hero-copy {

      width: 100%;
    }


    .purelane-hero h1 {

      font-size: clamp(62px, 18vw, 88px);
    }


    .purelane-hero-description {

      font-size: 15px;
    }


    .purelane-hero-actions {

      flex-wrap: wrap;
    }


    .purelane-product-area {

      width: 100%;

      height: 470px;

      margin: 20px 0 0;

      transform: scale(.78);

      transform-origin: top center;
    }

  }

</style>


{% schema %}
{
  "name": "Purelane Hero",
  "settings": []
}
{% endschema %}