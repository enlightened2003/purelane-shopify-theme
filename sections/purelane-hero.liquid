      <h1 class="purelane-hero-title">
        <span>CLEAN</span>
        <span>THAT</span>
        <span class="purelane-orange">LASTS</span>
      </h1>


      <div class="purelane-hero-divider">
        <span></span>
        <b>⌄</b>
        <span></span>
      </div>


      <p class="purelane-hero-description">
        Homecare that works on the toughest grime, made from
        plants. Kind to your home, your family and the world
        outside it.
      </p>


      <div class="purelane-hero-buttons">

        <a
          href="#shop"
          class="purelane-hero-button purelane-hero-button-primary"
        >
          SHOP NOW
          <span>→</span>
        </a>

        <a
          href="#how-it-works"
          class="purelane-hero-button purelane-hero-button-secondary"
