        <button
          type="button"
          data-slide="2"
          aria-label="Slide 3"
        ></button>

      </div>

    </div>

  </div>

</section>



<style>

/* =========================================================
   PURELANE HERO
   ========================================================= */

.purelane-hero {
  position: relative;

  width: 100%;

  min-height: 650px;

  overflow: hidden;

  box-sizing: border-box;

  background:
    radial-gradient(
      ellipse at 70% 35%,
      rgba(255,255,255,.35),
      transparent 48%
    ),
    linear-gradient(
      135deg,
      #f7fcf9 0%,
      #e9f8ee 35%,
      #d7f2df 70%,
      #c4e9d1 100%
    );

}


/* =========================================================
   WATER / WAVE TEXTURE
   ========================================================= */

.purelane-hero::before {
  content: "";

  position: absolute;

  left: -10%;

  top: 30%;

  width: 120%;

  height: 260px;

  pointer-events: none;

  opacity: .40;

  background:
    radial-gradient(
      ellipse at 20% 45%,
      transparent 0 48%,
      rgba(255,255,255,.55) 49%,
      transparent 51%
    ),
    radial-gradient(
      ellipse at 70% 65%,
      transparent 0 47%,
      rgba(255,255,255,.38) 48%,
      transparent 50%
    );

  transform: rotate(-2deg);
}


.purelane-hero::after {
  content: "";

  position: absolute;

  left: -5%;

  bottom: 5%;

  width: 110%;

  height: 180px;

  pointer-events: none;

  opacity: .30;

  border-top: 7px solid rgba(255,255,255,.55);

  border-radius: 50%;

  transform: rotate(1deg);
}


/* =========================================================
   INNER
   ========================================================= */

.purelane-hero-inner {
  position: relative;

  z-index: 2;

  width: min(1440px, calc(100% - 80px));

  min-height: 650px;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(430px, .92fr)
    minmax(550px, 1.08fr);

  align-items: center;

  box-sizing: border-box;
}


/* =========================================================
   LEFT CONTENT
   ========================================================= */

.purelane-hero-content {
  position: relative;

  z-index: 5;

  padding-left: 45px;

  padding-top: 45px;
}


.purelane-hero-title {
  margin: 0;

  display: flex;

  flex-direction: column;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    clamp(76px, 7vw, 112px);

  line-height: .87;

  font-weight: 900;

  letter-spacing: -.065em;

  color: #160d2e;
}


.purelane-hero-title span {
  display: block;
}


.purelane-orange {
  color: #bd7117;
}


/* =========================================================
   DIVIDER
   ========================================================= */

.purelane-hero-divider {
  width: 315px;

  margin-top: 27px;

  display: flex;

  align-items: center;

  gap: 18px;
}


.purelane-hero-divider span {
  flex: 1;

  height: 1px;

  background: rgba(112,126,151,.45);
}


.purelane-hero-divider b {
  color: #c57816;

  font-family: Arial, sans-serif;

  font-size: 23px;

  line-height: 1;

  transform: rotate(180deg);
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.purelane-hero-description {
  width: 570px;

  max-width: 100%;

  margin: 25px 0 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 20px;

  line-height: 1.55;

  color: #565b70;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.purelane-hero-buttons {
  margin-top: 28px;

  display: flex;

  align-items: center;

  gap: 13px;
}


.purelane-hero-button {
  min-height: 49px;

  padding: 0 25px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 13px;

  border-radius: 999px;

  box-sizing: border-box;

  text-decoration: none;

  font-family: Arial, sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .14em;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}


.purelane-hero-button-primary {
  color: #ffffff;

  background: #087d78;

  box-shadow:
    0 10px 22px rgba(0,100,95,.16);
}


.purelane-hero-button-primary span {
  font-size: 19px;

  line-height: 1;
}


.purelane-hero-button-secondary {
  color: #075d59;

  background: rgba(255,255,255,.60);

  border: 1px solid rgba(94,126,151,.30);
}


.purelane-hero-button:hover {
  transform: translateY(-2px);
}


/* =========================================================
   RIGHT PRODUCT AREA
   ========================================================= */

.purelane-hero-products {
  position: relative;

  height: 560px;

  display: flex;

  align-items: center;

  justify-content: center;
}


/* =========================================================
   BOTTLES
   ========================================================= */

.purelane-hero-bottles {
  position: absolute;

  right: 60px;

  bottom: 38px;

  width: 430px;

  height: 470px;
}


.purelane-bottle {
  position: absolute;

  bottom: 0;

  width: 118px;

  height: 350px;

  border-radius:
    18px 18px 15px 15px;

  background:
    linear-gradient(
      90deg,
      #7255b6 0%,
      #8166c4 45%,
      #684dab 100%
    );

  box-shadow:
    0 25px 35px rgba(75,58,120,.20);

  transition:
    transform .8s ease,
    opacity .8s ease;
}


.bottle-left {
  left: 15px;

  height: 270px;

  transform: translateY(20px);
}


.bottle-center {
  left: 145px;

  height: 390px;

  z-index: 2;
}


.bottle-right {
  right: 5px;

  height: 305px;

  transform: translateY(5px);
}


/* CAPS */

.bottle-cap {
  position: absolute;

  left: 50%;

  top: -45px;

  width: 48px;

  height: 45px;

  transform: translateX(-50%);

  border-radius:
    8px 8px 3px 3px;

  background: #8067c2;
}


.bottle-cap::after {
  content: "";

  position: absolute;

  left: 0;

  bottom: -14px;

  width: 48px;

  height: 14px;

  background: #7560b6;
}


/* LABEL */

.bottle-label {
  position: absolute;

  left: 16px;

  right: 16px;

  top: 45%;

  height: 78px;

  border-radius: 5px;

  background:
    linear-gradient(
      180deg,
      rgba(250,249,255,.96),
      rgba(238,234,251,.92)
    );
}


.bottle-label::before,
.bottle-label::after {
  content: "";

  position: absolute;

  left: 20%;

  right: 20%;

  height: 7px;

  background: #a99bd7;
}


.bottle-label::before {
  top: 24px;
}


.bottle-label::after {
  top: 42px;

  opacity: .65;
}


/* =========================================================
   BENEFIT GLASS CARD
   ========================================================= */

.purelane-hero-benefits {
  position: absolute;

  z-index: 8;

  right: -10px;

  top: 50%;

  width: 115px;

  transform: translateY(-50%);

  padding: 18px 9px;

  display: flex;

  flex-direction: column;

  align-items: center;

  border-radius: 23px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.76),
      rgba(230,236,242,.68)
    );

  border: 1px solid rgba(255,255,255,.75);

  box-shadow:
    0 20px 40px rgba(55,70,90,.12);

  backdrop-filter: blur(20px);

  -webkit-backdrop-filter: blur(20px);
}


.purelane-hero-benefit {
  width: 100%;

  padding: 4px 0 15px;

  display: flex;

  flex-direction: column;

  align-items: center;

  text-align: center;
}


.purelane-hero-benefit:not(:last-child) {
  border-bottom: 1px solid rgba(100,110,135,.16);

  margin-bottom: 12px;
}


.purelane-benefit-symbol {
  width: 44px;

  height: 44px;

  margin-bottom: 8px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: rgba(255,255,255,.64);
}


.purelane-benefit-symbol svg {
  width: 22px;

  height: 22px;

  stroke: #6d9b3f;

  stroke-width: 1.5;

  stroke-linecap: round;

  stroke-linejoin: round;
}


.purelane-hero-benefit span {
  font-family: Arial, sans-serif;

  font-size: 9px;

  line-height: 1.35;

  font-weight: 800;

  letter-spacing: .09em;

  color: #514d66;
}


/* =========================================================
   PRICE CARDS
   ========================================================= */

.purelane-price-cards {
  position: absolute;

  z-index: 10;

  left: 50%;

  bottom: 34px;

  transform: translateX(-50%);

  width: 145px;

  height: 110px;
}


.purelane-price-card {
  position: absolute;

  inset: 0;

  padding: 15px;

  box-sizing: border-box;

  border-radius: 17px;

  opacity: 0;

  transform: translateY(8px) scale(.96);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.90),
      rgba(224,239,235,.82)
    );

  border: 1px solid rgba(180,198,202,.60);

  box-shadow:
    0 15px 30px rgba(40,70,65,.12);

  transition:
    opacity .45s ease,
    transform .45s ease;
}


.purelane-price-card.active {
  opacity: 1;

  transform: translateY(0) scale(1);
}


.purelane-price-card small {
  display: block;

  margin-bottom: 4px;

  font-family: Arial, sans-serif;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .16em;

  color: #c47719;
}


.purelane-price-card strong {
  font-family: Arial, sans-serif;

  font-size: 25px;

  line-height: 1;

  font-weight: 900;

  color: #18122d;
}


.purelane-price-card del {
  margin-left: 5px;

  font-family: Arial, sans-serif;

  font-size: 10px;

  color: #777b84;
}


.purelane-price-card span {
  display: table;

  margin-top: 9px;

  padding: 4px 8px;

  border-radius: 999px;

  background: rgba(218,205,145,.25);

  border: 1px solid rgba(190,153,61,.45);

  font-family: Arial, sans-serif;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .07em;

  color: #68933c;
}


/* =========================================================
   DOTS
   ========================================================= */

.purelane-hero-dots {
  position: absolute;

  right: 15px;

  bottom: 12px;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 10px;
}


.purelane-hero-dots button {
  width: 8px;

  height: 8px;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background: #aebfc5;

  cursor: pointer;

  transition:
    height .25s ease,
    background .25s ease;
}


.purelane-hero-dots button.active {
  width: 8px;

  height: 31px;

  border-radius: 999px;

  background: #c87a18;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1050px) {

  .purelane-hero-inner {
    width: calc(100% - 35px);

    grid-template-columns:
      minmax(380px, .9fr)
      minmax(430px, 1.1fr);
  }

  .purelane-hero-content {
    padding-left: 25px;
  }

  .purelane-hero-title {
    font-size: clamp(68px, 8vw, 90px);
  }

  .purelane-hero-description {
    width: 480px;

    font-size: 17px;
  }

  .purelane-hero-bottles {
    right: 25px;

    transform: scale(.9);

    transform-origin: right bottom;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-hero {
    min-height: 760px;
  }


  .purelane-hero-inner {
    width: 100%;

    min-height: 760px;

    display: flex;

    flex-direction: column;

    align-items: stretch;
  }


  .purelane-hero-content {
    padding:
      105px 24px 0;

    text-align: left;
  }


  .purelane-hero-title {
    font-size: 68px;

    line-height: .88;
  }


  .purelane-hero-divider {
    width: 220px;

    margin-top: 22px;
  }


  .purelane-hero-description {
    width: 100%;

    font-size: 16px;

    line-height: 1.5;
  }


  .purelane-hero-buttons {
    margin-top: 20px;

    gap: 8px;
  }


  .purelane-hero-button {
    min-height: 44px;

    padding: 0 17px;

    font-size: 10px;
  }


  .purelane-hero-products {
    height: 340px;

    margin-top: 10px;
  }


  .purelane-hero-bottles {
    right: 15px;

    bottom: 5px;

    width: 300px;

    height: 310px;

    transform: scale(.75);

    transform-origin: right bottom;
  }


  .purelane-hero-benefits {
    right: 8px;

    width: 82px;

    border-radius: 17px;

    padding: 12px 7px;
  }


  .purelane-benefit-symbol {
    width: 32px;

    height: 32px;
  }


  .purelane-benefit-symbol svg {
    width: 17px;

    height: 17px;
  }


  .purelane-hero-benefit span {
    font-size: 6.5px;
  }


  .purelane-price-cards {
    left: 35%;

    bottom: 4px;

    transform: translateX(-50%) scale(.82);

    transform-origin: bottom center;
  }


  .purelane-hero-dots {
    right: 8px;

    bottom: 0;
  }

}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media (max-width: 430px) {

  .purelane-hero-title {
    font-size: 57px;
  }

  .purelane-hero-description {
    font-size: 14px;
  }

  .purelane-hero-products {
    height: 310px;
  }

}

</style>



<script>

(function () {

  function initPurelaneHero() {

    const hero =
      document.querySelector(
        '[data-purelane-hero]'
      );

    if (!hero) return;


    const cards =
      hero.querySelectorAll(
        '.purelane-price-card'
      );

    const dots =
      hero.querySelectorAll(
        '.purelane-hero-dots button'
      );


    let current = 0;

    let timer;


    function showSlide(index) {

      current = index;

      cards.forEach(function(card, i) {

        card.classList.toggle(
          'active',
          i === index
        );

      });


      dots.forEach(function(dot, i) {

        dot.classList.toggle(
          'active',
          i === index
        );

      });

    }


    function nextSlide() {

      const next =
        (current + 1) % cards.length;

      showSlide(next);

    }


    function startSlider() {

      clearInterval(timer);

      timer = setInterval(
        nextSlide,
        4500
      );

    }


    dots.forEach(function(dot) {

      dot.addEventListener(
        'click',
        function() {

          const index =
            parseInt(
              this.dataset.slide,
              10
            );

          showSlide(index);

          startSlider();

        }
      );

    });


    showSlide(0);

    startSlider();


    document.addEventListener(
      'shopify:section:unload',
      function(event) {

        if (
          event.detail &&
          event.detail.sectionId ===
          hero.dataset.sectionId
        ) {

          clearInterval(timer);

        }

      }
    );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initPurelaneHero
    );

  } else {

    initPurelaneHero();

  }

})();

</script>



