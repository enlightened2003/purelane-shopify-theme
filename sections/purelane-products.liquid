<style>

/* =========================================================
   PURELANE PRODUCTS SECTION
   ========================================================= */

.purelane-products-section {
  position: relative;

  width: 100%;

  padding: 95px 0 70px;

  overflow: hidden;

  box-sizing: border-box;

  background:
    radial-gradient(
      ellipse at 50% 10%,
      rgba(255,255,255,.22),
      transparent 55%
    ),
    linear-gradient(
      180deg,
      #d9f4df 0%,
      #c9ecd5 48%,
      #b5dcc8 100%
    );
}


/* WATER / WAVE TEXTURE */

.purelane-products-section::before,
.purelane-products-section::after {
  content: "";

  position: absolute;

  left: -10%;

  width: 120%;

  height: 180px;

  pointer-events: none;

  opacity: .42;
}


.purelane-products-section::before {
  top: 55px;

  border-top:
    7px solid rgba(255,255,255,.38);

  border-radius:
    50% 40% 55% 45%;
}


.purelane-products-section::after {
  bottom: 50px;

  border-top:
    6px solid rgba(255,255,255,.30);

  border-radius:
    45% 55% 40% 60%;
}


/* =========================================================
   INTRO
   ========================================================= */

.purelane-products-intro {
  position: relative;

  z-index: 2;

  width: min(900px, calc(100% - 40px));

  margin: 0 auto 55px;

  text-align: center;
}


.purelane-products-eyebrow {
  margin-bottom: 20px;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 14px;

  font-weight: 700;

  letter-spacing: .20em;

  color: #777a86;
}


.purelane-products-intro h2 {
  margin: 0;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(48px, 5vw, 70px);

  line-height: .98;

  font-weight: 900;

  letter-spacing: -.055em;

  color: #171029;
}


.purelane-products-divider {
  width: 180px;

  margin: 23px auto 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 20px;
}


.purelane-products-divider span {
  flex: 1;

  height: 1px;

  background: rgba(115,132,157,.48);
}


.purelane-products-divider b {
  font-family: Arial, sans-serif;

  font-size: 25px;

  line-height: 1;

  color: #c57916;

  transform: rotate(180deg);
}


.purelane-products-intro p {
  width: min(650px, 100%);

  margin: 0 auto;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 24px;

  line-height: 1.45;

  color: #565b70;
}


/* =========================================================
   CAROUSEL
   ========================================================= */

.purelane-combos-wrapper {
  position: relative;

  z-index: 3;

  width: 100%;

  overflow: hidden;
}


.purelane-combos-track {
  width: max-content;

  padding-left: max(
    30px,
    calc((100vw - 1265px) / 2)
  );

  padding-right: 30px;

  display: flex;

  gap: 20px;

  overflow: visible;
}


/* =========================================================
   COMBO CARD
   ========================================================= */

.purelane-combo-card {
  position: relative;

  width: 375px;

  min-width: 375px;

  height: 560px;

  overflow: hidden;

  display: flex;

  flex-direction: column;

  border-radius: 28px;

  border: 1px solid rgba(190,201,210,.72);

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.90) 0%,
      rgba(216,237,233,.88) 100%
    );

  box-shadow:
    0 20px 40px rgba(40,70,65,.10);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

  box-sizing: border-box;
}


.purelane-combo-card.purelane-best-value {
  border: 2px solid rgba(209,151,61,.65);

  box-shadow:
    0 22px 45px rgba(40,70,65,.13);
}


/* =========================================================
   TOP BADGES
   ========================================================= */

.purelane-combo-top {
  position: relative;

  z-index: 4;

  min-height: 64px;

  padding: 20px 17px 8px;

  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  box-sizing: border-box;
}


.purelane-saving-badge {
  padding: 8px 14px;

  border-radius: 999px;

  background: rgba(255,255,255,.82);

  border: 1px solid rgba(205,148,64,.38);

  font-family: Arial, sans-serif;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .12em;

  color: #719b4c;

  white-space: nowrap;
}


.purelane-popular-badge {
  padding: 8px 14px;

  border-radius: 999px;

  background: #006d68;

  color: #ffffff;

  font-family: Arial, sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: .08em;

  white-space: nowrap;
}


/* =========================================================
   PRODUCT PREVIEW
   ========================================================= */

.purelane-products-preview {
  height: 145px;

  padding: 5px 17px 15px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 8px;

  border-bottom: 1px solid rgba(175,192,196,.35);

  box-sizing: border-box;
}


.purelane-mini-product {
  flex: 1;

  min-width: 0;

  height: 130px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: flex-start;

  text-align: center;
}


.purelane-mini-product img {
  width: 70px;

  height: 88px;

  object-fit: contain;

  margin-bottom: 3px;

  filter:
    drop-shadow(
      0 7px 9px rgba(80,70,120,.16)
    );
}


.purelane-mini-product span {
  font-family: Arial, Helvetica, sans-serif;

  font-size: 11px;

  line-height: 1.15;

  color: #55586b;
}


.purelane-products-preview > strong {
  flex-shrink: 0;

  color: #c97818;

  font-family: Arial, sans-serif;

  font-size: 14px;
}


/* FALLBACK BOTTLE */

.purelane-bottle {
  position: relative;

  width: 35px;

  height: 70px;

  margin-top: 13px;

  margin-bottom: 8px;

  border-radius: 8px 8px 6px 6px;

  background:
    linear-gradient(
      90deg,
      #8d77cc,
      #7460b8
    );

  box-shadow:
    0 8px 12px rgba(65,55,110,.18);
}


.purelane-bottle::before {
  content: "";

  position: absolute;

  left: 10px;

  top: -12px;

  width: 15px;

  height: 14px;

  border-radius: 3px 3px 1px 1px;

  background: #7964bd;
}


.purelane-bottle::after {
  content: "";

  position: absolute;

  left: 6px;

  top: 32px;

  width: 23px;

  height: 18px;

  border-radius: 2px;

  background: rgba(245,243,255,.90);
}


.purelane-mini-leaf {
  width: 54px;

  height: 82px;

  margin-bottom: 7px;

  display: grid;

  place-items: center;

  border: 1px dashed rgba(120,140,190,.35);

  border-radius: 10px;

  font-size: 23px;

  color: #6b9b38;
}


/* =========================================================
   CARD INFORMATION
   ========================================================= */

.purelane-combo-info {
  flex: 1;

  padding: 18px 20px 10px;

  box-sizing: border-box;
}


.purelane-combo-info h3 {
  margin: 0 0 9px;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 20px;

  line-height: 1.1;

  font-weight: 900;

  letter-spacing: -.025em;

  color: #29243e;
}


.purelane-product-count {
  margin-bottom: 14px;

  font-family: Arial, sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .13em;

  color: #818595;
}


.purelane-combo-info p {
  margin: 0;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 15.5px;

  line-height: 1.45;

  color: #5d6073;
}


.purelane-price-row {
  margin-top: 25px;

  display: flex;

  align-items: center;

  gap: 9px;
}


.purelane-price-row strong {
  font-family: Arial, sans-serif;

  font-size: 31px;

  font-weight: 900;

  letter-spacing: -.04em;

  color: #161127;
}


.purelane-price-row del {
  font-family: Arial, sans-serif;

  font-size: 14px;

  color: #858691;
}


.purelane-price-row span {
  padding: 7px 10px;

  border-radius: 999px;

  background: rgba(218,207,154,.25);

  border: 1px solid rgba(197,151,54,.45);

  font-family: Arial, sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .08em;

  color: #669438;
}


.purelane-combo-info small {
  display: block;

  margin-top: 10px;

  font-family: Arial, sans-serif;

  font-size: 12px;

  color: #7a7d8b;
}


/* =========================================================
   SHOP BUTTON
   ========================================================= */

.purelane-shop-button {
  height: 56px;

  margin: 0 20px 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 14px;

  border-radius: 999px;

  background: rgba(255,255,255,.82);

  border: 1px solid rgba(110,96,160,.28);

  color: #075d59;

  font-family: Arial, sans-serif;

  font-size: 15px;

  font-weight: 800;

  letter-spacing: .14em;

  text-decoration: none;

  transition:
    transform .2s ease,
    background .2s ease;
}


.purelane-shop-button span {
  font-size: 20px;

  line-height: 1;
}


.purelane-shop-button:hover {
  transform: translateY(-2px);

  background: #ffffff;
}


.purelane-shop-primary {
  background: #006e68;

  color: #ffffff;

  border-color: #006e68;
}


.purelane-shop-primary:hover {
  background: #007d76;
}


/* =========================================================
   SWIPE NOTE
   ========================================================= */

.purelane-swipe-note {
  position: relative;

  z-index: 3;

  width: min(650px, calc(100% - 40px));

  margin: 20px auto 0;

  text-align: center;
}


.purelane-swipe-title {
  font-family: Arial, sans-serif;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .16em;

  color: #737886;
}


.purelane-swipe-title span {
  margin-right: 8px;

  color: #c57916;

  font-size: 18px;
}


.purelane-swipe-note p {
  margin: 20px 0 0;

  font-family: Arial, sans-serif;

  font-size: 15px;

  line-height: 1.55;

  color: #737886;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-products-section {
    padding: 70px 0 55px;
  }

  .purelane-products-intro {
    margin-bottom: 35px;
  }

  .purelane-products-eyebrow {
    font-size: 11px;
  }

  .purelane-products-intro h2 {
    font-size: 43px;
  }

  .purelane-products-intro p {
    font-size: 18px;
  }

  .purelane-combos-track {
    padding-left: 18px;

    gap: 14px;
  }

  .purelane-combo-card {
    width: 315px;

    min-width: 315px;

    height: 535px;

    border-radius: 24px;
  }

  .purelane-products-preview {
    padding-left: 12px;

    padding-right: 12px;
  }

  .purelane-mini-product img {
    width: 58px;

    height: 78px;
  }

  .purelane-combo-info {
    padding-left: 17px;

    padding-right: 17px;
  }

  .purelane-combo-info h3 {
    font-size: 18px;
  }

  .purelane-combo-info p {
    font-size: 14px;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (min-width: 701px) and (max-width: 1100px) {

  .purelane-combo-card {
    width: 340px;

    min-width: 340px;
  }

  .purelane-products-intro h2 {
    font-size: 56px;
  }

}

</style>



