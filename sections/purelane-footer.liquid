<style>

.purelane-footer {
  width: 100%;
  box-sizing: border-box;

  padding: 58px 0 36px;

  background:
    linear-gradient(
      180deg,
      #d9f1df 0%,
      #c8e8d3 100%
    );

  color: #55586d;

  font-family: Arial, Helvetica, sans-serif;

  position: relative;
}


/* MAIN FOOTER */

.purelane-footer-inner {
  width: min(1200px, calc(100% - 80px));

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    2fr
    1.15fr
    1.15fr
    1.45fr;

  column-gap: 70px;
}


/* BRAND */

.purelane-footer-brand {
  padding-top: 0;
}


.purelane-footer-logo {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 23px;
}


.purelane-footer-logo-icon {
  width: 50px;

  height: 50px;

  border-radius: 50%;

  display: grid;

  place-items: center;

  background: rgba(247,244,232,.75);

  border: 1px solid rgba(190,198,195,.75);
}


.purelane-footer-logo-icon span {
  font-size: 28px;

  line-height: 1;

  color: #c47d20;

  transform: rotate(-35deg);

  display: block;
}


.purelane-footer-logo-name {
  font-size: 20px;

  line-height: 1;

  font-weight: 900;

  letter-spacing: -.025em;

  color: #21183b;
}


.purelane-footer-logo-tagline {
  margin-top: 5px;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .22em;

  color: #777b87;
}


.purelane-footer-brand > p {
  margin: 0;

  font-size: 17px;

  line-height: 1.6;

  color: #575b70;
}


/* COLUMNS */

.purelane-footer-column {
  display: flex;

  flex-direction: column;

  align-items: flex-start;
}


.purelane-footer-column h3 {
  margin: 3px 0 20px;

  font-size: 14px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .20em;

  color: #548400;
}


.purelane-footer-column a {
  margin-bottom: 15px;

  color: #55586d;

  font-size: 17px;

  line-height: 1.25;

  text-decoration: none;

  transition:
    color .2s ease,
    transform .2s ease;
}


.purelane-footer-column a:hover {
  color: #08776e;

  transform: translateX(2px);
}


/* CONTACT */

.purelane-footer-contact p {
  margin: 2px 0 0;

  font-size: 15px;

  color: rgba(255,255,255,.18);
}


/* BOTTOM */

.purelane-footer-bottom {
  width: min(1200px, calc(100% - 80px));

  margin: 40px auto 0;

  padding-top: 28px;

  border-top: 1px solid rgba(155,183,174,.35);

  display: flex;

  align-items: center;

  justify-content: space-between;

  font-size: 15px;

  color: #7a7e8c;
}


.purelane-footer-legal {
  display: flex;

  align-items: center;

  gap: 7px;
}


.purelane-footer-legal a {
  color: #7a7e8c;

  text-decoration: none;
}


.purelane-footer-legal a:hover {
  color: #08776e;
}


/* TABLET */

@media (max-width: 900px) {

  .purelane-footer-inner {
    width: calc(100% - 50px);

    grid-template-columns:
      1.5fr
      1fr
      1fr;

    row-gap: 45px;
  }

  .purelane-footer-contact {
    grid-column: 1 / -1;
  }

  .purelane-footer-bottom {
    width: calc(100% - 50px);

    gap: 20px;

    flex-direction: column;

    align-items: flex-start;
  }

}


/* MOBILE */

@media (max-width: 650px) {

  .purelane-footer {
    padding: 45px 0 30px;
  }

  .purelane-footer-inner {
    width: calc(100% - 40px);

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 38px 25px;
  }

  .purelane-footer-brand {
    grid-column: 1 / -1;
  }

  .purelane-footer-contact {
    grid-column: 1 / -1;
  }

  .purelane-footer-brand > p {
    font-size: 15px;
  }

  .purelane-footer-column a {
    font-size: 15px;

    margin-bottom: 13px;
  }

  .purelane-footer-bottom {
    width: calc(100% - 40px);

    margin-top: 35px;

    font-size: 13px;

    line-height: 1.5;
  }

  .purelane-footer-legal {
    flex-wrap: wrap;
  }

}

</style>


