<header class="purelane-header">
  <div class="purelane-header-inner">

    <!-- LOGO -->
    <a href="/" class="purelane-logo">
      <span class="purelane-logo-icon">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M12 3L19 8V16L12 21L5 16V8L12 3Z"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path
            d="M12 7L15.5 9.5V14.5L12 17L8.5 14.5V9.5L12 7Z"
            stroke="currentColor"
            stroke-width="1.2"
          />
        </svg>
      </span>

      <span class="purelane-logo-text">
        <strong>PURELANE</strong>
        <small>CLEAN, SIMPLY</small>
      </span>
    </a>

    <!-- NAVIGATION -->
    <nav class="purelane-nav">

      <a href="/">Home</a>

      <a href="#ingredients">Ingredients</a>

      <a href="#how-it-works">How it works</a>

      <a href="#shop">Shop</a>

      <a href="#bundles">Bundles</a>

    </nav>

    <!-- ACTIONS -->
    <div class="purelane-actions">

      <!-- Search -->
      <button type="button" aria-label="Search" class="purelane-action">
        <svg viewBox="0 0 24 24" fill="none">
          <circle
            cx="11"
            cy="11"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.7"
          />
          <path
            d="M16 16L21 21"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <!-- Account -->
      <a
        href="{{ routes.account_url }}"
        aria-label="Account"
        class="purelane-action"
      >
        <svg viewBox="0 0 24 24" fill="none">
          <circle
            cx="12"
            cy="8"
            r="3.5"
            stroke="currentColor"
            stroke-width="1.6"
          />
          <path
            d="M5.5 20C6.2 15.8 8.3 13.8 12 13.8C15.7 13.8 17.8 15.8 18.5 20"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </a>

      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        aria-label="Cart"
        class="purelane-action purelane-cart"
      >
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M5 8H19L18 20H6L5 8Z"
            stroke="currentColor"
            stroke-width="1.6"
          />
          <path
            d="M9 9V6.5C9 4.8 10.3 3.5 12 3.5C13.7 3.5 15 4.8 15 6.5V9"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>

        {% if cart.item_count > 0 %}
          <span class="purelane-cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

      <!-- Mobile menu -->
      <button
        type="button"
        aria-label="Menu"
        class="purelane-menu-button"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>

  </div>
</header>

<style>
  .purelane-header {
    width: 100%;
    position: relative;
    z-index: 20;
    padding: 14px 18px;
    background: #ffffff;
  }

  .purelane-header-inner {
    max-width: 1180px;
    min-height: 74px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 8px 16px;

    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(75, 58, 143, 0.18);
    border-radius: 38px;

    box-shadow:
      0 12px 35px rgba(36, 26, 61, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  /* ---------- LOGO ---------- */

  .purelane-logo {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #4b3a8f;
    text-decoration: none;

    flex-shrink: 0;
  }

  .purelane-logo-icon {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: rgba(240, 160, 60, 0.08);
    border: 1px solid rgba(75, 58, 143, 0.16);

    color: #f0a03c;
  }

  .purelane-logo-icon svg {
    width: 27px;
    height: 27px;
  }

  .purelane-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .purelane-logo-text strong {
    font-family: Arial, sans-serif;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #4b3a8f;
  }

  .purelane-logo-text small {
    margin-top: 5px;

    font-family: Arial, sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.20em;

    color: #8a8495;
  }

  /* ---------- NAVIGATION ---------- */

  .purelane-nav {
    display: flex;
    align-items: center;
    gap: 34px;

    margin-left: 30px;
  }

  .purelane-nav a {
    position: relative;

    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;

    color: #514b62;
    text-decoration: none;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .purelane-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;

    height: 2px;

    border-radius: 10px;

    background: #4b3a8f;

    transform: scaleX(0);
    transform-origin: center;

    transition: transform 0.25s ease;
  }

  .purelane-nav a:hover {
    color: #4b3a8f;
  }

  .purelane-nav a:hover::after {
    transform: scaleX(1);
  }

  /* ---------- ACTIONS ---------- */

  .purelane-actions {
    display: flex;
    align-items: center;
    gap: 17px;

    margin-left: 25px;
  }

  .purelane-action {
    position: relative;

    width: 25px;
    height: 25px;

    display: grid;
    place-items: center;

    padding: 0;

    color: #514b62;
    text-decoration: none;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .purelane-action:hover {
    color: #4b3a8f;
    transform: translateY(-1px);
  }

  .purelane-action svg {
    width: 22px;
    height: 22px;
  }

  /* ---------- CART COUNT ---------- */

  .purelane-cart-count {
    position: absolute;

    top: -7px;
    right: -8px;

    min-width: 18px;
    height: 18px;

    display: grid;
    place-items: center;

    padding: 0 4px;

    border-radius: 50%;

    background: #f0a03c;
    color: #241a3d;

    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 800;
  }

  /* ---------- MOBILE MENU ---------- */

  .purelane-menu-button {
    display: none;

    width: 25px;
    height: 25px;

    padding: 3px;

    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }

  .purelane-menu-button span {
    width: 100%;
    height: 1.5px;

    background: #514b62;
    border-radius: 10px;
  }

  /* ---------- TABLET ---------- */

  @media (max-width: 900px) {

    .purelane-nav {
      gap: 18px;
      margin-left: 15px;
    }

    .purelane-nav a {
      font-size: 12px;
    }

    .purelane-actions {
      gap: 11px;
      margin-left: 15px;
    }

  }

  /* ---------- MOBILE ---------- */

  @media (max-width: 700px) {

    .purelane-header {
      padding: 10px 10px;
    }

    .purelane-header-inner {
      min-height: 62px;
      padding: 7px 12px;
      border-radius: 32px;
    }

    .purelane-logo-icon {
      width: 40px;
      height: 40px;
    }

    .purelane-logo-icon svg {
      width: 23px;
      height: 23px;
    }

    .purelane-logo-text strong {
      font-size: 17px;
    }

    .purelane-logo-text small {
      font-size: 6.5px;
    }

    .purelane-nav {
      display: none;
    }

    .purelane-actions {
      gap: 12px;
      margin-left: auto;
    }

    .purelane-menu-button {
      display: flex;
    }

  }
</style>

{% schema %}
{
  "name": "Purelane Header",
  "settings": []
}
{% endschema %}