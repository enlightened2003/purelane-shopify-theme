<header class="purelane-header">

  <div class="purelane-header-inner">

    <!-- LOGO -->
    <a
      href="{{ routes.root_url }}"
      class="purelane-logo"
      aria-label="Purelane Home"
    >

      <span class="purelane-logo-icon">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <path
            d="M12 3L19 8V16L12 21L5 16V8L12 3Z"
            stroke="currentColor"
            stroke-width="1.5"
          />

          <path
            d="M12 7L15.5 9.5V14.5L12 17L8.5 14.5V9.5L12 7Z"
            stroke="currentColor"
            stroke-width="1.2"
          />

        </svg>

      </span>


      <span class="purelane-logo-text">

        <strong>PURELANE</strong>

        <small>CLEAN, SIMPLY</small>

      </span>

    </a>


    <!-- NAVIGATION -->
    <nav
      class="purelane-nav"
      aria-label="Main navigation"
    >

      <a href="{{ routes.root_url }}">
        Home
      </a>

      <a href="#ingredients">
        Ingredients
      </a>

      <a href="#how-it-works">
        How it works
      </a>

      <a href="#shop">
        Shop
      </a>

      <a href="#bundles">
        Bundles
      </a>

    </nav>


    <!-- ACTIONS -->
    <div class="purelane-actions">

      <!-- SEARCH -->
      <a
        href="{{ routes.search_url }}"
        class="purelane-action"
        aria-label="Search"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.7"
          />

          <path
            d="M16 16L21 21"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />

        </svg>

      </a>


      <!-- ACCOUNT -->
      <a
        href="{{ routes.account_url }}"
        class="purelane-action"
        aria-label="Account"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <circle
            cx="12"
            cy="8"
            r="3.5"
            stroke="currentColor"
            stroke-width="1.6"
          />

          <path
            d="M5.5 20C6.2 15.8 8.3 13.8 12 13.8C15.7 13.8 17.8 15.8 18.5 20"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />

        </svg>

      </a>


      <!-- CART -->
      <a
        href="{{ routes.cart_url }}"
        class="purelane-action purelane-cart"
        aria-label="Cart"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <path
            d="M5 8H19L18 20H6L5 8Z"
            stroke="currentColor"
            stroke-width="1.6"
          />

          <path
            d="M9 9V6.5C9 4.8 10.3 3.5 12 3.5C13.7 3.5 15 4.8 15 6.5V9"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />

        </svg>


        {% if cart.item_count > 0 %}

          <span class="purelane-cart-count">
            {{ cart.item_count }}
          </span>

        {% endif %}

      </a>

    </div>

  </div>

</header>


<style>

/* =========================================================
   PURELANE HEADER
   ========================================================= */

.purelane-header {

  /*
    IMPORTANT:
    The announcement is above this.
    Header floats over the hero.
  */

  position: absolute;

  top: 40px;

  left: 0;

  width: 100%;

  padding: 12px 18px;

  z-index: 100;

  pointer-events: none;

}


.purelane-header-inner {

  width: 100%;

  max-width: 1250px;

  min-height: 70px;

  margin: 0 auto;

  padding: 7px 16px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  border-radius: 999px;


  /* GLASS EFFECT */

  background:
    linear-gradient(
      110deg,
      rgba(255,255,255,.78),
      rgba(255,255,255,.58)
    );

  border: 1px solid rgba(93,74,135,.16);

  box-shadow:

    0 14px 35px rgba(70,55,100,.08),

    inset 0 1px 0 rgba(255,255,255,.90);

  backdrop-filter: blur(22px) saturate(135%);

  -webkit-backdrop-filter: blur(22px) saturate(135%);

  pointer-events: auto;

}


/* =========================================================
   LOGO
   ========================================================= */

.purelane-logo {

  display: flex;

  align-items: center;

  gap: 10px;

  flex-shrink: 0;

  text-decoration: none;

  color: #5d5870;

}


.purelane-logo-icon {

  width: 46px;

  height: 46px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: rgba(255,255,255,.58);

  border: 1px solid rgba(90,75,120,.12);

  color: #dca05a;

}


.purelane-logo-icon svg {

  width: 25px;

  height: 25px;

}


.purelane-logo-text {

  display: flex;

  flex-direction: column;

  line-height: 1;

}


.purelane-logo-text strong {

  font-family: Arial, sans-serif;

  font-size: 20px;

  font-weight: 800;

  letter-spacing: .02em;

  color: #706b7e;

}


.purelane-logo-text small {

  margin-top: 5px;

  font-family: Arial, sans-serif;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: .20em;

  color: #aaa5b2;

}


/* =========================================================
   NAVIGATION
   ========================================================= */

.purelane-nav {

  display: flex;

  align-items: center;

  gap: 32px;

  margin-left: auto;

  margin-right: auto;

}


.purelane-nav a {

  position: relative;

  font-family: Arial, sans-serif;

  font-size: 15px;

  font-weight: 600;

  color: #5d5870;

  text-decoration: none;

  white-space: nowrap;

  transition:

    color .2s ease,

    transform .2s ease;

}


.purelane-nav a::after {

  content: "";

  position: absolute;

  left: 0;

  right: 0;

  bottom: -8px;

  height: 2px;

  border-radius: 10px;

  background: #dca05a;

  transform: scaleX(0);

  transition: transform .2s ease;

}


.purelane-nav a:hover {

  color: #40375d;

  transform: translateY(-1px);

}


.purelane-nav a:hover::after {

  transform: scaleX(1);

}


/* =========================================================
   ACTIONS
   ========================================================= */

.purelane-actions {

  display: flex;

  align-items: center;

  gap: 18px;

  flex-shrink: 0;

}


.purelane-action {

  position: relative;

  width: 25px;

  height: 25px;

  display: grid;

  place-items: center;

  color: #5d5870;

  text-decoration: none;

  transition:

    color .2s ease,

    transform .2s ease;

}


.purelane-action:hover {

  color: #40375d;

  transform: translateY(-1px);

}


.purelane-action svg {

  width: 21px;

  height: 21px;

}


/* =========================================================
   CART COUNT
   ========================================================= */

.purelane-cart-count {

  position: absolute;

  top: -9px;

  right: -8px;

  min-width: 18px;

  height: 18px;

  padding: 0 4px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: #5b4597;

  color: white;

  font-family: Arial, sans-serif;

  font-size: 9px;

  font-weight: 800;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 950px) {

  .purelane-nav {

    gap: 18px;

  }

  .purelane-nav a {

    font-size: 13px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-header {

    top: 34px;

    padding: 8px 10px;

  }


  .purelane-header-inner {

    min-height: 58px;

    padding: 6px 12px;

  }


  .purelane-logo-icon {

    width: 38px;

    height: 38px;

  }


  .purelane-logo-icon svg {

    width: 21px;

    height: 21px;

  }


  .purelane-logo-text strong {

    font-size: 16px;

  }


  .purelane-logo-text small {

    font-size: 6px;

  }


  .purelane-nav {

    display: none;

  }


  .purelane-actions {

    gap: 12px;

  }

}

</style>


{% schema %}
{
  "name": "Purelane Header",
  "settings": []
}
{% endschema %}