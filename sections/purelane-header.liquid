<!-- =========================================================
     PURELANE HEADER
     ========================================================= -->

<header class="purelane-header">

  <div class="purelane-header-inner">

    <!-- LOGO -->
    <a
      href="{{ routes.root_url }}"
      class="purelane-logo"
      aria-label="Purelane home"
    >

      <span class="purelane-logo-icon">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M12 3L19 8V16L12 21L5 16V8L12 3Z"
            stroke="currentColor"
            stroke-width="1.5"
          />

          <path
            d="M12 7L15.5 9.5V14.5L12 17L8.5 14.5V9.5L12 7Z"
            stroke="currentColor"
            stroke-width="1.2"
          />
        </svg>

      </span>


      <span class="purelane-logo-text">

        <strong>PURELANE</strong>

        <small>CLEAN, SIMPLY</small>

      </span>

    </a>


    <!-- =====================================================
         DESKTOP NAVIGATION
         ===================================================== -->

    <nav
      class="purelane-nav"
      aria-label="Main navigation"
    >

      <a
        href="{{ routes.root_url }}"
        class="purelane-nav-link"
      >
        Home
      </a>


      <a
        href="{{ routes.root_url }}#ingredients"
        class="purelane-nav-link"
      >
        Ingredients
      </a>


      <a
        href="{{ routes.root_url }}#how-it-works"
        class="purelane-nav-link"
      >
        How it works
      </a>


      <a
        href="{{ routes.root_url }}#shop"
        class="purelane-nav-link"
      >
        Shop
      </a>


      <a
        href="{{ routes.root_url }}#bundles"
        class="purelane-nav-link"
      >
        Bundles
      </a>

    </nav>


    <!-- =====================================================
         ACTIONS
         ===================================================== -->

    <div class="purelane-actions">


      <!-- SEARCH -->

      <a
        href="{{ routes.search_url }}"
        class="purelane-action"
        aria-label="Search"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.7"
          />

          <path
            d="M16 16L21 21"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />

        </svg>

      </a>


      <!-- ACCOUNT -->

      <a
        href="{{ routes.account_url }}"
        class="purelane-action"
        aria-label="Account"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <circle
            cx="12"
            cy="8"
            r="3.5"
            stroke="currentColor"
            stroke-width="1.6"
          />

          <path
            d="M5.5 20C6.2 15.8 8.3 13.8 12 13.8C15.7 13.8 17.8 15.8 18.5 20"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />

        </svg>

      </a>


      <!-- CART -->

      <a
        href="{{ routes.cart_url }}"
        class="purelane-action purelane-cart"
        aria-label="Cart"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <path
            d="M5 8H19L18 20H6L5 8Z"
            stroke="currentColor"
            stroke-width="1.6"
          />

          <path
            d="M9 9V6.5C9 4.8 10.3 3.5 12 3.5C13.7 3.5 15 4.8 15 6.5V9"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />

        </svg>


        {% if cart.item_count > 0 %}

          <span class="purelane-cart-count">
            {{ cart.item_count }}
          </span>

        {% endif %}

      </a>


      <!-- MOBILE MENU -->

      <button
        type="button"
        class="purelane-menu-button"
        aria-label="Open menu"
        aria-expanded="false"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>

</header>


<!-- =========================================================
     PURELANE HEADER STYLES
     ========================================================= -->

<style>

/* =========================================================
   HEADER
   ========================================================= */

.purelane-header {

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;

  z-index: 100;

  padding: 14px 18px;

  background: transparent;

}


/* =========================================================
   HEADER INNER
   ========================================================= */

.purelane-header-inner {

  width: 100%;

  max-width: 1180px;

  min-height: 72px;

  margin: 0 auto;

  padding: 7px 16px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  border-radius: 999px;

  /*
     LIGHT GLASS EFFECT
  */

  background:

    linear-gradient(
      135deg,
      rgba(255,255,255,.88),
      rgba(255,255,255,.66)
    );

  border: 1px solid rgba(91,74,143,.18);

  box-shadow:

    0 10px 35px rgba(42,32,76,.10),

    inset 0 1px 0 rgba(255,255,255,.95);

  backdrop-filter: blur(18px) saturate(120%);

  -webkit-backdrop-filter: blur(18px) saturate(120%);

}


/* =========================================================
   LOGO
   ========================================================= */

.purelane-logo {

  display: flex;

  align-items: center;

  gap: 11px;

  flex-shrink: 0;

  color: #292044;

  text-decoration: none;

}


/* LOGO ICON */

.purelane-logo-icon {

  width: 46px;

  height: 46px;

  display: grid;

  place-items: center;

  flex-shrink: 0;

  border-radius: 50%;

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.95),
      rgba(245,239,230,.90)
    );

  border: 1px solid rgba(190,157,91,.25);

  color: #dca14c;

}


.purelane-logo-icon svg {

  width: 25px;

  height: 25px;

}


/* LOGO TEXT */

.purelane-logo-text {

  display: flex;

  flex-direction: column;

  line-height: 1;

}


.purelane-logo-text strong {

  font-family: Arial, sans-serif;

  font-size: 20px;

  font-weight: 800;

  letter-spacing: .02em;

  color: #34304c;

}


.purelane-logo-text small {

  margin-top: 5px;

  font-family: Arial, sans-serif;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: .20em;

  color: #9995a7;

}


/* =========================================================
   NAVIGATION
   ========================================================= */

.purelane-nav {

  display: flex;

  align-items: center;

  gap: 32px;

  margin-left: auto;

  margin-right: auto;

}


.purelane-nav-link {

  position: relative;

  display: inline-flex;

  align-items: center;

  padding: 8px 0;

  font-family: Arial, sans-serif;

  font-size: 15px;

  font-weight: 500;

  color: #504b68;

  text-decoration: none;

  white-space: nowrap;

  transition:

    color .25s ease,

    transform .25s ease;

}


.purelane-nav-link::after {

  content: "";

  position: absolute;

  left: 0;

  right: 0;

  bottom: 0;

  height: 2px;

  border-radius: 999px;

  background: #d99938;

  transform: scaleX(0);

  transform-origin: center;

  transition: transform .25s ease;

}


.purelane-nav-link:hover {

  color: #30274f;

  transform: translateY(-1px);

}


.purelane-nav-link:hover::after {

  transform: scaleX(1);

}


/* =========================================================
   ACTIONS
   ========================================================= */

.purelane-actions {

  display: flex;

  align-items: center;

  gap: 17px;

  flex-shrink: 0;

}


.purelane-action {

  position: relative;

  width: 26px;

  height: 26px;

  display: grid;

  place-items: center;

  padding: 0;

  color: #504b68;

  text-decoration: none;

  transition:

    color .25s ease,

    transform .25s ease;

}


.purelane-action:hover {

  color: #292044;

  transform: translateY(-1px);

}


.purelane-action svg {

  width: 21px;

  height: 21px;

}


/* =========================================================
   CART
   ========================================================= */

.purelane-cart {

  position: relative;

}


.purelane-cart-count {

  position: absolute;

  top: -7px;

  right: -7px;

  min-width: 17px;

  height: 17px;

  padding: 0 4px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: #51408e;

  color: #ffffff;

  font-family: Arial, sans-serif;

  font-size: 9px;

  font-weight: 800;

  line-height: 1;

}


/* =========================================================
   MOBILE MENU BUTTON
   ========================================================= */

.purelane-menu-button {

  display: none;

  width: 28px;

  height: 28px;

  padding: 5px;

  flex-direction: column;

  justify-content: center;

  gap: 4px;

  border: 0;

  background: transparent;

  color: #504b68;

  cursor: pointer;

}


.purelane-menu-button span {

  width: 100%;

  height: 1.5px;

  display: block;

  background: currentColor;

  border-radius: 10px;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 950px) {

  .purelane-nav {

    gap: 20px;

  }


  .purelane-nav-link {

    font-size: 13px;

  }


  .purelane-actions {

    gap: 11px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .purelane-header {

    padding: 10px;

  }


  .purelane-header-inner {

    min-height: 62px;

    padding: 6px 12px;

    border-radius: 999px;

  }


  .purelane-logo-icon {

    width: 40px;

    height: 40px;

  }


  .purelane-logo-icon svg {

    width: 22px;

    height: 22px;

  }


  .purelane-logo-text strong {

    font-size: 17px;

  }


  .purelane-logo-text small {

    font-size: 6.5px;

  }


  .purelane-nav {

    display: none;

  }


  .purelane-actions {

    margin-left: auto;

    gap: 12px;

  }


  .purelane-menu-button {

    display: flex;

  }

}


/* =========================================================
   SMOOTH SCROLL
   ========================================================= */

html {

  scroll-behavior: smooth;

}


/*
   Prevent sections from hiding underneath
   the floating header when scrolling.
*/

#ingredients,
#how-it-works,
#shop,
#bundles {

  scroll-margin-top: 100px;

}

</style>


<!-- =========================================================
     HEADER NAVIGATION SCRIPT
     ========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  const links = document.querySelectorAll(
    ".purelane-nav-link[href*='#']"
  );


  links.forEach(function (link) {

    link.addEventListener("click", function (event) {

      const url = new URL(
        link.href,
        window.location.origin
      );

      const targetId = url.hash;


      if (!targetId) {
        return;
      }


      /*
         Only handle same-page navigation.
      */

      if (
        url.pathname !== window.location.pathname
      ) {
        return;
      }


      const target = document.querySelector(targetId);


      if (!target) {
        return;
      }


      event.preventDefault();


      target.scrollIntoView({

        behavior: "smooth",

        block: "start"

      });


      /*
         Update URL without jumping.
      */

      history.pushState(
        null,
        "",
        targetId
      );

    });

  });

});

</script>


{% schema %}

{
  "name": "Purelane Header",
  "settings": []
}

{% endschema %}