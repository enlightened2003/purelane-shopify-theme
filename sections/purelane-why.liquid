<section class="purelane-why">

  <div class="purelane-why__container">

    <!-- =====================================================
         TOP CONTENT
         ===================================================== -->

    <div class="purelane-why__top">

      <!-- LEFT -->
      <div class="purelane-why__content">

        <div class="purelane-why__eyebrow">
          WHY IT WORKS
        </div>

        <h2 class="purelane-why__heading">
          TOUGH ON GRIME.<br>
          GENTLE ON<br>
          EVERYTHING ELSE.
        </h2>

        <p class="purelane-why__description">
          Every formula is built on plant-derived cleansers and
          essential oils. It behaves exactly like the cleaner you
          are used to, minus the things you never signed up for.
        </p>

        <a
          href="#ingredients"
          class="purelane-why__button"
        >
          SEE THE INGREDIENT LIST
          <span>→</span>
        </a>

      </div>


      <!-- =================================================
           RIGHT PRODUCT CARD
           ================================================= -->

      <div class="purelane-why__product">

        <div class="purelane-why__bottle">

          <div class="purelane-why__cap"></div>

          <div class="purelane-why__neck"></div>

          <div class="purelane-why__bottle-body">

            <div class="purelane-why__label">
              <span></span>
              <span></span>
            </div>

          </div>

        </div>


        <div class="purelane-why__product-name">
          FLOOR CLEANER
        </div>

        <div class="purelane-why__product-subtitle">
          Neem powered, pet safe
        </div>


        <div class="purelane-why__dots">

          <span></span>
          <span></span>
          <span></span>
          <span></span>

          <span class="active"></span>

          <span></span>

        </div>

      </div>

    </div>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <div class="purelane-why__stats">


      <!-- STAT 1 -->
      <div class="purelane-why__stat">

        <div class="purelane-why__stat-circle">
          99.9%
        </div>

        <div class="purelane-why__stat-title">
          GERM KILL
        </div>

        <div class="purelane-why__stat-text">
          Tested against germs and bacteria
        </div>

      </div>


      <!-- STAT 2 -->
      <div class="purelane-why__stat">

        <div class="purelane-why__stat-circle">
          0%
        </div>

        <div class="purelane-why__stat-title">
          SULPHATES
        </div>

        <div class="purelane-why__stat-text">
          No SLS, chlorine or parabens
        </div>

      </div>


      <!-- STAT 3 -->
      <div class="purelane-why__stat">

        <div class="purelane-why__stat-circle">
          100%
        </div>

        <div class="purelane-why__stat-title">
          PLANT BASED
        </div>

        <div class="purelane-why__stat-text">
          Cleansers derived from plants
        </div>

      </div>


      <!-- STAT 4 -->
      <div class="purelane-why__stat">

        <div class="purelane-why__stat-circle">
          4.8
        </div>

        <div class="purelane-why__stat-title">
          RATED
        </div>

        <div class="purelane-why__stat-text">
          Across 8,000+ verified reviews
        </div>

      </div>

    </div>

  </div>

</section>


<style>

/* =========================================================
   PURELANE WHY
   ========================================================= */

.purelane-why {
  width: 100%;
  box-sizing: border-box;

  padding: 48px 0 58px;

  position: relative;

  background: transparent;
}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.purelane-why__container {
  width: min(1400px, calc(100% - 80px));

  margin: 0 auto;

  padding: 42px 50px 48px;

  box-sizing: border-box;

  border-radius: 30px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.68),
      rgba(218,239,235,.62)
    );

  border: 1px solid rgba(190,201,205,.68);

  box-shadow:
    0 18px 45px rgba(35,70,65,.08);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}


/* =========================================================
   TOP AREA
   ========================================================= */

.purelane-why__top {

  display: grid;

  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(390px, .75fr);

  gap: 55px;

  align-items: center;
}


/* =========================================================
   LEFT CONTENT
   ========================================================= */

.purelane-why__content {
  min-width: 0;
}


.purelane-why__eyebrow {

  margin-bottom: 18px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .18em;

  color: #aaa8b6;
}


.purelane-why__heading {

  margin: 0;

  padding: 0;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: clamp(48px, 5vw, 68px);

  line-height: .92;

  font-weight: 900;

  letter-spacing: -.045em;

  color: #241a3d;

  text-transform: uppercase;
}


.purelane-why__description {

  max-width: 560px;

  margin: 26px 0 28px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 18px;

  line-height: 1.6;

  font-weight: 400;

  color: #666579;
}


/* =========================================================
   BUTTON
   ========================================================= */

.purelane-why__button {

  min-height: 56px;

  padding: 0 26px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 15px;

  box-sizing: border-box;

  border-radius: 999px;

  background:
    linear-gradient(
      100deg,
      #48a59c,
      #00645f
    );

  color: #ffffff;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  font-weight: 800;

  letter-spacing: .09em;

  text-decoration: none;

  box-shadow:
    0 10px 22px rgba(0,100,95,.18);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


.purelane-why__button span {

  font-size: 22px;

  line-height: 1;

  margin-top: -2px;
}


.purelane-why__button:hover {

  transform: translateY(-2px);

  box-shadow:
    0 14px 28px rgba(0,100,95,.22);
}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

.purelane-why__product {

  width: 100%;

  min-height: 380px;

  box-sizing: border-box;

  padding: 28px 30px 20px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: flex-start;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.78),
      rgba(242,240,249,.70)
    );

  border: 1px solid rgba(190,184,211,.60);

  box-shadow:
    0 14px 35px rgba(55,45,95,.08);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  position: relative;

  overflow: hidden;
}


/* =========================================================
   BOTTLE
   ========================================================= */

.purelane-why__bottle {

  position: relative;

  width: 120px;

  height: 245px;

  margin-top: 8px;

  display: flex;

  flex-direction: column;

  align-items: center;
}


/* CAP */

.purelane-why__cap {

  width: 29px;

  height: 25px;

  margin-bottom: 2px;

  border-radius: 7px 7px 4px 4px;

  background:
    linear-gradient(
      90deg,
      #7660bd,
      #8068c9,
      #6e56b4
    );

  box-shadow:
    0 5px 8px rgba(78,57,135,.15);
}


/* NECK */

.purelane-why__neck {

  width: 30px;

  height: 24px;

  background:
    linear-gradient(
      90deg,
      #7962c0,
      #836bc9,
      #6e55b2
    );
}


/* BODY */

.purelane-why__bottle-body {

  width: 92px;

  height: 185px;

  margin-top: 0;

  border-radius:
    12px
    12px
    17px
    17px;

  background:
    linear-gradient(
      90deg,
      #7058b6,
      #8268c9 50%,
      #6e54b1
    );

  box-shadow:
    0 15px 25px rgba(72,51,130,.20);

  position: relative;
}


/* BOTTLE LABEL */

.purelane-why__label {

  position: absolute;

  left: 12px;
  right: 12px;

  top: 58px;

  height: 65px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 8px;

  border-radius: 4px;

  background:
    rgba(250,248,255,.94);
}


.purelane-why__label span:first-child {

  width: 42px;

  height: 6px;

  background: #b0a0dc;

}


.purelane-why__label span:last-child {

  width: 30px;

  height: 5px;

  background: #c0b3e1;
}


/* =========================================================
   PRODUCT TEXT
   ========================================================= */

.purelane-why__product-name {

  margin-top: 4px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .08em;

  color: #241a3d;
}


.purelane-why__product-subtitle {

  margin-top: 11px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  line-height: 1;

  color: #888597;
}


/* =========================================================
   PRODUCT DOTS
   ========================================================= */

.purelane-why__dots {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 18px;
}


.purelane-why__dots span {

  width: 7px;

  height: 7px;

  display: block;

  border-radius: 50%;

  background: #c7c3dc;
}


.purelane-why__dots span.active {

  width: 18px;

  border-radius: 999px;

  background: #bd7620;
}


/* =========================================================
   STATS CONTAINER
   ========================================================= */

.purelane-why__stats {

  width: 100%;

  margin-top: 38px;

  padding: 26px 20px 24px;

  box-sizing: border-box;

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  align-items: center;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.78),
      rgba(241,240,249,.72)
    );

  border: 1px solid rgba(190,184,211,.60);

  box-shadow:
    0 12px 30px rgba(55,45,95,.06);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


/* =========================================================
   STAT
   ========================================================= */

.purelane-why__stat {

  min-width: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  text-align: center;
}


/* =========================================================
   STAT CIRCLE
   ========================================================= */

.purelane-why__stat-circle {

  width: 90px;

  height: 90px;

  display: flex;

  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  border-radius: 50%;

  border: 1px solid #d4cde4;

  background:
    rgba(255,255,255,.34);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 23px;

  font-weight: 900;

  color: #241a3d;
}


/* =========================================================
   STAT TITLE
   ========================================================= */

.purelane-why__stat-title {

  margin-top: 15px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 13px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .13em;

  color: #c07820;
}


/* =========================================================
   STAT DESCRIPTION
   ========================================================= */

.purelane-why__stat-text {

  max-width: 220px;

  margin-top: 11px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 14px;

  line-height: 1.35;

  color: #666579;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1000px) {

  .purelane-why {
    padding: 35px 0 50px;
  }

  .purelane-why__container {

    width: calc(100% - 40px);

    padding: 35px 30px 40px;

  }

  .purelane-why__top {

    grid-template-columns: 1fr;

    gap: 35px;

  }

  .purelane-why__product {

    max-width: 500px;

    margin: 0 auto;

  }

  .purelane-why__stats {

    grid-template-columns: repeat(2, 1fr);

    gap: 28px;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 650px) {

  .purelane-why {

    padding: 25px 0 40px;

  }

  .purelane-why__container {

    width: calc(100% - 24px);

    padding: 30px 20px 30px;

    border-radius: 24px;

  }

  .purelane-why__heading {

    font-size: 43px;

    line-height: .94;

  }

  .purelane-why__description {

    font-size: 16px;

    line-height: 1.55;

  }

  .purelane-why__button {

    width: 100%;

    font-size: 12px;

  }

  .purelane-why__product {

    min-height: 350px;

    padding: 25px 20px 20px;

  }

  .purelane-why__stats {

    grid-template-columns: 1fr 1fr;

    padding: 22px 12px;

    gap: 25px 10px;

    border-radius: 22px;

  }

  .purelane-why__stat-circle {

    width: 76px;

    height: 76px;

    font-size: 19px;

  }

  .purelane-why__stat-title {

    font-size: 11px;

  }

  .purelane-why__stat-text {

    font-size: 12px;

  }

}

</style>


{% schema %}
{
  "name": "Purelane Why",
  "settings": []
}
{% endschema %}