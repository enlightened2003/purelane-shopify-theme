<style>

/* =========================================================
   WHY SECTION
========================================================= */

.purelane-why {

  position: relative;

  width: 100%;

  padding: 70px 0 75px;

  overflow: hidden;

  box-sizing: border-box;

  background:
    radial-gradient(
      ellipse at 70% 35%,
      rgba(255,255,255,.30),
      transparent 55%
    ),
    linear-gradient(
      145deg,
      #dff5e4 0%,
      #c9ead9 48%,
      #acd6c4 100%
    );

}


/* subtle background waves */

.purelane-why::before {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .4;

  background:

    radial-gradient(
      ellipse at 15% 35%,
      transparent 0,
      transparent 42%,
      rgba(255,255,255,.55) 43%,
      transparent 44%
    ),

    radial-gradient(
      ellipse at 80% 70%,
      transparent 0,
      transparent 44%,
      rgba(255,255,255,.45) 45%,
      transparent 46%
    );

}


/* =========================================================
   INNER
========================================================= */

.purelane-why-inner {

  position: relative;

  z-index: 2;

  width: min(1200px, calc(100% - 80px));

  margin: 0 auto;

}


/* =========================================================
   MAIN
========================================================= */

.purelane-why-main {

  display: grid;

  grid-template-columns: 58% 42%;

  align-items: center;

  min-height: 450px;

}


/* =========================================================
   LEFT
========================================================= */

.purelane-why-content {

  padding: 20px 30px 30px 0;

}


.purelane-eyebrow {

  margin-bottom: 18px;

  color: #9897a7;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .22em;

}


.purelane-why-content h2 {

  margin: 0 0 22px;

  color: #251c40;

  font-family: Arial, Helvetica, sans-serif;

  font-size: clamp(48px, 5vw, 72px);

  line-height: .9;

  letter-spacing: -.055em;

  font-weight: 900;

}


.purelane-why-content p {

  max-width: 530px;

  margin: 0;

  color: #68697c;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 17px;

  line-height: 1.7;

}


/* =========================================================
   BUTTON
========================================================= */

.purelane-why-button {

  display: inline-flex;

  align-items: center;

  gap: 18px;

  margin-top: 27px;

  padding: 17px 27px;

  border-radius: 999px;

  color: white;

  background: #08776f;

  box-shadow:
    0 15px 30px rgba(0,90,80,.18);

  text-decoration: none;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .1em;

}


.purelane-why-button span {

  font-size: 20px;

}


/* =========================================================
   PRODUCT
========================================================= */

.purelane-why-product {

  display: flex;

  align-items: center;

  justify-content: center;

}


.purelane-why-product-card {

  position: relative;

  width: 390px;

  height: 350px;

  border-radius: 25px;

  border: 1px solid rgba(255,255,255,.8);

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.86),
      rgba(239,239,250,.78)
    );

  box-shadow:
    0 20px 45px rgba(70,70,100,.10);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

  overflow: hidden;

}


/* =========================================================
   PRODUCT SLIDES
========================================================= */

.purelane-why-bottle-area {

  position: relative;

  width: 100%;

  height: 100%;

}


.purelane-why-product-slide {

  position: absolute;

  inset: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  opacity: 0;

  visibility: hidden;

  transform: translateX(25px);

  transition:
    opacity .6s ease,
    transform .6s ease;

}


.purelane-why-product-slide.active {

  opacity: 1;

  visibility: visible;

  transform: translateX(0);

}


/* =========================================================
   BOTTLE
========================================================= */

.why-bottle {

  position: relative;

  width: 92px;

  height: 190px;

  margin-top: -20px;

}


.why-bottle-cap {

  position: absolute;

  width: 30px;

  height: 32px;

  left: 50%;

  top: 0;

  transform: translateX(-50%);

  border-radius: 6px 6px 2px 2px;

  background: #8063c7;

}


.why-bottle-neck {

  position: absolute;

  width: 20px;

  height: 28px;

  left: 50%;

  top: 27px;

  transform: translateX(-50%);

  background: #8063c7;

}


.why-bottle-body {

  position: absolute;

  left: 0;

  bottom: 0;

  width: 92px;

  height: 150px;

  border-radius: 14px 14px 9px 9px;

  background:
    linear-gradient(
      145deg,
      #8164cb,
      #604ca3
    );

  box-shadow:
    0 18px 30px rgba(75,55,130,.18);

}


.why-bottle-label {

  position: absolute;

  left: 12px;

  right: 12px;

  top: 52px;

  height: 65px;

  border-radius: 4px;

  background: #eeeaf7;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  gap: 9px;

}


.why-bottle-label span {

  display: block;

  width: 48px;

  height: 7px;

  background: #a99bdb;

}


.why-bottle-label span:last-child {

  width: 35px;

  opacity: .65;

}


/* =========================================================
   PRODUCT TEXT
========================================================= */

.why-product-name {

  margin-top: 7px;

  color: #29223f;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 15px;

  font-weight: 900;

  letter-spacing: .1em;

}


.why-product-description {

  margin-top: 8px;

  color: #88889a;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 12px;

}


/* =========================================================
   DOTS
========================================================= */

.purelane-why-dots {

  position: absolute;

  left: 50%;

  bottom: 14px;

  transform: translateX(-50%);

  display: flex;

  align-items: center;

  gap: 7px;

}


.purelane-why-dots button {

  width: 7px;

  height: 7px;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background: #c4c4df;

  cursor: pointer;

}


.purelane-why-dots button.active {

  width: 22px;

  border-radius: 999px;

  background: #bd7920;

}


/* =========================================================
   STATS
========================================================= */

.purelane-why-stats {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  margin-top: 25px;

  padding: 27px 25px;

  border-radius: 28px;

  border: 1px solid rgba(255,255,255,.8);

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.88),
      rgba(239,239,249,.80)
    );

  box-shadow:
    0 20px 45px rgba(70,70,100,.09);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

}


/* =========================================================
   STAT
========================================================= */

.purelane-stat {

  display: flex;

  flex-direction: column;

  align-items: center;

  text-align: center;

  padding: 0 20px;

}


.purelane-stat-circle {

  width: 88px;

  height: 88px;

  display: grid;

  place-items: center;

  margin-bottom: 13px;

  border-radius: 50%;

  border: 1px solid rgba(130,110,180,.3);

  color: #241a3d;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 23px;

  font-weight: 900;

  background: rgba(255,255,255,.45);

}


.purelane-stat strong {

  color: #c07817;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 12px;

  font-weight: 900;

  letter-spacing: .15em;

}


.purelane-stat p {

  margin: 10px 0 0;

  color: #69697d;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  line-height: 1.4;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .purelane-why-inner {

    width: calc(100% - 40px);

  }

  .purelane-why-main {

    grid-template-columns: 55% 45%;

  }

  .purelane-why-product-card {

    width: 330px;

    height: 330px;

  }

  .purelane-why-content h2 {

    font-size: 47px;

  }

  .purelane-why-stats {

    grid-template-columns:
      repeat(4, 1fr);

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .purelane-why {

    padding: 55px 0;

  }

  .purelane-why-main {

    display: flex;

    flex-direction: column;

  }

  .purelane-why-content {

    padding-right: 0;

  }

  .purelane-why-content h2 {

    font-size: 48px;

  }

  .purelane-why-product {

    width: 100%;

    margin-top: 25px;

  }

  .purelane-why-product-card {

    width: 100%;

    max-width: 390px;

  }

  .purelane-why-stats {

    grid-template-columns:
      repeat(2, 1fr);

    gap: 30px 10px;

  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 450px) {

  .purelane-why-inner {

    width: calc(100% - 30px);

  }

  .purelane-why-content h2 {

    font-size: 40px;

  }

  .purelane-stat-circle {

    width: 70px;

    height: 70px;

    font-size: 19px;

  }

  .purelane-stat p {

    font-size: 11px;

  }

}

</style>


<script>

document.addEventListener(
  "DOMContentLoaded",
  function () {

    const slides =
      document.querySelectorAll(
        ".purelane-why-product-slide"
      );

    const dots =
      document.querySelectorAll(
        ".purelane-why-dots button"
      );

    if (!slides.length) return;

    let current = 0;

    let timer;


    function showWhySlide(index) {

      slides.forEach(
        function(slide, i) {

          slide.classList.toggle(
            "active",
            i === index
          );

        }
      );


      dots.forEach(
        function(dot, i) {

          dot.classList.toggle(
            "active",
            i === index
          );

        }
      );


      current = index;

    }


    function nextWhySlide() {

      current++;

      if (current >= slides.length) {

        current = 0;

      }

      showWhySlide(current);

    }


    function startWhySlider() {

      clearInterval(timer);

      timer = setInterval(
        nextWhySlide,
        2500
      );

    }


    dots.forEach(
      function(dot, index) {

        dot.addEventListener(
          "click",
          function() {

            showWhySlide(index);

            startWhySlider();

          }
        );

      }
    );


    showWhySlide(0);

    startWhySlider();

  }
);

</script>


