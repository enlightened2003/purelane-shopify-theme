<section id="shop" class="purelane-build-bundle">

  <!-- =====================================================
       BUILD YOUR BUNDLE HEADER
  ====================================================== -->

  <div class="purelane-build-header">

    <div class="purelane-build-eyebrow">
      {{ section.settings.header_eyebrow | escape }}
    </div>

    <h2>{{ section.settings.header_title | escape }}</h2>

    <p>
      {{ section.settings.header_text | escape | newline_to_br }}
    </p>

  </div>


  <!-- =====================================================
       BUNDLE CARDS
  ====================================================== -->

  <div class="purelane-build-cards">


    <!-- ===================================================
         STARTER
    ==================================================== -->

    <article class="purelane-build-card">

      <div class="purelane-build-badge">
        {{ section.settings.starter_badge | escape }}
      </div>

      <div class="purelane-build-images">

        {% assign starter_1 = collections[section.settings.collection].products[0] %}
        {% assign starter_2 = collections[section.settings.collection].products[1] %}

        {% if starter_1 %}
          <img
            src="{{ starter_1.featured_image | image_url: width: 180 }}"
            alt="{{ starter_1.title | escape }}"
          >
        {% endif %}

        {% if starter_2 %}
          <img
            src="{{ starter_2.featured_image | image_url: width: 180 }}"
            alt="{{ starter_2.title | escape }}"
          >
        {% endif %}

      </div>


      <div class="purelane-build-number">
        2
      </div>

      <div class="purelane-build-products">
        PRODUCTS
      </div>


      <div class="purelane-build-price">

        <strong>{{ section.settings.starter_price | times: 100 | money_without_trailing_zeros }}</strong>

        {% if section.settings.starter_compare_price > section.settings.starter_price %}
          <del>{{ section.settings.starter_compare_price | times: 100 | money_without_trailing_zeros }}</del>
        {% endif %}

      </div>

      <div class="purelane-flat-price">
        Flat {{ section.settings.starter_price | divided_by: 2 | times: 100 | money_without_trailing_zeros }} per product
      </div>


      <ul>

        <li>✓ {{ section.settings.starter_feature_1 | escape }}</li>
        <li>✓ {{ section.settings.starter_feature_2 | escape }}</li>

      </ul>


      <a
        href="/collections/{{ section.settings.collection }}"
        class="purelane-build-button"
      >
        {{ section.settings.starter_button_label | escape }}
      </a>

    </article>



    <!-- ===================================================
         MOST POPULAR
    ==================================================== -->

    <article class="purelane-build-card purelane-build-popular">

      <div class="purelane-build-badge">
        {{ section.settings.popular_badge | escape }}
      </div>

      <div class="purelane-build-images">

        {% assign popular_1 = collections[section.settings.collection].products[0] %}
        {% assign popular_2 = collections[section.settings.collection].products[1] %}
        {% assign popular_3 = collections[section.settings.collection].products[2] %}

        {% if popular_1 %}
          <img
            src="{{ popular_1.featured_image | image_url: width: 180 }}"
            alt="{{ popular_1.title | escape }}"
          >
        {% endif %}

        {% if popular_2 %}
          <img
            src="{{ popular_2.featured_image | image_url: width: 180 }}"
            alt="{{ popular_2.title | escape }}"
          >
        {% endif %}

        {% if popular_3 %}
          <img
            src="{{ popular_3.featured_image | image_url: width: 180 }}"
            alt="{{ popular_3.title | escape }}"
          >
        {% endif %}

      </div>


      <div class="purelane-build-number">
        3
      </div>

      <div class="purelane-build-products">
        PRODUCTS
      </div>


      <div class="purelane-build-price">

        <strong>{{ section.settings.popular_price | times: 100 | money_without_trailing_zeros }}</strong>

        {% if section.settings.popular_compare_price > section.settings.popular_price %}
          <del>{{ section.settings.popular_compare_price | times: 100 | money_without_trailing_zeros }}</del>
        {% endif %}

      </div>

      <div class="purelane-flat-price">
        Flat {{ section.settings.popular_price | divided_by: 3 | times: 100 | money_without_trailing_zeros }} per product
      </div>


      <ul>

        <li>✓ {{ section.settings.popular_feature_1 | escape }}</li>
        <li>✓ {{ section.settings.popular_feature_2 | escape }}</li>
        <li>✓ {{ section.settings.popular_feature_3 | escape }}</li>

      </ul>


      <a
        href="/collections/{{ section.settings.collection }}"
        class="purelane-build-button purelane-build-button-primary"
      >
        {{ section.settings.popular_button_label | escape }} →
      </a>

    </article>



    <!-- ===================================================
         WHOLE HOME
    ==================================================== -->

    <article class="purelane-build-card">

      <div class="purelane-build-badge">
        {{ section.settings.whole_badge | escape }}
      </div>

      <div class="purelane-build-images">

        {% assign whole_1 = collections[section.settings.collection].products[0] %}
        {% assign whole_2 = collections[section.settings.collection].products[1] %}
        {% assign whole_3 = collections[section.settings.collection].products[2] %}
        {% assign whole_4 = collections[section.settings.collection].products[3] %}
        {% assign whole_5 = collections[section.settings.collection].products[4] %}

        {% if whole_1 %}
          <img
            src="{{ whole_1.featured_image | image_url: width: 150 }}"
            alt="{{ whole_1.title | escape }}"
          >
        {% endif %}

        {% if whole_2 %}
          <img
            src="{{ whole_2.featured_image | image_url: width: 150 }}"
            alt="{{ whole_2.title | escape }}"
          >
        {% endif %}

        {% if whole_3 %}
          <img
            src="{{ whole_3.featured_image | image_url: width: 150 }}"
            alt="{{ whole_3.title | escape }}"
          >
        {% endif %}

        {% if whole_4 %}
          <img
            src="{{ whole_4.featured_image | image_url: width: 150 }}"
            alt="{{ whole_4.title | escape }}"
          >
        {% endif %}

        {% if whole_5 %}
          <img
            src="{{ whole_5.featured_image | image_url: width: 150 }}"
            alt="{{ whole_5.title | escape }}"
          >
        {% endif %}

      </div>


      <div class="purelane-build-number">
        5
      </div>

      <div class="purelane-build-products">
        PRODUCTS
      </div>


      <div class="purelane-build-price">

        <strong>{{ section.settings.whole_price | times: 100 | money_without_trailing_zeros }}</strong>

        {% if section.settings.whole_compare_price > section.settings.whole_price %}
          <del>{{ section.settings.whole_compare_price | times: 100 | money_without_trailing_zeros }}</del>
        {% endif %}

      </div>

      <div class="purelane-flat-price">
        Flat {{ section.settings.whole_price | divided_by: 5 | times: 100 | money_without_trailing_zeros }} per product
      </div>


      <ul>

        <li>✓ {{ section.settings.whole_feature_1 | escape }}</li>
        <li>✓ {{ section.settings.whole_feature_2 | escape }}</li>
        <li>✓ {{ section.settings.whole_feature_3 | escape }}</li>

      </ul>


      <a
        href="/collections/{{ section.settings.collection }}"
        class="purelane-build-button"
      >
        {{ section.settings.whole_button_label | escape }}
      </a>

    </article>

  </div>



  <!-- =====================================================
       BESTSELLERS
  ====================================================== -->

  <div class="purelane-bestsellers">

  <div class="purelane-bestsellers-label">
    BESTSELLERS
  </div>

  <h2>LOVED BY 30,000 HOMES</h2>

  <div class="purelane-bestseller-divider">
    <span></span>
    <b>⌄</b>
    <span></span>
  </div>

  {% assign bestseller_products = collections[section.settings.collection].products %}

  <div class="purelane-bestseller-grid">

    {% for product in bestseller_products limit: 8 %}

      <article class="purelane-bestseller-card">

        <div class="purelane-bestseller-tag">
          {% case forloop.index %}
            {% when 1 %}
              BEST SELLER
            {% when 2 %}
              BEST SELLER
            {% when 3 %}
              TOP RATED
            {% else %}
              NEW
          {% endcase %}
        </div>

        <a
          href="{{ product.url }}"
          class="purelane-bestseller-image"
          aria-label="{{ product.title | escape }}"
        >

          {% if product.featured_image %}

            <img
              src="{{ product.featured_image | image_url: width: 500 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="500"
              height="500"
            >

          {% else %}

            <div class="purelane-product-placeholder">
              <span>PURELANE</span>
            </div>

          {% endif %}

        </a>

        <div class="purelane-bestseller-info">

          <h3>
            <a href="{{ product.url }}">
              {{ product.title }}
            </a>
          </h3>

          {% if product.description != blank %}
            <p>
              {{ product.description | strip_html | truncate: 85 }}
            </p>
          {% endif %}

          {% assign review_rating = product.metafields.reviews.rating.value %}
          {% if review_rating != blank %}
            <div class="purelane-bestseller-rating" aria-label="Rated {{ review_rating }} out of 5">
              <span aria-hidden="true">★★★★★</span>
              <small>{{ review_rating }}</small>
            </div>
          {% endif %}

          <div class="purelane-bestseller-price">

            {% if product.compare_at_price > product.price %}

              <strong>
                {{ product.price | money_without_trailing_zeros }}
              </strong>

              <del>
                {{ product.compare_at_price | money_without_trailing_zeros }}
              </del>

              <span>SAVE</span>

            {% else %}

              <strong>
                {{ product.price | money_without_trailing_zeros }}
              </strong>

            {% endif %}

          </div>

          {% if product.available %}

            <form
              method="post"
              action="/cart/add"
              class="purelane-bestseller-cart"
            >

              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <input
                type="hidden"
                name="quantity"
                value="1"
              >

              <button type="submit">
                ADD TO CART
                <span>→</span>
              </button>

            </form>

          {% else %}

            <button
              type="button"
              class="purelane-bestseller-soldout"
              disabled
            >
              SOLD OUT
            </button>

          {% endif %}

        </div>

      </article>

    {% endfor %}

  </div>

</div>

</section>



<style>

/* =========================================================
   MAIN SECTION
========================================================= */

.purelane-build-section {

  width: 100%;

  box-sizing: border-box;

  padding: 65px 0 90px;

  overflow: hidden;

  position: relative;

  background:

    radial-gradient(
      ellipse at 25% 20%,
      rgba(255,255,255,.30),
      transparent 35%
    ),

    radial-gradient(
      ellipse at 80% 65%,
      rgba(255,255,255,.18),
      transparent 32%
    ),

    linear-gradient(
      180deg,
      #dff6e4 0%,
      #c8ecd6 45%,
      #a9d9c4 100%
    );

}


/* =========================================================
   WAVY BACKGROUND
========================================================= */

.purelane-build-section::before {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  opacity: .5;

  background:

    repeating-linear-gradient(
      -7deg,
      transparent 0px,
      transparent 72px,
      rgba(255,255,255,.20) 75px,
      transparent 80px
    );

}


/* =========================================================
   HEADER
========================================================= */

.purelane-build-header {

  position: relative;

  z-index: 2;

  text-align: center;

  max-width: 800px;

  margin: 0 auto 38px;

  padding: 0 20px;

}


.purelane-build-eyebrow {

  margin-bottom: 15px;

  color: #77798a;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: .25em;

}


.purelane-build-header h2 {

  margin: 0;

  color: #18112f;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 48px;

  line-height: 1;

  font-weight: 900;

  letter-spacing: -.04em;

}


.purelane-build-header p {

  margin: 18px auto 0;

  color: #56586c;

  font-size: 15px;

  line-height: 1.45;

}


/* =========================================================
   BUNDLE CARDS
========================================================= */

.purelane-build-cards {

  position: relative;

  z-index: 2;

  width: min(1180px, calc(100% - 60px));

  margin: 0 auto;

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 16px;

}


.purelane-build-card {

  min-height: 480px;

  box-sizing: border-box;

  padding: 15px;

  border-radius: 20px;

  background:

    linear-gradient(
      145deg,
      rgba(255,255,255,.88),
      rgba(211,235,229,.82)
    );

  border: 1px solid rgba(188,201,204,.7);

  box-shadow:

    0 15px 35px rgba(55,85,75,.10);

  backdrop-filter: blur(15px);

  -webkit-backdrop-filter: blur(15px);

}


.purelane-build-popular {

  border: 1.5px solid rgba(193,151,74,.65);

}


/* =========================================================
   BADGE
========================================================= */

.purelane-build-badge {

  display: inline-flex;

  align-items: center;

  height: 22px;

  padding: 0 10px;

  border-radius: 999px;

  background: rgba(240,246,222,.8);

  color: #7d9d55;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .13em;

}


/* =========================================================
   PRODUCT IMAGE AREA
========================================================= */

.purelane-build-images {

  height: 105px;

  margin-top: 10px;

  padding: 5px 10px;

  border-radius: 10px;

  background: rgba(255,255,255,.48);

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 5px;

}


.purelane-build-images img {

  width: 62px;

  height: 88px;

  object-fit: contain;

  display: block;

}


/* =========================================================
   NUMBER
========================================================= */

.purelane-build-number {

  margin-top: 14px;

  color: #29223e;

  font-size: 28px;

  line-height: 1;

  font-weight: 900;

}


.purelane-build-products {

  margin-top: 4px;

  color: #7d7e8d;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .12em;

}


/* =========================================================
   PRICE
========================================================= */

.purelane-build-price {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 12px;

}


.purelane-build-price strong {

  color: #c27617;

  font-size: 23px;

  font-weight: 900;

}


.purelane-build-price del {

  color: #7c7d87;

  font-size: 11px;

}


.purelane-flat-price {

  margin-top: 2px;

  color: #797a88;

  font-size: 10px;

}


/* =========================================================
   FEATURES
========================================================= */

.purelane-build-card ul {

  list-style: none;

  padding: 0;

  margin: 13px 0 17px;

}


.purelane-build-card li {

  margin-bottom: 7px;

  color: #606274;

  font-size: 10px;

}


/* =========================================================
   BUILD BUTTON
========================================================= */

.purelane-build-button {

  height: 40px;

  width: 100%;

  box-sizing: border-box;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 999px;

  background: rgba(255,255,255,.86);

  border: 1px solid rgba(130,140,160,.25);

  color: #075d59;

  text-decoration: none;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: .12em;

}


.purelane-build-button-primary {

  background: #006f69;

  color: white;

  border-color: #006f69;

}


/* =========================================================
   BESTSELLERS
========================================================= */

.purelane-bestsellers {

  position: relative;

  z-index: 2;

  margin-top: 70px;

}


.purelane-bestsellers-label {

  text-align: center;

  color: #7b7d8c;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .25em;

}


.purelane-bestsellers h2 {

  margin: 10px 0 0;

  text-align: center;

  color: #18112f;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 39px;

  line-height: 1;

  font-weight: 900;

  letter-spacing: -.04em;

}


.purelane-bestseller-divider {

  width: 100px;

  margin: 12px auto 25px;

  display: flex;

  align-items: center;

  gap: 8px;

}


.purelane-bestseller-divider span {

  height: 1px;

  flex: 1;

  background: rgba(100,110,120,.25);

}


.purelane-bestseller-divider b {

  color: #c67a1b;

  font-size: 14px;

}


/* =========================================================
   BESTSELLER PRODUCT GRID
========================================================= */

.purelane-bestseller-grid {
  width: min(1180px, calc(100% - 60px));
  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

/* =========================================================
   PRODUCT CARD
========================================================= */

.purelane-bestseller-card {
  position: relative;
  min-width: 0;
  overflow: hidden;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.92),
      rgba(210, 235, 228, 0.86)
    );

  border: 1px solid rgba(185, 200, 202, 0.65);

  box-shadow:
    0 14px 30px rgba(55, 85, 75, 0.10);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.purelane-bestseller-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 20px 38px rgba(55, 85, 75, 0.16);
}

/* =========================================================
   BADGE
========================================================= */

.purelane-bestseller-tag {
  position: absolute;
  top: 13px;
  left: 13px;
  z-index: 3;

  padding: 6px 9px;

  border-radius: 999px;

  background: rgba(242, 247, 223, 0.95);

  color: #78974f;

  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

/* =========================================================
   PRODUCT IMAGE
========================================================= */

.purelane-bestseller-image {
  height: 205px;
  padding: 20px;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255, 255, 255, 0.42);

  text-decoration: none;
}

.purelane-bestseller-image img {
  width: 165px;
  height: 165px;

  object-fit: contain;

  display: block;

  transition: transform 0.3s ease;
}

.purelane-bestseller-card:hover
.purelane-bestseller-image img {
  transform: scale(1.04);
}

/* =========================================================
   NO IMAGE PLACEHOLDER
========================================================= */

.purelane-product-placeholder {
  width: 165px;
  height: 165px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  border: 1px dashed rgba(80, 110, 105, 0.3);

  color: #7c8d88;

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

/* =========================================================
   PRODUCT INFO
========================================================= */

.purelane-bestseller-info {
  padding: 16px;
}

.purelane-bestseller-info h3 {
  margin: 0 0 7px;

  color: #27203d;

  font-size: 16px;
  line-height: 1.2;
  font-weight: 900;
}

.purelane-bestseller-info h3 a {
  color: inherit;
  text-decoration: none;
}

.purelane-bestseller-info p {
  min-height: 31px;

  margin: 0 0 9px;

  color: #686a7a;

  font-size: 11px;
  line-height: 1.4;
}

/* =========================================================
   RATING
========================================================= */

.purelane-bestseller-rating {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 9px;
}

.purelane-bestseller-rating span {
  color: #c98220;

  font-size: 11px;
  letter-spacing: 1px;
}

.purelane-bestseller-rating small {
  color: #777987;
  font-size: 10px;
}

/* =========================================================
   PRICE
========================================================= */

.purelane-bestseller-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;

  margin-bottom: 12px;
}

.purelane-bestseller-price strong {
  color: #18112f;

  font-size: 20px;
  font-weight: 900;
}

.purelane-bestseller-price del {
  color: #777987;
  font-size: 10px;
}

.purelane-bestseller-price span {
  padding: 4px 7px;

  border-radius: 999px;

  background: rgba(130, 163, 72, 0.12);

  color: #67932d;

  font-size: 8px;
  font-weight: 800;
}

/* =========================================================
   ADD TO CART
========================================================= */

.purelane-bestseller-cart {
  margin: 0;
}

.purelane-bestseller-cart button,
.purelane-bestseller-soldout {
  width: 100%;
  min-height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  border-radius: 999px;

  border: 1px solid #006f69;

  background: #006f69;

  color: #fff;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.11em;

  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.purelane-bestseller-cart button:hover {
  background: #075d59;
  transform: translateY(-1px);
}

.purelane-bestseller-cart button span {
  font-size: 16px;
}

.purelane-bestseller-soldout {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(100, 110, 120, 0.25);
  color: #777987;
  cursor: not-allowed;
}

/* =========================================================
   DESKTOP
========================================================= */

@media (min-width: 901px) {

  .purelane-bestseller-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .purelane-bestseller-grid {
    width: min(760px, calc(100% - 40px));

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 14px;
  }

}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

  .purelane-bestsellers {
    margin-top: 55px;
  }

  .purelane-bestsellers h2 {
    font-size: 31px;
  }

  .purelane-bestseller-grid {
    width: calc(100% - 30px);

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 10px;
  }

  .purelane-bestseller-image {
    height: 150px;
    padding: 12px;
  }

  .purelane-bestseller-image img {
    width: 120px;
    height: 120px;
  }

  .purelane-product-placeholder {
    width: 120px;
    height: 120px;
  }

  .purelane-bestseller-info {
    padding: 11px;
  }

  .purelane-bestseller-info h3 {
    font-size: 13px;
  }

  .purelane-bestseller-info p {
    font-size: 10px;
  }

  .purelane-bestseller-price strong {
    font-size: 17px;
  }

  .purelane-bestseller-cart button,
  .purelane-bestseller-soldout {
    min-height: 38px;
    font-size: 8px;
  }

}

/* =========================================================
   KEYBOARD FOCUS
========================================================= */

.purelane-build-button:focus-visible,
.purelane-bestseller-cart button:focus-visible,
.purelane-bestseller-soldout:focus-visible,
.purelane-bestseller-image:focus-visible,
.purelane-bestseller-info h3 a:focus-visible {
  outline: 3px solid #c98220;
  outline-offset: 3px;
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .purelane-bestseller-card,
  .purelane-bestseller-image img {
    transition: none;
  }

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .purelane-build-cards {

    width: calc(100% - 40px);

    grid-template-columns: repeat(3, 300px);

    overflow-x: auto;

  }

  .purelane-build-header h2 {

    font-size: 42px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

  .purelane-build-section {

    padding-top: 50px;

  }

  .purelane-build-header h2 {

    font-size: 34px;

  }

  .purelane-build-header p {

    font-size: 14px;

  }

  .purelane-build-cards {

    width: 100%;

    padding-left: 20px;

    padding-right: 20px;

    display: flex;

    overflow-x: auto;

    scrollbar-width: none;

  }

  .purelane-build-cards::-webkit-scrollbar {

    display: none;

  }

  .purelane-build-card {

    flex: 0 0 290px;

  }

  .purelane-bestsellers h2 {

    font-size: 31px;

  }

}

</style>



