{% doc %}
  @prompt
    Create a premium “HOW IT WORKS.” section for Purelane Homecare. Use a light background, dark navy typography, and subtle gold accents. Create 3 numbered steps: “Choose your cleaner”, “Clean with confidence”, and “Enjoy a fresher home”. Add a short description under each step. Use a clean, spacious, modern layout consistent with the existing Purelane product page. Keep it elegant and minimal, without unnecessary images.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-how-it-works-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-how-it-works-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-how-it-works-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-how-it-works-steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.step_gap }}px;
    margin-top: {{ block.settings.steps_top_margin }}px;
  }

  .ai-how-it-works-step-{{ ai_gen_id }} {
    text-align: center;
    padding: {{ block.settings.step_padding }}px;
  }

  .ai-how-it-works-number-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.number_bg_color }};
    color: {{ block.settings.number_text_color }};
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 700;
    margin: 0 auto {{ block.settings.number_margin_bottom }}px;
    border: {{ block.settings.number_border_width }}px solid {{ block.settings.accent_color }};
  }

  .ai-how-it-works-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 {{ block.settings.step_title_margin }}px;
    font-weight: 600;
  }

  .ai-how-it-works-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works-steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.step_gap | times: 1.5 }}px;
    }

    .ai-how-it-works-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-how-it-works-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }

    .ai-how-it-works-step-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works-container-{{ ai_gen_id }}">
    <div class="ai-how-it-works-header-{{ ai_gen_id }}">
      <h2 class="ai-how-it-works-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    </div>

    <div class="ai-how-it-works-steps-{{ ai_gen_id }}">
      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">1</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
        <p class="ai-how-it-works-step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</p>
      </div>

      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">2</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
        <p class="ai-how-it-works-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</p>
      </div>

      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">3</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
        <p class="ai-how-it-works-step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</p>
      </div>
    </div>
  </div>
</div>

