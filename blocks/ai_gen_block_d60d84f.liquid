{% doc %}
  @prompt
    Create a premium customer reviews section for Purelane Homecare. Heading: “LOVED BY PURELANE HOMES.” Add 3 customer review cards with 5-star ratings, short natural-sounding reviews about cleaning performance, gentle formulas, and fresh results, plus customer names. Use a clean light background, dark navy typography, subtle gold accents, rounded cards, and generous spacing. Keep it elegant and consistent with the existing Purelane design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-reviews-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_heading }}px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.card_spacing }}px;
    margin-top: {{ block.settings.spacing_below_heading }}px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.review_text_color }};
    margin: 0 0 20px;
  }

  .ai-review-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_text_size }}px;
    color: {{ block.settings.author_text_color }};
    font-weight: 600;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-reviews-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_spacing | times: 0.75 }}px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-reviews-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-reviews-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign review_text_key = 'review_' | append: i | append: '_text'
          assign author_name_key = 'review_' | append: i | append: '_author'
          assign review_text = block.settings[review_text_key]
          assign author_name = block.settings[author_name_key]
        %}

        {% if review_text != blank %}
          <div class="ai-review-card-{{ ai_gen_id }}">
            <div class="ai-review-stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>

            {% if author_name != blank %}
              <p class="ai-review-author-{{ ai_gen_id }}">{{ author_name }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

